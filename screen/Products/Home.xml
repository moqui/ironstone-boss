<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">
    <actions><service-call name="ironstone.products.CatalogServices.find#Products" in-map="{pageSize:5}" out-map="catalog"/></actions>
    <widgets><container-box><box-header title="Your catalog"/><box-body>
        <label text="${catalog.productListCount} products available" type="p"/>
        <link url="../Products" text="Browse products" link-type="anchor-button" icon="sym_o_inventory_2"/>
    </box-body></container-box></widgets>
</screen>
