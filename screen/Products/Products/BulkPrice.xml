<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Review price changes" default-menu-include="false">
    <parameter name="productIds"/>
    <parameter name="productPriceIds"/>
    <parameter name="organizationPartyId"/>
    <parameter name="vendorPartyId"/>
    <parameter name="direction"/>
    <parameter name="priceTypeEnumId"/>
    <parameter name="pricePurposeEnumId"/>
    <parameter name="priceUomId"/>
    <parameter name="operationKey"/>
    <transition name="preview">
        <actions>
            <service-call name="ironstone.products.CatalogServices.preview#PriceChanges" in-map="context" out-map="answer"/>
            <set field="operationKey" from="answer.operationKey"/>
        </actions>
        <default-response url=".">
            <parameter name="operationKey"/>
        </default-response>
        <error-response url="."/>
    </transition>
    

    <transition name="apply">
        <actions>
            <if condition="!(Array.isArray(confirm) ? confirm.includes('Y') : confirm === 'Y')">
                <message error="true">Confirm the reviewed price changes before applying.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <service-call name="ironstone.products.CatalogServices.apply#PriceChanges" in-map="context"/>
            </if>
        </actions>
        <default-response url=".">
            <parameter name="operationKey"/>
        </default-response>
        <error-response url="."/>
    </transition>
    

    <actions>
        <service-call name="ironstone.products.CatalogServices.get#PriceOptions" out-map="context"/>
        <set field="organizationPartyId" from="organizationPartyId || defaultOrganizationPartyId"/>
        <set field="direction" from="direction || 'sales'"/>
        <set field="priceTypeEnumId" from="priceTypeEnumId || 'PptCurrent'"/>
        <set field="pricePurposeEnumId" from="pricePurposeEnumId || 'PppPurchase'"/>
        <set field="priceUomId" from="priceUomId || 'USD'"/>
        <set field="previewRows" from="[]"/>
        <set field="results" from="[]"/>
        <set field="readyCount" from="0"/>
        <if condition="operationKey">
            <service-call name="ironstone.products.CatalogServices.get#PriceChanges" in-map="context" out-map="context"/>
        </if>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Price change setup"/>
            <box-body>
                <label text="Preview fixes the selected rows, their current stamps and the proposed amounts. Applying returns a result per row and keeps completed rows on retry." type="p"/>
                <form-single name="BulkPriceSetup" transition="preview">
                    <field name="vendorPartyId"><default-field><hidden/></default-field></field>
                    <field name="productIds">
                        <default-field title="Product IDs (comma separated)">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="productPriceIds">
                        <default-field title="Or price row IDs (comma separated)">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="false">
                                <list-options list="priceOptions.organizations" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <drop-down>
                                <option key="sales" text="Sales"/>
                                <option key="purchase" text="Supplier offers"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="priceTypeEnumId">
                        <default-field title="Type">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.types" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="pricePurposeEnumId">
                        <default-field title="Purpose">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.purposes" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <drop-down allow-empty="true">
                                <list-options list="priceOptions.currencies" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="fixedPrice">
                        <default-field title="Fixed price (empty: adjust each source amount)">
                            <text-line input-type="number"/>
                        </default-field>
                    </field>
                    <field name="percentChange">
                        <default-field title="Percent change">
                            <text-line input-type="number"/>
                        </default-field>
                    </field>
                    <field name="amountChange">
                        <default-field title="Then add amount">
                            <text-line input-type="number"/>
                        </default-field>
                    </field>
                    <field name="effectiveDate">
                        <default-field title="Effective date">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Preview price changes">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
            </box-body>
        </container-box>
        <container-box>
            <box-header title="Reviewed prices"/>
            <box-body>
                <form-list name="PriceChangePreview" list="previewRows" skip-form="true" paginate="false">
                    <field name="productId">
                        <default-field title="Product">
                            <display/>
                        </default-field>
                    </field>
                    <field name="productName">
                        <default-field title="Name">
                            <display/>
                        </default-field>
                    </field>
                    <field name="productPriceId">
                        <default-field title="Source row">
                            <display/>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <display/>
                        </default-field>
                    </field>
                    <field name="minQuantity">
                        <default-field title="Minimum quantity">
                            <display/>
                        </default-field>
                    </field>
                    <field name="beforePrice">
                        <default-field title="Before">
                            <display/>
                        </default-field>
                    </field>
                    <field name="afterPrice">
                        <default-field title="After">
                            <display/>
                        </default-field>
                    </field>
                    <field name="result">
                        <default-field title="Result">
                            <display/>
                        </default-field>
                    </field>
                    <field name="error">
                        <default-field title="Reason">
                            <display/>
                        </default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
        <section name="ApplyAvailable" condition="readyCount &gt; 0">
            <widgets>
                <container-box>
                    <box-header title="Confirm reviewed changes"/>
                    <box-body>
                        <form-single name="ApplyPriceChanges" transition="apply">
                            <field name="operationKey">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="previewToken">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="confirm">
                                <default-field title="Confirm reviewed price changes">
                                    <check>
                                        <option key="Y" text="I reviewed these rows and their proposed amounts"/>
                                    </check>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Apply reviewed changes">
                                    <submit/>
                                </default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <container-box>
            <box-header title="Results"/>
            <box-body>
                <form-list name="PriceChangeResults" list="results" skip-form="true" paginate="false">
                    <field name="productId">
                        <default-field title="Product">
                            <display/>
                        </default-field>
                    </field>
                    <field name="productPriceId">
                        <default-field title="Source row">
                            <display/>
                        </default-field>
                    </field>
                    <field name="successorProductPriceId">
                        <default-field title="Successor row">
                            <display/>
                        </default-field>
                    </field>
                    <field name="result">
                        <default-field title="Result">
                            <display/>
                        </default-field>
                    </field>
                    <field name="error">
                        <default-field title="Reason">
                            <display/>
                        </default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
