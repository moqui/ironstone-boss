                                        <field name="submitButton">
                                            <default-field title="Save offer">
                                                <submit/>
                                            </default-field>
                                        </field>
                                        

                                    </form-single>
                                </container-dialog>
                                <container-dialog id="Offer_replace_${offer.productPriceId}" button-text="Schedule successor ${offer.productPriceId}" title="Schedule successor" condition="true" width="800">
