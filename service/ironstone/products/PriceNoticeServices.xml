<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="notify" noun="ProductPriceChange" authenticate="anonymous-all" allow-remote="false">
        <in-parameters><parameter name="productPriceId" required="true"/></in-parameters>
        <out-parameters><parameter name="sentCount" type="Integer"/><parameter name="sentToUserIds" type="List"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/PriceNotices.js').execute('changed',context))</script></actions>
    </service>
    <service verb="send" noun="ExpiringPriceNotices" authenticate="anonymous-all" allow-remote="false">
        <in-parameters><parameter name="days" type="Integer" default="30"/></in-parameters>
        <out-parameters><parameter name="sentCount" type="Integer"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/PriceNotices.js').execute('expiring',context))</script></actions>
    </service>
    <service verb="send" noun="ProductPriceNotice" authenticate="anonymous-all" allow-remote="false"><in-parameters><parameter name="productPriceId" required="true"/><parameter name="recipientUserId" required="true"/><parameter name="topic" required="true"/></in-parameters><out-parameters><parameter name="sent" type="Boolean"/></out-parameters><actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/PriceNotices.js').execute('sendOne',context))</script></actions></service>
</services>
