<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Dimensions &amp; units" default-menu-index="5">
    <transition name="storeRow">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#CatalogRow" in-map="Object.assign({},context,{kind:'dimension'})"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="RowsAvailable" condition="productFound">
            <widgets>
                <container-box>
                    <box-header title="Dimensions &amp; units"/>
                    <box-body>
                        <form-list name="DimensionsRows" list="detail.dimensionRows" skip-form="true" paginate="false">
                            <field name="uomDimensionTypeId">
                                <header-field title="Dimension"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="marketSegmentId">
                                <header-field title="Market segment"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="value">
                                <header-field title="Value"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="uomId">
                                <header-field title="Unit"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                        </form-list>
                        <section name="DimensionsEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddDimensions" button-text="Add" title="Dimensions &amp; units" width="640">
                                    <form-single name="AddDimensions" transition="storeRow">
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productUomDimensionId">
                                            <default-field title="Dimension ID">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="uomDimensionTypeId">
                                            <default-field title="Dimension">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.dimensions" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="marketSegmentId">
                                            <default-field title="Market segment">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="value">
                                            <default-field title="Value">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="uomId">
                                            <default-field title="Unit">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.units" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                                <section-iterate name="EditDimensionsRows" list="detail.dimensionRows" entry="entry">
                                    <widgets>
                                        <container-dialog id="EditDimensions_${entry_index}" button-text="Edit ${entry.uomDimensionTypeId}" title="Edit Dimensions &amp; units" width="640">
                                            <form-single name="EditDimensions" transition="storeRow" map="entry">
                                                <field name="productId">
                                                    <default-field>
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="productUomDimensionId">
                                                    <default-field title="Dimension ID">
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="uomDimensionTypeId">
                                                    <default-field title="Dimension">
                                                        <drop-down allow-empty="true">
                                                            <list-options list="options.dimensions" key="${value}" text="${label}"/>
                                                        </drop-down>
                                                    </default-field>
                                                </field>
                                                <field name="marketSegmentId">
                                                    <default-field title="Market segment">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="value">
                                                    <default-field title="Value">
                                                        <text-line input-type="number"/>
                                                    </default-field>
                                                </field>
                                                <field name="uomId">
                                                    <default-field title="Unit">
                                                        <drop-down allow-empty="true">
                                                            <list-options list="options.units" key="${value}" text="${label}"/>
                                                        </drop-down>
                                                    </default-field>
                                                </field>
                                                <field name="submitButton">
                                                    <default-field title="Save">
                                                        <submit/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </container-dialog>
                                    </widgets>
                                </section-iterate>
                            </widgets>
                        </section>
                        <container-box>
                            <box-header title="Legacy dimensions (read only)"/>
                            <box-body>
                                <form-list name="LegacyDimensions" list="detail.legacyDimensionRows" skip-form="true" paginate="false">
                                    <field name="dimensionTypeEnumId">
                                        <header-field title="Type"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="value">
                                        <header-field title="Value"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="uomId">
                                        <header-field title="Unit"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                </form-list>
                            </box-body>
                        </container-box>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
