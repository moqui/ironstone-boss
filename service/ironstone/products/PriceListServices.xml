<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="find" noun="ProductPriceLists" allow-remote="false">
        <in-parameters>
            <parameter name="appRoot"/>
            <parameter name="organizationPartyId"/>
            <parameter name="direction"/>
            <parameter name="priceUomId"/>
            <parameter name="pricePurposeEnumId"/>
            <parameter name="state"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="includeHistory" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="priceListRows" type="List"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/Pricing.js').execute('lists',context))</script>
        </actions>
    </service>
    <service verb="get" noun="PriceListOptions" allow-remote="false">
        <in-parameters>
            <parameter name="appRoot"/>
        </in-parameters>
        <out-parameters>
            <parameter name="pricingOptions" type="Map"/>
            <parameter name="pricingAccess" type="Map"/>
            <parameter name="defaultOrganizationPartyId"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/Pricing.js').execute('options',context))</script>
        </actions>
    </service>
    <service verb="get" noun="PriceListDetail" allow-remote="false">
        <in-parameters>
            <parameter name="appRoot"/>
            <parameter name="priceListId" required="true"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="includeHistory" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="priceList" type="Map"/>
            <parameter name="priceRuleRows" type="List"/>
            <parameter name="publicationToken"/>
            <parameter name="defaultRule" type="Map"/>
            <parameter name="successor" type="Map"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/Pricing.js').execute('detail',context))</script>
        </actions>
    </service>
    <service verb="get" noun="PriceExplanation" allow-remote="false">
        <description>Use ProductPrice records plus modifier services to determine the price to charge or pay for a Product.</description>
        <in-parameters>
            <parameter name="appRoot"/>
            <parameter name="productId" required="true"/>
            <parameter name="quantity" type="BigDecimal" default="1.0"/>
            <parameter name="validDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="priceUomId" default="ec.user.getPreference('CurrencyDefault') || 'USD'"/>
            <parameter name="pricePurposeEnumId" default-value="PppPurchase"/>
            <parameter name="productStoreId"/>
            <parameter name="vendorPartyId"/>
            <parameter name="customerPartyId"/>
            <!-- TODO: to support look for records with this first and then with null: <parameter name="agreementId"/> -->
            <!-- TODO: to support look for records with this first and then with null: <parameter name="agreementItemSeqId"/> -->
            <parameter name="defaultToListPrice" type="Boolean" default="true"/>
            <parameter name="organizationPartyId"/>
            <parameter name="direction"/>
            <parameter name="quantityUomId"/>
            <parameter name="termUomId"/>
            <parameter name="priceListId"/>
            <parameter name="agreementId"/>
            <parameter name="agreementItemSeqId"/>
            <parameter name="shipToCountryGeoId"/>
            <parameter name="billToCountryGeoId"/>
            <parameter name="countryGeoId"/>
            <parameter name="explain" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="priceResult" type="Map"/>
            <parameter name="traceRows" type="List"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/products/Pricing.js').execute('explanation',context))</script>
        </actions>
    </service>
</services>
