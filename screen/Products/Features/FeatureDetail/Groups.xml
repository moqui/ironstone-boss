<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Groups" default-menu-index="2">
    <transition name="storeGroupsRows">
        <actions>
            <service-call name="ironstone.products.FeatureServices.store#FeatureRow" in-map="Object.assign({},context,{rowKind:'groupFeature'})"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="Available" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Groups"/>
                    <box-body>
                        <form-list name="GroupsRowsList" list="detail.groups" skip-form="true" paginate="false">
                            <field name="productFeatureGroupId">
                                <header-field title="Group"/>
                                <default-field>
                                    <link url="//Products/Features/FeatureGroups/FeatureGroupDetail" text="${productFeatureGroupId}" parameter-map="{productFeatureGroupId:productFeatureGroupId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <header-field title="Sequence"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                        </form-list>
                        <section name="GroupsRowsEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddGroupsRows" button-text="Add" title="GroupsRows" width="640">
                                    <form-single name="AddGroupsRows" transition="storeGroupsRows">
                                        <field name="productFeatureId">
                                            <default-field title="Feature">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productFeatureGroupId">
                                            <default-field title="Group">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.groups" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="sequenceNum">
                                            <default-field title="Sequence">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                                <section-iterate name="GroupsRowsRows" list="detail.groups" entry="entry">
                                    <widgets>
                                        <container-dialog id="EditGroupsRows_${entry_index}" button-text="Edit ${entry.productFeatureGroupId}" title="GroupsRows" width="640">
                                            <form-single name="EditGroupsRows" transition="storeGroupsRows" map="entry">
                                                <field name="productFeatureId">
                                                    <default-field title="Feature">
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="productFeatureGroupId">
                                                    <default-field title="Group">
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="fromDate">
                                                    <default-field title="From">
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="thruDate">
                                                    <default-field title="Through">
                                                        <date-time/>
                                                    </default-field>
                                                </field>
                                                <field name="sequenceNum">
                                                    <default-field title="Sequence">
                                                        <text-line input-type="number"/>
                                                    </default-field>
                                                </field>
                                                <field name="submitButton">
                                                    <default-field title="Save">
                                                        <submit/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </container-dialog>
                                    </widgets>
                                </section-iterate>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
