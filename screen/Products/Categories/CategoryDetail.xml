<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Category" default-menu-include="false">
    <parameter name="productCategoryId" required="true"/>
    <actions><service-call name="ironstone.products.CatalogServices.get#CatalogRecord" in-map="{recordEntityName:'mantle.product.category.ProductCategory', recordId:productCategoryId}" out-map="catalog"/></actions>
    <widgets><section name="CategoryAvailable" condition="!!catalog.record"><widgets>
        <container-box><box-header title="${catalog.record.categoryName}"/><box-body><label text="${productCategoryId}" type="p"/></box-body></container-box>
    </widgets></section></widgets>
</screen>
