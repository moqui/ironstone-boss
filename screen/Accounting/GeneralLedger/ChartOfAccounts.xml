<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Chart of accounts" default-menu-index="1" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="create">
        <actions>
            <service-call name="mantle.ledger.AccountServices.store#Account" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="accountChildren" read-only="true">
        <actions>
            <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="{kind:'accounts',organizationPartyId:organizationPartyId,parentGlAccountId:parentGlAccountId,pageSize:100}" out-map="children" />
            <script>ec.web.sendJsonResponse(children.records)</script>
        </actions>
        <default-response type="none" />
    </transition>
    <transition name="assign">
        <actions>
            <service-call in-map="Object.assign({},ec.web.parameters,{glAccountId:ec.web.parameters.assignedGlAccountId,organizationPartyId:organizationPartyId})" out-map="result" name="mantle.ledger.AccountServices.store#Assignment" />
        </actions>
        <default-response url="../AccountDetail">
            <parameter from="result.glAccountId" name="recordId" />
            <parameter name="organizationPartyId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="Object.assign({},context,{kind:'accounts'})" out-map="context" />
        <set field="recordsCount" from="recordCount" />
        <script>const dateLabels=ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js')
records = dateLabels.formatDates(records,[["lastUpdatedStamp", "yyyy-MM-dd HH:mm"]])</script>
    </actions>
    <widgets>
        <label text="Chart of accounts" type="h5" />
        <form-single name="Find" transition="." map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="text">
                <default-field title="Search">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Find" type="primary" />
                </default-field>
            </field>
        </form-single>
        <form-list name="Records" list="records" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true" views="list,tree">
            <field name="glAccountId">
                <default-field title="Record">
                    <link url="//Accounting/GeneralLedger/AccountDetail" text="${glAccountId}" parameter-map="{recordId:glAccountId,organizationPartyId:organizationPartyId}" />
                </default-field>
            </field>
            <field name="accountName">
                <default-field title="Name">
                    <display />
                </default-field>
            </field>
            <field name="lastUpdatedStamp">
                <default-field title="Updated">
                    <display text="${lastUpdatedStampText}" />
                </default-field>
            </field>
            <field name="parentGlAccountId">
                <default-field title="Parent gl account id">
                    <hidden />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="glAccountId" />
                    <field-ref name="accountName" />
                </column>
                <column>
                    <field-ref name="lastUpdatedStamp" />
                </column>
            </columns>
            <view-tree parent-field="parentGlAccountId" key-fields="glAccountId" child-count-field="childCount" children-transition="accountChildren" />
        </form-list>
        <label text="No matching records. Adjust the organization or filters." type="p" condition="!records.length" />
        <container-dialog id="Newaccount" button-text="New account" condition="(accounting.capabilities.glPost) &amp;&amp; accounting.capabilities.glPost">
            <form-single name="NewAccount" transition="create" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="accountCode">
                    <default-field title="Code">
                        <text-line />
                    </default-field>
                </field>
                <field name="accountName">
                    <default-field title="Name">
                        <text-line />
                    </default-field>
                </field>
                <field name="glAccountClassEnumId">
                    <default-field title="Class">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'enum:GlAccountClass',organizationPartyId:organizationPartyId,selected:glAccountClassEnumId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="glAccountTypeEnumId">
                    <default-field title="Type">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'enum:GlAccountType',organizationPartyId:organizationPartyId,selected:glAccountTypeEnumId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="parentGlAccountId">
                    <default-field title="Parent">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accountParents',organizationPartyId:organizationPartyId,selected:parentGlAccountId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Create account" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <container-dialog button-text="Assign existing account" condition="(accounting.capabilities.glPost) &amp;&amp; accounting.capabilities.glPost" id="AssignExistingAccountDialog">
            <form-single name="AssignExistingAccount" transition="assign" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization">
                        <hidden />
                    </default-field>
                </field>
                <field name="assignedGlAccountId" from="null">
                    <default-field title="Existing chart account">
                        <drop-down allow-empty="true" required-manual-select="true">
                            <dynamic-options server-search="true" min-length="0" parameter-map="{choice:'unassignedAccounts',organizationPartyId:organizationPartyId,selected:assignedGlAccountId}" transition="choices" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="fromDate">
                    <default-field title="Active from">
                        <date-time />
                    </default-field>
                </field>
                <field name="thruDate">
                    <default-field title="Active through">
                        <date-time />
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Assign">
                        <submit text="Assign account" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
    </widgets>
</screen>
