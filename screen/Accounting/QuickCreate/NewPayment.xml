<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Create payment" default-menu-index="1" default-menu-include="false" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="create">
        <actions>
            <service-call name="mantle.ledger.AccountingServices.create#DraftDocument" in-map="Object.assign({},context,{kind:'payments'})" out-map="result" />
            <set field="recordId" from="result.recordId || result.acctgTransId" />
        </actions>
        <default-response url="//Accounting/Payments/PaymentDetail">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <widgets>
        <label text="Create payment" type="h5" />
        <form-single name="CreateDraft" transition="create" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="description">
                <default-field title="Description">
                    <text-line />
                </default-field>
            </field>
            <field name="otherPartyId">
                <default-field title="Counterparty">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'parties',organizationPartyId:organizationPartyId,selected:otherPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="currencyUomId">
                <default-field title="Currency">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId,selected:currencyUomId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="amount">
                <default-field title="Amount">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Create draft" type="primary" />
                </default-field>
            </field>
        </form-single>
    </widgets>
</screen>
