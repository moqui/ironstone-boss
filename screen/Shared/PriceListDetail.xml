                                    </default-field>
                                </field>
                                <field name="maximumPrice">
                                    <default-field title="Maximum price">
                                        <text-line input-type="number" />
                                    </default-field>
                                </field>
                                <field name="changeReason">
                                    <default-field title="Reason">
                                        <text-line />
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Save dated rule">
                                        <submit />
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </widgets>
                </section-iterate>
                <container-box>
                    <box-header title="Publish reviewed scope" />
                    <box-body>
                        <label text="Review the organization, counterparties, dates and rule table above. Publishing applies this policy to matching future price lookups; recorded order lines retain their sources." type="p" />
                        <form-single name="PublishPriceList" transition="publish">
                            <field name="priceListId">
                                <default-field>
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="publicationToken">
                                <default-field>
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Publication reason">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Publish reviewed list">
                                    <submit />
                                </default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
                <container-dialog id="EndPriceList" title="End price list" button-text="End price list" width="960">
                    <form-single name="EndPriceListForm" transition="retire">
                        <field name="priceListId">
                            <default-field>
                                <hidden />
                            </default-field>
                        </field>
                        <field name="thruDate">
                            <default-field title="Through (empty: now)">
                                <date-time />
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="End list">
                                <submit />
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <section name="InteractiveList7" condition="sri.getRenderMode() !== 'html-print'">
            <widgets>
                <link text="Explain a transaction price" url="${sharedLinks['Prices/PriceExplain']}">
                    <parameter name="priceListId" />
                    <parameter name="organizationPartyId" from="priceList.organizationPartyId" />
                    <parameter name="direction" from="priceList.direction" />
                </link>
            </widgets>
        </section>
    </widgets>
</screen>
