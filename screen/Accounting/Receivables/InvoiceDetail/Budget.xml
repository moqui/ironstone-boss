<!-- InvoiceDetail's Budget details tab: the budget allocations of the invoice. It reads the invoice when the client
    loads the tab alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Budget details"
        default-menu-index="6">
    <parameter name="organizationPartyId"/>
    <parameter name="recordId"/>
    <parameter name="invoiceId"/>
    <actions>
        <!-- InvoiceDetail's actions read the invoice when it renders with the tab -->
        <if condition="receivable == null">
            <service-call name="ironstone.accounting.ReceivableServices.get#InvoiceContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
    </actions>
    <widgets>
        <section name="InvoiceBudget" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Budget details"/>
                    <box-body>
                        <form-list name="FinanceInvoiceBudgets" list="receivable.budgets" skip-form="true" paginate="false">
                            <field name="budgetId">
                                <header-field title="Budget"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="budgetItemSeqId">
                                <header-field title="Allocation"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="amount" align="right">
                                <header-field title="Amount"/>
                                <default-field>
                                    <display currency-unit-field="invoiceCurrencyUomId"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="budgetId"/>
                                    <field-ref name="budgetItemSeqId"/>
                                </column>
                                <column>
                                    <field-ref name="amount"/>
                                </column>
                            </columns>
                        </form-list>
                        <label text="The budget allocations of this invoice are not available."
                                type="p"
                                style="m-muted"
                                condition="!receivable.budgetAvailable"/>
                        <label text="No budget allocation is linked to this invoice."
                                type="p"
                                style="m-muted"
                                condition="receivable.budgetAvailable &amp;&amp; !receivable.budgets.length"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
