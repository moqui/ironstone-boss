<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Categories" default-menu-index="3">
    <transition name="storeRow">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#CatalogRow" in-map="Object.assign({},context,{kind:'category'})"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <condition><expression>!Array.isArray(product360Tabs) || product360Tabs.includes('Categories')</expression></condition>
    <widgets>
        <section name="RowsAvailable" condition="productFound">
            <widgets>
                <container-box>
                    <box-header title="Categories"/>
                    <box-body>
                        <form-list name="CategoriesRows" list="detail.categoryRows" skip-form="true" paginate="false">
                            <field name="productCategoryId">
                                <header-field title="Category"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <header-field title="Sequence"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="comments">
                                <header-field title="Notes"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowActions">
                                <default-field title="">
                                    <container-dialog condition="canEdit" id="EditCategories" button-text="Edit" icon="sym_o_edit" title="Edit category membership" width="640">
                                        <form-single name="EditCategories" transition="storeRow">
                                            <field name="productId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="productCategoryId">
                                                <default-field>
                                                    <hidden/>
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="fromDate">
                                                <default-field>
                                                    <hidden/>
                                                    <display text="${fromDateText || ''}"/>
                                                </default-field>
                                            </field>
                                            <field name="thruDate">
                                                <default-field title="Through">
                                                    <date-time/>
                                                </default-field>
                                            </field>
                                            <field name="sequenceNum">
                                                <default-field title="Sequence">
                                                    <text-line input-type="number"/>
                                                </default-field>
                                            </field>
                                            <field name="comments">
                                                <default-field title="Notes">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Save">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                        </form-list>
                        <section name="CategoriesEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddCategories" button-text="Add to category" icon="sym_o_add" title="Add the product to a category" width="640">
                                    <form-single name="AddCategories" transition="storeRow">
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productCategoryId">
                                            <default-field title="Category">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.categories" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="sequenceNum">
                                            <default-field title="Sequence">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="comments">
                                            <default-field title="Notes">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
