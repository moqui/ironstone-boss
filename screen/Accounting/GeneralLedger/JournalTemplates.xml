<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Journal templates" default-menu-index="5" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="saveTemplate">
        <actions>
            <service-call name="mantle.ledger.JournalServices.store#Template" in-map="context" out-map="result" />
            <set field="acctgTransTemplateId" from="result.acctgTransTemplateId" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="fromTemplate">
        <actions>
            <script>const amounts = {}
for (const [key,value] of Object.entries(ec.web.parameters)) {
    const match = /^parameterName_(\d+)$/.exec(key)
    if (match) amounts[value] = ec.web.parameters['parameterValue_' + match[1]]
}
ec.context.putAll({amounts})</script>
            <service-call name="mantle.ledger.JournalServices.create#FromTemplate" in-map="context" out-map="result" />
            <set field="recordId" from="result.acctgTransId" />
        </actions>
        <default-response url="//Accounting/GeneralLedger/JournalEntryDetail">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="line">
        <actions>
            <service-call name="mantle.ledger.JournalServices.store#TemplateLine" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="publish">
        <actions>
            <service-call name="mantle.ledger.JournalServices.publish#Template" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="removeTemplateLine">
        <actions>
            <service-call name="mantle.ledger.JournalServices.delete#TemplateLine" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="Object.assign({},context,{kind:'templates'})" out-map="context" />
        <set field="recordsCount" from="recordCount" />
        <if condition="acctgTransTemplateId">
            <service-call name="mantle.ledger.AccountingServices.get#Record" in-map="{kind:'templates',recordId:acctgTransTemplateId,organizationPartyId:organizationPartyId}" out-map="selectedTemplate" />
        </if>
        <script>templateAmountParameters = selectedTemplate?.lines ? [...new Set(selectedTemplate.lines.map(line=&gt;line.amountParameter).filter(Boolean))].map(parameterName=&gt;({parameterName})) : []</script>
        <set from="selectedTemplate?.lines || []" field="selectedTemplateLines" />
        <set from="(selectedTemplateLines || []).length" field="selectedTemplateLinesCount" />
        <set from="(templateAmountParameters || []).length" field="templateAmountParametersCount" />
        <set from="selectedTemplateLinesCount || 1" field="selectedTemplateLinesPageSize" />
        <set from="0" field="selectedTemplateLinesPageIndex" />
        <set from="0" field="selectedTemplateLinesPageMaxIndex" />
        <set from="selectedTemplateLinesCount ? 1 : 0" field="selectedTemplateLinesPageRangeLow" />
        <set from="selectedTemplateLinesCount" field="selectedTemplateLinesPageRangeHigh" />
        <set from="templateAmountParametersCount || 1" field="templateAmountParametersPageSize" />
        <set from="0" field="templateAmountParametersPageIndex" />
        <set from="0" field="templateAmountParametersPageMaxIndex" />
        <set from="templateAmountParametersCount ? 1 : 0" field="templateAmountParametersPageRangeLow" />
        <set from="templateAmountParametersCount" field="templateAmountParametersPageRangeHigh" />
    </actions>
    <widgets>
        <label text="Journal templates" type="h5" />
        <form-single name="Find" transition="." map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="text">
                <default-field title="Search">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Find" type="primary" />
                </default-field>
            </field>
        </form-single>
        <form-list name="Records" list="records" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="acctgTransTemplateId">
                <default-field title="Record">
                    <display />
                </default-field>
            </field>
            <field name="templateName">
                <default-field title="Name">
                    <text-line />
                </default-field>
            </field>
            <field name="lastUpdatedStamp">
                <default-field title="Updated">
                    <display format="yyyy-MM-dd HH:mm" />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="acctgTransTemplateId" />
                    <field-ref name="templateName" />
                </column>
                <column>
                    <field-ref name="lastUpdatedStamp" />
                </column>
            </columns>
        </form-list>
        <label text="No matching records. Adjust the organization or filters." type="p" condition="!records.length" />
        <container-dialog id="Newjournaltemplate" button-text="New journal template">
            <form-single name="TemplateHeader" transition="saveTemplate" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="templateName">
                    <default-field title="Name">
                        <text-line />
                    </default-field>
                </field>
                <field name="amountUomId">
                    <default-field title="Currency">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="acctgTransTypeEnumId">
                    <default-field title="Type">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'enum:AcctgTransType',organizationPartyId:organizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="description">
                    <default-field title="Description">
                        <text-line />
                    </default-field>
                </field>
                <field name="fromDate">
                    <default-field title="Effective from">
                        <date-time />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Save template" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <container-dialog id="Createdraftfromtemplate" button-text="Create draft from template">
            <form-single name="FromTemplate" transition="fromTemplate" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="acctgTransTemplateId">
                    <default-field title="Template">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'templates',organizationPartyId:organizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="transactionDate">
                    <default-field title="Date">
                        <date-time />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Create draft" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <form-single name="SelectTemplate" transition="." map="context">
            <field name="organizationPartyId" from="organizationPartyId">
                <default-field title="Organization party id">
                    <hidden />
                </default-field>
            </field>
            <field name="acctgTransTemplateId">
                <default-field title="Template">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'templates',organizationPartyId:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Open template" type="primary" />
                </default-field>
            </field>
        </form-single>
        <section name="TemplateEditor" condition="acctgTransTemplateId">
            <widgets>
                <label text="Template lines" type="h6" />
                <container-dialog id="Newtemplateversion" button-text="New template version" condition="selectedTemplate.record.isPublished === 'Y'">
                    <form-single name="NewTemplateVersion" transition="saveTemplate" map="context">
                        <field name="organizationPartyId" from="organizationPartyId">
                            <default-field title="Organization party id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="acctgTransTemplateId" from="acctgTransTemplateId">
                            <default-field title="Acctg trans template id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="lastUpdatedStamp" from="selectedTemplate.record.lastUpdatedStamp">
                            <default-field title="Last updated stamp">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="templateName" from="selectedTemplate.record.templateName">
                            <default-field title="Template name">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="fromDate">
                            <default-field title="New version effective from">
                                <date-time />
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="Submit">
                                <submit text="Create new version" type="primary" />
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
                <container-dialog id="Addtemplateline" button-text="Add template line" condition="selectedTemplate.record.isPublished !== 'Y'">
                    <form-single name="AddTemplateLine" transition="line" map="context">
                        <field name="organizationPartyId" from="organizationPartyId">
                            <default-field title="Organization party id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="acctgTransTemplateId" from="acctgTransTemplateId">
                            <default-field title="Acctg trans template id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="glAccountId">
                            <default-field title="Account">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accounts',organizationPartyId:organizationPartyId}" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="debitCreditFlag">
                            <default-field title="Side">
                                <drop-down allow-empty="true">
                                    <option key="D" text="Debit" />
                                    <option key="C" text="Credit" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="amount">
                            <default-field title="Fixed amount">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="amountParameter">
                            <default-field title="Amount parameter (optional)">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="facilityId">
                            <default-field title="Facility">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'facilities',organizationPartyId:organizationPartyId}" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="costCenterId">
                            <default-field title="Cost centre">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'costCenters',organizationPartyId:organizationPartyId}" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="Submit">
                                <submit text="Add template line" type="primary" />
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
                <form-list name="TemplateLines" list="selectedTemplateLines" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
                    <field name="entrySeqId">
                        <default-field title="Line">
                            <display />
                        </default-field>
                    </field>
                    <field name="glAccountId">
                        <default-field title="Account">
                            <display-entity entity-name="mantle.ledger.account.GlAccount" text="${accountCode} ${accountName}" />
                        </default-field>
                    </field>
                    <field name="debitCreditFlag">
                        <default-field title="Side">
                            <display />
                        </default-field>
                    </field>
                    <field name="amount">
                        <default-field title="Amount">
                            <display />
                        </default-field>
                    </field>
                    <field name="amountParameter">
                        <default-field title="Parameter">
                            <display />
                        </default-field>
                    </field>
                    <field name="lineActions">
                        <default-field title="Actions">
                            <container-dialog id="EditTemplateLine" button-text="Edit line" condition="selectedTemplate.record.isPublished !== 'Y'">
                                <form-single name="EditTemplateLine" transition="line" map="context">
                                    <field from="lastUpdatedStamp" name="lastUpdatedStamp">
                                        <default-field title="lastUpdatedStamp">
                                            <hidden />
                                        </default-field>
                                    </field>
                                    <field from="entrySeqId" name="entrySeqId">
                                        <default-field title="entrySeqId">
                                            <hidden />
                                        </default-field>
                                    </field>
                                    <field name="organizationPartyId" from="organizationPartyId">
                                        <default-field title="Organization party id">
                                            <hidden />
                                        </default-field>
                                    </field>
                                    <field name="acctgTransTemplateId" from="acctgTransTemplateId">
                                        <default-field title="Acctg trans template id">
                                            <hidden />
                                        </default-field>
                                    </field>
                                    <field name="glAccountId">
                                        <default-field title="Account">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accounts',organizationPartyId:organizationPartyId}" />
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="debitCreditFlag">
                                        <default-field title="Side">
                                            <drop-down allow-empty="true">
                                                <option key="D" text="Debit" />
                                                <option key="C" text="Credit" />
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="amount">
                                        <default-field title="Fixed amount">
                                            <text-line />
                                        </default-field>
                                    </field>
                                    <field name="amountParameter">
                                        <default-field title="Amount parameter (optional)">
                                            <text-line />
                                        </default-field>
                                    </field>
                                    <field name="facilityId">
                                        <default-field title="Facility">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'facilities',organizationPartyId:organizationPartyId}" />
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="costCenterId">
                                        <default-field title="Cost centre">
                                            <drop-down allow-empty="true">
                                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'costCenters',organizationPartyId:organizationPartyId}" />
                                            </drop-down>
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title="Submit">
                                            <submit text="Save line" type="primary" />
                                        </default-field>
                                    </field>
                                </form-single>
                            </container-dialog>
                            <link link-type="hidden-form-link" btn-type="danger" confirmation="Remove this draft template line?" parameter-map="{organizationPartyId:organizationPartyId,acctgTransTemplateId:acctgTransTemplateId,entrySeqId:entrySeqId,lastUpdatedStamp:lastUpdatedStamp}" url="removeTemplateLine" text="Remove" condition="selectedTemplate.record.isPublished !== 'Y'" />
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="entrySeqId" />
                            <field-ref name="glAccountId" />
                        </column>
                        <column>
                            <field-ref name="debitCreditFlag" />
                            <field-ref name="amount" />
                            <field-ref name="amountParameter" />
                            <field-ref name="lineActions" />
                        </column>
                    </columns>
                </form-list>
                <form-single name="PublishTemplate" transition="publish" map="context">
                    <field from="selectedTemplate.record.lastUpdatedStamp" name="lastUpdatedStamp">
                        <default-field title="Revision">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field title="Organization party id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="acctgTransTemplateId" from="acctgTransTemplateId">
                        <default-field title="Acctg trans template id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="Submit">
                            <submit text="Validate and publish" type="primary" />
                        </default-field>
                    </field>
                </form-single>
                <section name="TemplateAmounts">
                    <condition>
                        <expression>selectedTemplate.record.isPublished === 'Y' &amp;&amp; templateAmountParameters.length</expression>
                    </condition>
                    <widgets>
                        <label text="Create draft with amounts" type="h6" />
                        <form-list name="TemplateAmounts" list="templateAmountParameters" transition="fromTemplate" multi="true">
                            <hidden-parameters parameter-map="{organizationPartyId:organizationPartyId,acctgTransTemplateId:acctgTransTemplateId}" />
                            <field name="parameterLabel" from="parameterName">
                                <default-field title="Parameter">
                                    <display />
                                </default-field>
                            </field>
                            <field from="parameterName" name="parameterName">
                                <default-field title="Parameter">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="parameterValue">
                                <default-field title="Amount">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="Create draft">
                                    <submit text="Create draft" type="primary" />
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column>
                                    <field-ref name="parameterLabel" />
                                </column>
                                <column>
                                    <field-ref name="parameterValue" />
                                </column>
                            </columns>
                        </form-list>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
