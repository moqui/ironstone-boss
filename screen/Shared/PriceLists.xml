<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Price lists" default-menu-index="3">
    <parameter name="appRoot"/>
    <parameter name="organizationPartyId"/>
    <parameter name="direction"/>
    <parameter name="priceUomId"/>
    <parameter name="pricePurposeEnumId"/>
    <parameter name="state"/>
    <parameter name="asOfDate"/>
    <parameter name="includeHistory"/>
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
    </always-actions>
    <transition name="store">
        <actions>
            <service-call name="ironstone.products.PriceListServices.store#ProductPriceList" in-map="context" out-map="saved"/>
        </actions>
        <default-response url="${sharedLinks['Prices/PriceLists/PriceListDetail']}">
            <parameter name="priceListId" from="saved.priceListId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.products.PriceListServices.get#PriceListOptions" out-map="context"/>
        <set field="organizationPartyId" from="organizationPartyId || defaultOrganizationPartyId"/>
        <service-call name="ironstone.products.PriceListServices.find#ProductPriceLists" in-map="context" out-map="context"/>
        <set field="newList" from="{organizationPartyId,direction:pricingAccess.canPriceEdit ? 'sales' : 'purchase',priceUomId:'USD',pricePurposeEnumId:'PppPurchase',priority:'100'}"/>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Find price lists"/>
            <box-body>
                <form-single name="PriceListFind" transition=".">
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <drop-down allow-empty="false">
                                <list-options list="pricingOptions.organizations" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <drop-down allow-empty="false">
                                <option key="sales" text="Sales"/>
                                <option key="purchase" text="Supplier offers"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <drop-down allow-empty="false">
                                <list-options list="pricingOptions.currencies" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="pricePurposeEnumId">
                        <default-field title="Purpose">
                            <drop-down allow-empty="true">
                                <list-options list="pricingOptions.purposes" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="state">
                        <default-field title="State">
                            <drop-down allow-empty="true">
                                <option key="draft" text="Draft"/>
                                <option key="published" text="Published"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="As of">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="includeHistory">
                        <default-field title="Include all dates">
                            <drop-down allow-empty="true">
                                <option key="true" text="Yes"/>
                                <option key="false" text="No"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Find lists">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
            </box-body>
        </container-box>
        <section name="NewListAllowed" condition="pricingAccess.canPriceEdit || pricingAccess.canSupplierEdit">
            <widgets>
                <container-dialog id="NewPriceListDialog" title="New price list" button-text="New price list" width="960">
                    <form-single name="NewPriceList" transition="store" map="newList">
                        <field name="priceListId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="listName">
                            <default-field title="Name">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="organizationPartyId">
                            <default-field title="Organization">
                                <drop-down allow-empty="false">
                                    <list-options list="pricingOptions.organizations" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="direction">
                            <default-field title="Direction">
                                <drop-down allow-empty="false">
                                    <option key="sales" text="Sales"/>
                                    <option key="purchase" text="Supplier offers"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="priceUomId">
                            <default-field title="Currency">
                                <drop-down allow-empty="false">
                                    <list-options list="pricingOptions.currencies" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="pricePurposeEnumId">
                            <default-field title="Purpose">
                                <drop-down allow-empty="true">
                                    <list-options list="pricingOptions.purposes" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="priority">
                            <default-field title="Priority">
                                <text-line input-type="number"/>
                            </default-field>
                        </field>
                        <field name="cloneFromPriceListId">
                            <default-field title="Clone rules from">
                                <drop-down allow-empty="true">
                                    <list-options list="pricingOptions.lists" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="vendorPartyId">
                            <default-field title="Supplier scope">
                                <drop-down allow-empty="true">
                                    <list-options list="pricingOptions.vendors" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="customerPartyId">
                            <default-field title="Customer scope">
                                <drop-down allow-empty="true">
                                    <list-options list="pricingOptions.customers" key="${value}" text="${label}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="productStoreId">
                            <default-field title="Store ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="agreementId">
                            <default-field title="Agreement ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="agreementItemSeqId">
                            <default-field title="Agreement item">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="partyClassificationId">
                            <default-field title="Party classification ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="geoId">
                            <default-field title="Country or geography group ID">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="fromDate">
                            <default-field title="Effective from (empty: now)">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="thruDate">
                            <default-field title="Through">
                                <date-time/>
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submitButton">
                            <default-field title="Create draft">
                                <submit/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <container-box>
            <box-header title="Price lists"/>
            <box-body>
                <form-list name="PriceLists" list="priceListRows" skip-form="true" paginate="false">
                    <field name="open">
                        <default-field title="Open">
                            <link text="${listName}" url="${sharedLinks['Prices/PriceLists/PriceListDetail']}">
                                <parameter name="priceListId"/>
                            </link>
                        </default-field>
                    </field>
                    <field name="organizationPartyId">
                        <default-field title="Organization">
                            <display/>
                        </default-field>
                    </field>
                    <field name="direction">
                        <default-field title="Direction">
                            <display/>
                        </default-field>
                    </field>
                    <field name="pricePurposeEnumId">
                        <default-field title="Purpose">
                            <display/>
                        </default-field>
                    </field>
                    <field name="priceUomId">
                        <default-field title="Currency">
                            <display/>
                        </default-field>
                    </field>
                    <field name="priority">
                        <default-field title="Priority">
                            <display/>
                        </default-field>
                    </field>
                    <field name="stateText">
                        <default-field title="State">
                            <display/>
                        </default-field>
                    </field>
                    <field name="fromDateText">
                        <default-field title="Effective from">
                            <display/>
                        </default-field>
                    </field>
                    <field name="thruDateText">
                        <default-field title="Through">
                            <display/>
                        </default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
