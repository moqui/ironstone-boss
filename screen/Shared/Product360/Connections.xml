<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Connections" default-menu-index="10">
    <condition><expression>!Array.isArray(product360Tabs) || product360Tabs.includes('Connections')</expression></condition>
    <actions>
        <if condition="productFound">
            <service-call name="ironstone.products.CatalogServices.get#ProductConnections" in-map="{productId:productId,appRoot:appRoot}" out-map="context"/>
        </if>
    </actions>
    <widgets>
        <section name="Available" condition="productFound">
            <widgets>
                <section name="NoConnections" condition="!connectionRows.length">
                    <widgets>
                        <label text="No orders, invoices, shipments, production runs, requests or agreements you may read use this product." type="p" style="m-muted"/>
                    </widgets>
                </section>
                <section name="HasConnections" condition="connectionRows.length &gt; 0">
                    <widgets>
                        <dashboard>
                            <section-iterate name="ConnectionCards" list="connectionRows" entry="connection">
                                <widgets>
                                    <number-card title="${connection.kind}" value="${connection.count}"/>
                                </widgets>
                            </section-iterate>
                        </dashboard>
                        <container-box>
                            <box-header title="Connected records"/>
                            <box-body-nopad>
                                <form-list name="Connections" list="recordRows" skip-form="true" paginate="false">
                                    <field name="kind">
                                        <header-field title="Record type"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="recordId">
                                        <header-field title="Record"/>
                                        <conditional-field condition="!!url">
                                            <link url="${url}" url-type="plain" text="${recordId}" link-type="anchor"/>
                                        </conditional-field>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="recordId"/></column>
                                        <column><field-ref name="kind"/></column>
                                    </columns>
                                </form-list>
                                <label text="Up to 25 records of each type are listed; a record opens where an app you have shows it." type="p" style="q-px-md q-pb-sm text-caption m-muted"/>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
