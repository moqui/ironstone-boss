<!-- Journal batches (design-accounting §8 JournalBatches; impl-accounting P2b): a named set of draft entries. A row's Review
    validates each of its drafts; the review then posts the ready ones, each on its own, naming each failure, and a batch
    with a failure stays open (template/AccountingParts.xml BatchReview, mantle.ledger.JournalServices.post#Batch). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Journal batches"
        default-menu-index="4"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="text"/>
    <parameter name="previewId"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="postBatch" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="saveBatch">
        <actions>
            <service-call name="mantle.ledger.JournalServices.store#Batch"
                    in-map="{organizationPartyId:organizationPartyId, glJournalName:glJournalName}"
                    out-map="result"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="reviewBatch">
        <actions>
            <service-call name="mantle.ledger.JournalServices.validate#Batch"
                    in-map="{organizationPartyId:organizationPartyId, glJournalId:glJournalId}"
                    out-map="result"/>
            <set field="previewId" from="result.previewId"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records"
                in-map="{kind:'batches', organizationPartyId:organizationPartyId, text:text,
                    pageIndex:pageIndex, pageSize:pageSize}"
                out-map="context"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="Journal batches" type="h5"/>
            </container>
            <container style="col-auto">
                <container-dialog id="NewBatchDialog"
                        button-text="New journal batch"
                        type="primary"
                        icon="sym_o_add"
                        title="New journal batch"
                        condition="accounting.capabilities.glPost">
                    <form-single name="NewBatch" transition="saveBatch">
                        <field name="organizationPartyId" from="organizationPartyId">
                            <default-field title="Organization">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices"
                                            server-search="true"
                                            min-length="0"
                                            parameter-map="{choice:'organizations',
                                                organizationPartyId:organizationPartyId, selected:organizationPartyId}"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="glJournalName">
                            <default-field title="Name">
                                <text-line/>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="">
                                <submit text="Create batch"/>
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <section-include name="FindRecords" location="component://mr-boss/template/AccountingParts.xml"/>
        <section-include name="BatchReview" location="component://mr-boss/template/AccountingParts.xml"/>
        <form-list name="Records"
                list="records"
                skip-form="true"
                paginate="true"
                select-columns="true"
                show-csv-button="true"
                show-xlsx-button="true">
            <field name="glJournalName">
                <default-field title="Batch">
                    <display text="${glJournalName || glJournalId}"/>
                </default-field>
            </field>
            <field name="glJournalId">
                <default-field title="ID">
                    <display/>
                </default-field>
            </field>
            <field name="isPosted">
                <default-field title="State">
                    <render-mode>
                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${isPosted == 'Y' ?
                            'positive' : 'warning'}">${isPosted == 'Y' ? 'Posted' : 'Open'}</q-chip>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: isPosted == 'Y' ? 'Posted'
                            : 'Open'})}]]></text>
                    </render-mode>
                </default-field>
            </field>
            <field name="batchActions">
                <default-field title="">
                    <link url="reviewBatch"
                            link-type="hidden-form-link"
                            text="Review"
                            icon="sym_o_fact_check"
                            condition="isPosted != 'Y' &amp;&amp; accounting.capabilities.glPost"
                            parameter-map="{organizationPartyId:organizationPartyId, glJournalId:glJournalId}"/>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="glJournalName"/>
                    <field-ref name="glJournalId"/>
                </column>
                <column>
                    <field-ref name="isPosted"/>
                    <field-ref name="batchActions"/>
                </column>
            </columns>
        </form-list>
        <label text="No journal batches match. Choose another organization or search, or create a new journal batch."
                type="p"
                condition="!records.length"/>
    </widgets>
</screen>
