<!-- The "Sign in with Google" or "Sign in with Microsoft" button of a mail account (design-drawers-commons.md §17
    AccountCredentials; mr-moqui docs/interfaces/Mail-OAuth.md): SignIn.qvue next to this file, which the wizard's Connect step and the
    account page load in a dynamic-container with its query: mode (wizard: a new account, IMAP or POP, is made by the
    framework only when the sign-in succeeds, one the wizard made before is changed first; account: an account there signs in
    again, or instead of its password), the account or the address, name and kind
    of a new one, the provider and its label, and in the wizard offerPop with storeKind, the choice of reading the mail over
    IMAP or POP (the provider's POP server; the sign-in then asks for the provider's POP scope too, Microsoft's
    POP.AccessAsUser.All). The click opens the provider's popup (moqui.oauthPopup) over the JSON
    transitions below: startSignIn (ironstone.comms.MailSettingsServices.start#MailSignIn) and signInStatus
    (org.moqui.impl.EmailClientServices.get#OAuthStatus by signInId only, which answers only a sign-in of this user's
    session). No token ever reaches the page. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Sign in" default-menu-include="false" render-modes="vue,qvue,tui" server-static="vue,qvue">

    <transition name="startSignIn">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('ironstone.comms.MailSettingsServices.start#MailSignIn').parameters({emailAccountId: emailAccountId || null,
                emailAddress: emailAddress || null, displayName: displayName || null, accountKindEnumId: accountKindEnumId || 'EakExternal',
                oauthProviderEnumId: oauthProviderEnumId || null, storeKind: storeKind === 'pop' ? 'pop' : (storeKind === 'imap' ? 'imap' : null),
                setup: mode === 'wizard', allowAddressChange: String(allowAddressChange) === 'true'}).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {authUrl: out.authUrl, signInId: out.signInId, emailAccountId: out.emailAccountId})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="signInStatus" method="get" read-only="true">
        <actions><script><![CDATA[
            const out = signInId ? ec.service.sync().name('org.moqui.impl.EmailClientServices.get#OAuthStatus').parameter('signInId', String(signInId)).call() : null
            if (!signInId) ec.message.addError(ec.l10n.localize('Which sign-in?'))
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {status: out.status, errorCode: out.errorCode, message: out.message, signInId: out.signInId,
                emailAccountId: out.emailAccountId, emailAddress: out.emailAddress, expectedAddress: out.expectedAddress})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <render-mode><text type="qvue" location="component://mr-boss/screen/Comms/Settings/MailAccounts/SignIn.qvue" template="false"/><text type="tui" location="component://mr-boss/screen/Comms/Settings/MailAccounts/SignIn.tui.json" template="false"/></render-mode>
    </widgets>
</screen>
