<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Posting defaults" default-menu-index="3" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <parameter name="mappingKind" />
    <parameter name="mappingToken" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#PostingDefault" in-map="Object.assign({},context,{mapping:context})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <set from="mappingKind || 'type'" field="mappingKind" />
        <service-call name="mantle.ledger.SetupServices.get#PostingDefaults" in-map="context" out-map="context" />
        <set from="(missingMappings || []).length" field="missingMappingsCount" />
        <set from="(errorTransactions || []).length" field="errorTransactionsCount" />
        <set from="25" field="mappingRowsPageSize" />
        <set from="Number(pageIndex || 0)" field="mappingRowsPageIndex" />
        <set from="Math.max(0,Math.ceil(mappingRowsCount/25)-1)" field="mappingRowsPageMaxIndex" />
        <set from="mappingRowsCount ? Number(pageIndex || 0)*25+1 : 0" field="mappingRowsPageRangeLow" />
        <set from="Math.min(mappingRowsCount,(Number(pageIndex || 0)+1)*25)" field="mappingRowsPageRangeHigh" />
        <set from="missingMappingsCount || 1" field="missingMappingsPageSize" />
        <set from="0" field="missingMappingsPageIndex" />
        <set from="0" field="missingMappingsPageMaxIndex" />
        <set from="missingMappingsCount ? 1 : 0" field="missingMappingsPageRangeLow" />
        <set from="missingMappingsCount" field="missingMappingsPageRangeHigh" />
        <set from="errorTransactionsCount || 1" field="errorTransactionsPageSize" />
        <set from="0" field="errorTransactionsPageIndex" />
        <set from="0" field="errorTransactionsPageMaxIndex" />
        <set from="errorTransactionsCount ? 1 : 0" field="errorTransactionsPageRangeLow" />
        <set from="errorTransactionsCount" field="errorTransactionsPageRangeHigh" />
    </actions>
