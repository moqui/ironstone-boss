<!-- The server-search options of the catalog drop-downs: the Products screens include this transition (transition-include)
    and name the choice, the search term and the selected value. search#CatalogChoices applies the catalog owner scope. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.products.CatalogServices.search#CatalogChoices" in-map="{choice:choice || 'products', term:term, selected:selected}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.rows)</script>
        </actions>
        <default-response type="none"/>
    </transition>
</screen>
