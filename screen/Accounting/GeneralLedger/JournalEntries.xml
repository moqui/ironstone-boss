<!-- Journal entries (design-accounting §8 JournalEntries): the organization's entries, drafts and posted (isPosted),
    and the bulk post of a selection: Review selected validates each entry, then the review posts the ready ones, each on
    its own, naming each failure (template/AccountingParts.xml BatchReview). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Journal entries"
        default-menu-index="2"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="isPosted"/>
    <parameter name="text"/>
    <parameter name="previewId"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="postBatch" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="reviewSelection">
        <actions>
            <service-call name="mantle.ledger.JournalServices.validate#Batch"
                    in-map="{organizationPartyId:organizationPartyId, acctgTransIds:acctgTransIds}"
                    out-map="result"/>
            <set field="previewId" from="result.previewId"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records"
                in-map="{kind:'journals', organizationPartyId:organizationPartyId, isPosted:isPosted,
                    text:text, pageIndex:pageIndex, pageSize:pageSize}"
                out-map="context"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm">
            <container style="col">
                <label text="Journal entries" type="h5"/>
            </container>
            <container style="col-auto">
                <link url="//Accounting/QuickCreate/NewEntry"
                        text="New journal entry"
                        link-type="anchor-button"
                        btn-type="primary"
                        icon="sym_o_add"
                        condition="accounting.capabilities.glPost"
                        parameter-map="{organizationPartyId:organizationPartyId}"/>
            </container>
        </container>
        <section-include name="FindRecords" location="component://mr-boss/template/AccountingParts.xml"/>
        <section-include name="BatchReview" location="component://mr-boss/template/AccountingParts.xml"/>
        <form-list name="Records"
                list="records"
                skip-form="true"
                paginate="true"
                select-columns="true"
                show-csv-button="true"
                show-xlsx-button="true">
            <row-selection id-field="acctgTransId"
                    parameter="acctgTransIds"
                    list-mode="true"
                    condition="accounting.capabilities.glPost">
                <action>
                    <dialog button-text="Review selected" title="Review the selected journal entries"/>
                    <form-single name="ReviewSelection" transition="reviewSelection" map="context">
                        <field name="organizationPartyId" from="organizationPartyId">
                            <default-field>
                                <hidden/>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="">
                                <submit text="Review selected"/>
                            </default-field>
                        </field>
                    </form-single>
                </action>
            </row-selection>
            <field name="description">
                <default-field title="Entry">
                    <link url="//Accounting/GeneralLedger/JournalEntryDetail"
                            text="${description || 'Journal entry ' + acctgTransId}"
                            link-type="anchor"
                            parameter-map="{recordId:acctgTransId, organizationPartyId:organizationPartyId}"/>
                </default-field>
            </field>
            <field name="acctgTransId">
                <default-field title="ID">
                    <display/>
                </default-field>
            </field>
            <field name="transactionDate">
                <default-field title="Date">
                    <display text="${transactionDateText || ''}"/>
                </default-field>
            </field>
            <field name="isPosted">
                <default-field title="State">
                    <render-mode>
                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${isPosted == 'Y' ?
                            'positive' : 'warning'}">${isPosted == 'Y' ? 'Posted' : 'Draft'}</q-chip>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: isPosted == 'Y' ? 'Posted'
                            : 'Draft'})}]]></text>
                    </render-mode>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="description"/>
                    <field-ref name="transactionDate"/>
                </column>
                <column>
                    <field-ref name="isPosted"/>
                </column>
            </columns>
        </form-list>
        <label text="No journal entries match. Choose another organization or search, or create a new journal entry."
                type="p"
                condition="!records.length"/>
    </widgets>
</screen>
