    <service verb="search" noun="ProductIds">
        <in-parameters>
            <parameter name="text" required="true"/>
            <parameter name="limit" type="Integer" default="5"/>
            <parameter name="docTypes" type="List"/>
            <parameter name="idMatch" type="Boolean"/>
        </in-parameters>
        <out-parameters><parameter name="rows" type="List"/></out-parameters>
        <actions><script><![CDATA[
            rows = []
            const access = ec.service.sync().name('ironstone.products.CatalogServices.get#CatalogAccess').call() || {}
            if (!access.capabilities?.read) return
            // Resolve separately in authorized owner scopes: ambiguous/hidden identifiers must never name another owner's products.
            const found = new Set()
            const owners = access.capabilities.systemAdmin ? [null] : Array.from(access.ownerPartyIds || [])
            for (const owner of owners) {
                ec.message.pushErrors()
                try {
                    const result = ec.service.sync().name('mantle.product.ProductServices.find#ProductByIdValue')
                        .parameters({idValue: text, ownerPartyId: owner}).disableAuthz().requireNewTransaction(true).call() || {}
                    if (ec.message.hasError()) throw new Error(ec.message.getErrorsString())
                    if (result.productId) found.add(result.productId)
                } catch (err) {
                    ec.logger.error(`Product identifier lookup for owner ${owner || 'system'} failed: ${err}`)
                } finally { ec.message.clearErrors(); ec.message.popErrors() }
            }
            for (const productId of found) {
                const result = ec.service.sync().name('ironstone.products.CatalogServices.get#CatalogRecord')
                    .parameters({recordId: productId, checkOnly: true}).call() || {}
                if (result.record && rows.length < Math.max(1, Math.min(20, Number(limit || 5)))) rows.push({
                    title: result.record.productName || productId, subtitle: productId + (result.record.ownerPartyId === '_NA_' ? ' · Shared' : ''),
                    icon: 'sym_o_inventory_2', url: '/qapps/Products/Products/Product360?productId=' + encodeURIComponent(productId)})
            }
        ]]></script></actions>
    </service>
