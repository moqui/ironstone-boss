<!-- The Inbox (design-drawers-commons.md §12 Inbox), the component Mail.xml serves in the qvue render mode: the rail of views,
    accounts, folders, labels, the Internal account, mailboxes and saved searches; the search line with Gmail's operators;
    the thread list in date groups with selection and hover actions; the reading pane right, bottom or off; the composer
    docks at the bottom right (Compose.qvue in an m-dynamic-container each); the Inbox key scope. The view is in the URL
    (view, account, folder, label, mailbox, q, thread), read from $root.currentParameters, so a view is a link and the
    browser's Back works. Data and actions are the JSON transitions of Mail.xml. Brand color names and Quasar classes only
    (style-guide §4.8, §5); the m-* inputs for what is typed. -->
<template><div class="m-inbox-root"><div class="m-inbox column no-wrap" :style="{height: height + 'px'}">
    <!-- the search line and the view's tools -->
    <div class="row items-center no-wrap q-px-sm q-py-xs q-gutter-x-xs">
        <q-btn v-if="isPhone" flat round dense icon="sym_o_menu" :aria-label="t('Folders')" @click="railDialog = true"><q-tooltip>{{t('Folders')}}</q-tooltip></q-btn>
        <q-btn v-else flat round dense :icon="railCollapsed ? 'sym_o_left_panel_open' : 'sym_o_left_panel_close'" :aria-label="t('Collapse the folders')"
                @click="toggleRail"><q-tooltip>{{railCollapsed ? t('Show the folders') : t('Collapse the folders')}}</q-tooltip></q-btn>
        <div class="col" style="max-width:760px" @keydown.enter.prevent="runSearch" @keydown.esc="clearSearchInput">
            <m-text-line v-model="searchInput" name="inboxSearch" id="InboxSearch" :label="t('Search mail and messages')"
                    :tooltip="t('Operators: from: to: subject: has:attachment label: in: is:unread is:flagged before: after: older_than: larger:')"></m-text-line>
        </div>
        <q-btn flat round dense icon="sym_o_search" :aria-label="t('Search')" @click="runSearch"><q-tooltip>{{t('Search')}}</q-tooltip></q-btn>
        <q-btn flat round dense icon="sym_o_tune" :aria-label="t('Advanced search')"><q-tooltip>{{t('Advanced search')}}</q-tooltip>
            <q-menu v-model="advancedOpen" anchor="bottom right" self="top right" @before-show="fillAdvanced">
                <div class="q-pa-md" style="width:360px;max-width:92vw">
                    <div class="text-subtitle2 q-mb-sm">{{t('Advanced search')}}</div>
                    <m-text-line v-model="advanced.from" name="advFrom" :label="t('From')"></m-text-line>
                    <m-text-line v-model="advanced.to" name="advTo" :label="t('To')" class="q-mt-xs"></m-text-line>
                    <m-text-line v-model="advanced.subject" name="advSubject" :label="t('Subject')" class="q-mt-xs"></m-text-line>
                    <m-text-line v-model="advanced.words" name="advWords" :label="t('Has the words')" class="q-mt-xs"></m-text-line>
                    <m-text-line v-model="advanced.without" name="advWithout" :label="t('Does not have')" class="q-mt-xs"></m-text-line>
                    <div class="row q-col-gutter-xs q-mt-none">
                        <div class="col-6"><m-drop-down v-model="advanced.within" name="advWithin" :options="withinOptions" allow-empty :label="t('Date within')"></m-drop-down></div>
                        <div class="col-6"><m-drop-down v-model="advanced.where" name="advWhere" :options="whereOptions" allow-empty :label="t('Search in')"></m-drop-down></div>
                    </div>
                    <m-check v-model="advanced.flags" name="advFlags" :options="advancedFlagOptions" class="q-mt-xs"></m-check>
                    <div class="row q-mt-sm q-gutter-sm">
                        <q-btn unelevated no-caps color="primary" :label="t('Search')" @click="runAdvanced"></q-btn>
                        <q-btn flat no-caps :label="t('Clear')" @click="clearAdvanced"></q-btn>
                    </div>
                </div>
            </q-menu>
        </q-btn>
        <q-btn v-if="params.q && !isPhone" flat dense no-caps icon="sym_o_bookmark_add" :label="t('Save search')" @click="openSaveSearch"></q-btn>
        <q-space></q-space>
        <q-chip v-if="syncingAny" dense square class="m-tonal text-info gt-xs" icon="sym_o_sync">{{t('Syncing…')}}</q-chip>
        <q-btn v-if="mailAccounts.length" flat round dense icon="sym_o_sync" :loading="syncBusy" :aria-label="t('Sync now')" @click="syncNow">
            <q-tooltip>{{t('Sync now')}}</q-tooltip></q-btn>
        <q-btn v-if="!isPhone" flat round dense :icon="paneIcon" :aria-label="t('Reading pane')"><q-tooltip>{{t('Reading pane')}}</q-tooltip>
            <q-menu anchor="bottom right" self="top right">
                <q-list dense style="min-width:180px">
                    <q-item v-for="option in paneOptions" :key="option.value" clickable v-close-popup :active="pane === option.value" @click="setPane(option.value)">
                        <q-item-section avatar><q-icon :name="option.icon"></q-icon></q-item-section>
                        <q-item-section>{{option.label}}</q-item-section></q-item>
                </q-list>
            </q-menu>
        </q-btn>
    </div>
    <!-- the search's operators as chips -->
    <div v-if="params.q" class="row items-center q-px-sm q-pb-xs q-gutter-xs">
        <span class="text-caption m-muted">{{t('Results for')}}</span>
        <q-chip v-for="(chip, index) in termChips" :key="index" dense removable square class="m-tonal" @remove="removeTerm(chip)">{{chip.label}}</q-chip>
        <q-chip v-if="freeText" dense square class="m-tonal" icon="sym_o_search">{{freeText}}</q-chip>
        <q-btn flat dense no-caps size="sm" color="primary" :label="t('Clear search')" @click="clearSearch"></q-btn>
    </div>
    <q-separator></q-separator>

    <div class="col row no-wrap" style="min-height:0">
        <!-- the rail -->
        <div v-if="!isPhone" class="column no-wrap" :style="{width: railCollapsed ? '56px' : '248px', minWidth: railCollapsed ? '56px' : '248px'}">
            <div class="col scroll" style="min-height:0;overflow-x:hidden"><inbox-rail :inbox="self" :mini="railCollapsed"></inbox-rail></div>
        </div>
        <q-separator v-if="!isPhone" vertical></q-separator>

        <!-- the list and the reading pane -->
        <div ref="main" class="col column no-wrap" style="min-width:0">
            <!-- a mailbox's header -->
            <div v-if="params.mailbox && mailbox" class="q-px-md q-pt-sm q-pb-xs">
                <div class="row items-center no-wrap q-gutter-x-sm">
                    <q-icon :name="mailbox.isPublic ? 'sym_o_forum' : 'sym_o_lock'" size="sm" class="m-muted"></q-icon>
                    <div class="col" style="min-width:0">
                        <div class="text-subtitle1 text-weight-medium ellipsis">{{mailbox.contactListName}}
                            <q-chip v-if="mailbox.isArchived" dense square class="m-tonal text-warning q-ml-xs">{{t('Archived')}}</q-chip></div>
                        <div v-if="mailbox.description" class="text-caption m-muted ellipsis">{{mailbox.description}}</div>
                    </div>
                    <div v-if="mailbox.memberList.length" class="row no-wrap items-center gt-xs cursor-pointer" @click="openMailboxSettings('members')">
                        <m-avatar v-for="member in mailbox.memberList.slice(0, 5)" :key="member.partyId" :name="member.name" size="24px" tooltip class="q-ml-xs"></m-avatar>
                        <span class="text-caption m-muted q-ml-xs">{{memberCountText}}</span>
                    </div>
                    <q-chip dense square class="m-tonal gt-xs">{{mailbox.isPublic ? t('Public') : t('Private')}}</q-chip>
                    <q-btn v-if="!mailbox.isMember && mailbox.membershipStatusId !== 'CLPT_PENDING' && mailbox.canJoin" dense unelevated no-caps color="primary"
                            :label="mailbox.isPublic ? t('Join') : t('Request to join')" @click="mailboxJoin"></q-btn>
                    <q-chip v-if="mailbox.membershipStatusId === 'CLPT_PENDING'" dense square class="m-tonal text-warning">{{t('Request pending')}}</q-chip>
                    <q-btn v-if="mailbox.isMember && mailbox.canPost && !mailbox.isArchived" dense unelevated no-caps class="m-btn-tonal" icon="sym_o_edit"
                            :label="t('New post')" @click="composeToMailbox"></q-btn>
                    <q-btn v-if="mailbox.isMember" dense flat no-caps :icon="mailbox.deliveryEnumId === 'CldMailboxOnly' ? 'sym_o_notifications_off' : 'sym_o_inbox'"
                            :label="isPhone ? undefined : (mailbox.deliveryEnumId === 'CldMailboxOnly' ? t('Mailbox only') : t('In my Inbox'))">
                        <q-tooltip>{{t('Where its posts go')}}</q-tooltip>
                        <q-menu><q-list dense style="min-width:220px">
                            <q-item clickable v-close-popup :active="mailbox.deliveryEnumId !== 'CldMailboxOnly'" @click="mailboxDelivery('CldInbox')">
                                <q-item-section><q-item-label>{{t('In my Inbox')}}</q-item-label><q-item-label caption>{{t('Each post in the Inbox and its count')}}</q-item-label></q-item-section></q-item>
                            <q-item clickable v-close-popup :active="mailbox.deliveryEnumId === 'CldMailboxOnly'" @click="mailboxDelivery('CldMailboxOnly')">
                                <q-item-section><q-item-label>{{t('Mailbox only')}}</q-item-label><q-item-label caption>{{t('Posts stay here, with the unread count in the rail')}}</q-item-label></q-item-section></q-item>
                        </q-list></q-menu>
                    </q-btn>
                    <q-btn flat round dense icon="sym_o_more_vert" :aria-label="t('Mailbox')"><q-tooltip>{{t('Mailbox')}}</q-tooltip>
                        <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:200px">
                            <q-item clickable v-close-popup @click="openMailboxSettings('members')"><q-item-section avatar><q-icon name="sym_o_group"></q-icon></q-item-section>
                                <q-item-section>{{t('Members')}}<q-badge v-if="mailbox.pendingList.length" color="warning" text-color="dark" floating>{{mailbox.pendingList.length}}</q-badge></q-item-section></q-item>
                            <q-item v-if="mailbox.isOwner" clickable v-close-popup @click="openMailboxSettings('settings')"><q-item-section avatar><q-icon name="sym_o_settings"></q-icon></q-item-section>
                                <q-item-section>{{t('Settings')}}</q-item-section></q-item>
                            <q-item v-if="mailbox.isMember" clickable v-close-popup @click="mailboxLeave"><q-item-section avatar><q-icon name="sym_o_logout"></q-icon></q-item-section>
                                <q-item-section>{{t('Leave')}}</q-item-section></q-item>
                        </q-list></q-menu>
                    </q-btn>
                </div>
                <q-banner v-if="!mailbox.canReadOwn" dense rounded class="q-mt-sm m-tonal text-info">{{t('This mailbox is private: its posts show once an owner accepts your request.')}}</q-banner>
                <q-banner v-else-if="!mailbox.isMember && mailbox.isPublic" dense rounded class="q-mt-sm m-tonal text-info">{{t('You are reading this mailbox without being a member: join to post and to get its posts.')}}</q-banner>
            </div>
            <q-separator v-if="params.mailbox && mailbox"></q-separator>

            <div ref="panes" class="col no-wrap" :class="pane === 'bottom' && splitMode ? 'column' : 'row'" style="min-height:0">
                <!-- the thread list -->
                <div v-show="showList" class="column no-wrap" :style="listStyle">
                    <!-- its header: the view and its tools, or the bulk actions on the selection -->
                    <div class="row items-center no-wrap q-px-sm" style="min-height:40px">
                        <q-checkbox v-if="!isPhone" dense size="sm" :model-value="headerCheck" @update:model-value="toggleAll" :aria-label="t('Select all')"></q-checkbox>
                        <template v-if="selectedKeys.length">
                            <span class="text-caption q-mx-sm">{{allInView ? t('All in this view') : selectedKeys.length + ' ' + t('selected')}}</span>
                            <q-btn flat round dense icon="sym_o_archive" :aria-label="t('Archive')" @click="bulk('archive')"><q-tooltip>{{t('Archive')}} (e)</q-tooltip></q-btn>
                            <q-btn flat round dense icon="sym_o_delete" :aria-label="t('Delete')" @click="bulk(view === 'trash' ? 'deleteForever' : 'trash')"><q-tooltip>{{view === 'trash' ? t('Delete forever') : t('Delete')}} (#)</q-tooltip></q-btn>
                            <q-btn flat round dense icon="sym_o_drafts" :aria-label="t('Mark read')" @click="bulk('read')"><q-tooltip>{{t('Mark read')}} (Shift+I)</q-tooltip></q-btn>
                            <q-btn flat round dense icon="sym_o_mark_email_unread" :aria-label="t('Mark unread')" @click="bulk('unread')"><q-tooltip>{{t('Mark unread')}} (Shift+U)</q-tooltip></q-btn>
                            <q-btn flat round dense icon="sym_o_snooze" :aria-label="t('Snooze')" @click="openSnooze(null)"><q-tooltip>{{t('Snooze')}} (b)</q-tooltip></q-btn>
                            <q-btn flat round dense icon="sym_o_more_vert" :aria-label="t('More')"><q-tooltip>{{t('More')}}</q-tooltip>
                                <q-menu><q-list dense style="min-width:200px">
                                    <q-item clickable v-close-popup @click="bulk('flag')"><q-item-section avatar><q-icon name="star" color="warning"></q-icon></q-item-section><q-item-section>{{t('Flag')}}</q-item-section></q-item>
                                    <q-item clickable v-close-popup @click="bulk('unflag')"><q-item-section avatar><q-icon name="sym_o_star"></q-icon></q-item-section><q-item-section>{{t('Remove flag')}}</q-item-section></q-item>
                                    <q-item v-if="selectionHasEmail" clickable v-close-popup @click="openMove(null)"><q-item-section avatar><q-icon name="sym_o_drive_file_move"></q-icon></q-item-section><q-item-section>{{t('Move to…')}}</q-item-section></q-item>
                                    <q-item v-if="selectionCanLabel" clickable v-close-popup @click="openLabels(null)"><q-item-section avatar><q-icon name="sym_o_label"></q-icon></q-item-section><q-item-section>{{t('Labels…')}}</q-item-section></q-item>
                                    <q-item v-if="selectionHasEmail" clickable v-close-popup @click="bulk(view === 'junk' ? 'notSpam' : 'spam')"><q-item-section avatar><q-icon name="sym_o_report"></q-icon></q-item-section>
                                        <q-item-section>{{view === 'junk' ? t('Not spam') : t('Report spam')}}</q-item-section></q-item>
                                    <q-item v-if="['archive', 'all'].includes(view) || params.view === 'internalArchive'" clickable v-close-popup @click="bulk('unarchive')"><q-item-section avatar><q-icon name="sym_o_move_to_inbox"></q-icon></q-item-section><q-item-section>{{t('Move to Inbox')}}</q-item-section></q-item>
                                </q-list></q-menu>
                            </q-btn>
                            <q-space></q-space>
                            <q-btn flat dense no-caps size="sm" :label="t('Clear')" @click="clearSelection"></q-btn>
                        </template>
                        <template v-else>
                            <div class="text-subtitle2 ellipsis q-ml-sm">{{viewTitle}}</div>
                            <q-space></q-space>
                            <q-btn flat dense no-caps size="sm" :color="unreadOnly ? 'primary' : undefined" :icon="unreadOnly ? 'sym_o_filter_alt' : 'sym_o_filter_alt_off'"
                                    :label="isPhone ? undefined : t('Unread')" @click="toggleUnread"><q-tooltip>{{t('Only unread')}}</q-tooltip></q-btn>
                            <q-btn flat round dense icon="sym_o_refresh" :loading="loadingList && !threads.length" :aria-label="t('Refresh')" @click="reloadAll"><q-tooltip>{{t('Refresh')}}</q-tooltip></q-btn>
                            <q-btn v-if="isPhone" flat round dense icon="sym_o_edit" color="primary" :aria-label="t('Compose')" @click="compose()"></q-btn>
                        </template>
                    </div>
                    <div v-if="selectedKeys.length && allLoadedSelected && hasMore && !allInView" class="text-caption q-px-md q-pb-xs">
                        {{t('Every conversation loaded is selected.')}} <a href="#" class="text-primary" @click.prevent="allInView = true">{{t('Select every conversation in this view')}}</a>
                    </div>
                    <q-separator></q-separator>

                    <div ref="list" class="col scroll" style="min-height:0" @scroll="onListScroll">
                        <!-- no mail account: the setup card, the Internal account still here -->
                        <q-card v-if="loaded && !mailAccounts.length && showSetupCard" flat bordered class="q-ma-sm">
                            <q-card-section class="row items-center no-wrap q-gutter-x-md">
                                <q-icon name="sym_o_mail" size="md" color="primary"></q-icon>
                                <div class="col">
                                    <div class="text-subtitle2">{{t('Read your email here')}}</div>
                                    <div class="text-caption m-muted">{{t('Add a mail account (Gmail, Outlook, your own domain) to read and send email next to your internal messages.')}}</div>
                                </div>
                                <q-btn unelevated no-caps color="primary" :label="t('Add an account')" @click="go('/qapps/Comms/Settings/MailAccounts/Add?fresh=Y')"></q-btn>
                            </q-card-section>
                        </q-card>
                        <q-banner v-for="account in warnedAccounts" :key="account.emailAccountId" dense class="q-ma-sm m-tonal text-warning" rounded>
                            <template v-slot:avatar><q-icon name="sym_o_warning"></q-icon></template>
                            {{account.accountName}}: {{account.warning === 'authFailed' ? t('the sign-in failed; mail is not syncing.') : (account.warning === 'paused' ? t('sync is paused.') : t('the last sync failed') + (account.lastSyncError ? ': ' + account.lastSyncError : '.'))}}
                            <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('Fix')" @click="go(fixUrl(account))"></q-btn></template>
                        </q-banner>
                        <q-banner v-if="data.outOfOfficeList && data.outOfOfficeList.length" dense class="q-ma-sm m-tonal text-info" rounded>
                            <template v-slot:avatar><q-icon name="sym_o_beach_access"></q-icon></template>
                            {{t('Your automatic reply is on')}}: {{data.outOfOfficeList.map((item) => item.accountName).join(', ')}}
                            <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('Change')" @click="go('/qapps/Comms/Settings/OutOfOffice?emailAccountId=' + encodeURIComponent(data.outOfOfficeList[0].emailAccountId))"></q-btn></template>
                        </q-banner>
                        <q-banner v-if="failedStores.length" dense class="q-ma-sm m-tonal text-warning" rounded>
                            {{failedStores.includes('email') ? t('Your mail could not be read just now; internal messages are shown.') : t('Internal messages could not be read just now; mail is shown.')}}
                        </q-banner>
                        <div v-if="listError" class="q-pa-md text-negative">{{listError}}</div>

                        <!-- skeleton rows while the first page loads -->
                        <div v-if="loadingList && !threads.length" class="q-pa-sm">
                            <div v-for="n in 8" :key="n" class="row items-center no-wrap q-py-sm q-gutter-x-sm">
                                <q-skeleton type="QCheckbox" size="18px"></q-skeleton>
                                <div class="col"><q-skeleton type="text" width="40%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
                            </div>
                        </div>

                        <q-list v-else dense>
                            <template v-for="group in groups" :key="group.key">
                                <q-item-label header class="q-py-xs q-px-md text-caption text-weight-medium">{{group.label}}</q-item-label>
                                <q-item v-for="row in group.rows" :key="row.rowKey" :id="domId('inbox-row-', row.rowKey)" clickable
                                        :active="row.rowKey === openKey" :active-class="activeClass" class="q-pl-xs q-pr-sm"
                                        :class="selected[row.rowKey] ? selectedClass : ''" :style="swipeStyle(row)" @click="clickRow(row, $event)"
                                        @mouseenter="hoverKey = row.rowKey" @mouseleave="hoverKey = hoverKey === row.rowKey ? null : hoverKey"
                                        @touchstart.passive="swipeStart(row, $event)" @touchmove.passive="swipeMove(row, $event)" @touchend="swipeEnd(row)">
                                    <div class="self-stretch" :class="row.rowKey === focusKey ? 'bg-primary' : ''" style="width:3px;margin-right:4px"></div>
                                    <q-item-section v-if="!isPhone" side top class="q-pr-none q-pt-xs" style="min-width:0">
                                        <div class="row no-wrap items-center">
                                            <q-checkbox dense size="sm" :model-value="!!selected[row.rowKey] || allInView" @click.stop
                                                    @update:model-value="checkRow(row, $event)" :aria-label="t('Select')"></q-checkbox>
                                            <q-btn flat round dense size="sm" :icon="row.isFlagged ? 'star' : 'sym_o_star'" :color="row.isFlagged ? 'warning' : undefined"
                                                    :aria-label="row.isFlagged ? t('Remove flag') : t('Flag')" @click.stop="toggleRowFlag(row)"></q-btn>
                                        </div>
                                    </q-item-section>
                                    <q-item-section style="min-width:0">
                                        <q-item-label class="row no-wrap items-center">
                                            <q-icon v-if="row.store === 'internal'" :name="row.contactListId ? 'sym_o_forum' : 'sym_o_chat_bubble'" size="14px" class="m-muted q-mr-xs">
                                                <q-tooltip>{{row.contactListId ? t('Mailbox post') : t('Internal message')}}</q-tooltip></q-icon>
                                            <span class="ellipsis" :class="row.isUnread ? 'text-weight-bold' : ''">{{participantsText(row)}}</span>
                                            <span v-if="row.messageCount > 1" class="text-caption m-muted q-ml-xs">{{row.messageCount}}</span>
                                            <span v-if="row.draftCount && view !== 'drafts'" class="text-caption text-negative q-ml-xs">{{t('Draft')}}</span>
                                            <q-space></q-space>
                                            <!-- the date and the hover actions share a fixed-width end column, so the row never shifts on hover:
                                                 the actions fade in over the date (opacity only, no layout change) -->
                                            <div class="m-inbox-row-end">
                                                <div class="m-inbox-row-end-date row no-wrap items-center" :class="{ 'm-inbox-hidden': hoverKey === row.rowKey && !isTouch }">
                                                    <q-icon v-if="row.hasAttachment" name="sym_o_attach_file" size="14px" class="m-muted"></q-icon>
                                                    <span class="text-caption q-ml-xs text-no-wrap" :class="row.isUnread ? 'text-weight-bold' : 'm-muted'">{{shortDate(row.sortDate)}}</span>
                                                </div>
                                                <div class="m-inbox-row-end-actions row no-wrap items-center" :class="{ 'm-inbox-shown': hoverKey === row.rowKey && !isTouch }" @click.stop>
                                                    <q-btn flat round dense size="sm" icon="sym_o_archive" :aria-label="t('Archive')" @click="rowAction(row, 'archive')"><q-tooltip>{{t('Archive')}}</q-tooltip></q-btn>
                                                    <q-btn flat round dense size="sm" icon="sym_o_delete" :aria-label="t('Delete')" @click="rowAction(row, view === 'trash' ? 'deleteForever' : 'trash')"><q-tooltip>{{t('Delete')}}</q-tooltip></q-btn>
                                                    <q-btn flat round dense size="sm" :icon="row.isUnread ? 'sym_o_drafts' : 'sym_o_mark_email_unread'" :aria-label="row.isUnread ? t('Mark read') : t('Mark unread')"
                                                            @click="rowAction(row, row.isUnread ? 'read' : 'unread')"><q-tooltip>{{row.isUnread ? t('Mark read') : t('Mark unread')}}</q-tooltip></q-btn>
                                                    <q-btn flat round dense size="sm" icon="sym_o_snooze" :aria-label="t('Snooze')" @click="openSnooze([row])"><q-tooltip>{{t('Snooze')}}</q-tooltip></q-btn>
                                                </div>
                                            </div>
                                        </q-item-label>
                                        <q-item-label class="ellipsis">
                                            <span :class="row.isUnread ? 'text-weight-bold' : ''">{{row.subject || t('(no subject)')}}</span>
                                            <span v-if="row.snippet" class="m-muted"> — {{row.snippet}}</span>
                                        </q-item-label>
                                        <q-item-label v-if="rowChips(row).length" class="row no-wrap items-center q-gutter-x-xs" style="overflow:hidden">
                                            <q-chip v-for="chip in rowChips(row)" :key="chip.key" dense square size="sm" :icon="chip.icon" class="m-tonal q-ml-none"
                                                    :class="chip.color ? 'text-' + chip.color : ''">{{chip.label}}</q-chip>
                                        </q-item-label>
                                    </q-item-section>
                                </q-item>
                            </template>
                        </q-list>
                        <div v-if="!loadingList && loaded && !threads.length && !listError" class="column items-center q-pa-xl m-muted">
                            <q-icon :name="params.q ? 'sym_o_search_off' : 'sym_o_inbox'" size="lg"></q-icon>
                            <div class="q-mt-sm">{{params.q ? t('No conversations match') : emptyText}}</div>
                            <q-btn v-if="params.q || unreadOnly" flat dense no-caps color="primary" :label="t('Clear filters')" @click="clearFilters"></q-btn>
                        </div>
                        <div v-if="threads.length && (hasMore || loadingList)" class="row justify-center q-pa-sm">
                            <q-btn flat dense no-caps color="primary" :loading="loadingList" :label="t('Load more')" @click="loadMore"></q-btn>
                        </div>
                    </div>
                </div>

                <!-- the gutter between the list and the pane, dragged to resize -->
                <div v-if="splitMode" class="row items-stretch justify-center" :style="gutterStyle" @mousedown.prevent="startDrag">
                    <q-separator :vertical="pane !== 'bottom'"></q-separator>
                </div>

                <!-- the reading pane -->
                <div v-show="showPane" ref="pane" class="scroll" :class="splitMode ? '' : 'col'" :style="paneStyle">
                    <div v-if="loadingThread && !thread" class="q-pa-md">
                        <q-skeleton type="text" width="60%" height="28px"></q-skeleton>
                        <div v-for="n in 2" :key="n" class="row no-wrap q-mt-md q-gutter-x-sm"><q-skeleton type="QAvatar" size="36px"></q-skeleton>
                            <div class="col"><q-skeleton type="text" width="30%"></q-skeleton><q-skeleton type="rect" height="80px"></q-skeleton></div></div>
                    </div>
                    <div v-else-if="thread" class="q-pa-md">
                        <!-- the thread's header and its actions (on a phone the actions go under the subject) -->
                        <div class="q-mb-sm" :class="isPhone ? 'column' : 'row items-start no-wrap'">
                            <div class="col row items-start no-wrap" style="min-width:0">
                            <q-btn v-if="!splitMode" flat round dense icon="sym_o_arrow_back" class="q-mr-xs" :aria-label="t('Back')" @click="closeThread"><q-tooltip>{{t('Back')}} (u)</q-tooltip></q-btn>
                            <div class="col" style="min-width:0">
                                <div class="text-h6" style="word-break:break-word">{{thread.subject || t('(no subject)')}}</div>
                                <div class="row items-center q-gutter-xs q-mt-xs">
                                    <q-chip v-if="thread.contactListName" dense square class="m-tonal q-ml-none" icon="sym_o_forum" clickable
                                            @click="openView({mailbox: thread.contactListId})">{{thread.contactListName}}</q-chip>
                                    <q-chip v-if="thread.isClosed" dense square class="m-tonal text-positive q-ml-none" icon="sym_o_lock">{{t('Closed')}}</q-chip>
                                    <q-chip v-if="thread.forum && thread.forum.kind === 'private'" dense square class="m-tonal q-ml-none" icon="sym_o_lock_person">{{t('Private conversation')}}</q-chip>
                                    <q-chip v-else-if="thread.forum" dense square class="m-tonal q-ml-none" icon="sym_o_public">{{t('Community topic')}}</q-chip>
                                    <q-chip v-if="thread.forum && thread.forum.acceptedAnswerId" dense square class="m-tonal text-positive q-ml-none" icon="sym_o_check_circle">{{t('Answered')}}</q-chip>
                                    <q-chip v-if="thread.forum && thread.forum.pinned" dense square class="m-tonal q-ml-none" icon="sym_o_keep">{{t('Pinned')}}</q-chip>
                                    <q-chip v-for="label in thread.labelList" :key="label.emailLabelId" dense square class="m-tonal q-ml-none" icon="sym_o_label"
                                            removable @remove="removeLabel(label)">{{label.labelName}}</q-chip>
                                    <q-chip v-if="threadFolderLabel" dense square class="m-tonal q-ml-none" icon="sym_o_folder">{{threadFolderLabel}}</q-chip>
                                </div>
                            </div>
                            </div>
                            <div class="row no-wrap items-center" :class="isPhone ? 'q-mt-xs' : ''">
                                <q-btn flat round dense icon="sym_o_archive" :aria-label="t('Archive')" @click="threadAction('archive')"><q-tooltip>{{t('Archive')}} (e)</q-tooltip></q-btn>
                                <q-btn flat round dense icon="sym_o_delete" :aria-label="t('Delete')" @click="threadAction(threadInTrash ? 'deleteForever' : 'trash')"><q-tooltip>{{t('Delete')}} (#)</q-tooltip></q-btn>
                                <q-btn v-if="thread.store === 'email' && !isPhone" flat round dense icon="sym_o_report" :aria-label="t('Report spam')" @click="threadAction(thread.folderKindEnumId === 'EfkJunk' ? 'notSpam' : 'spam')">
                                    <q-tooltip>{{thread.folderKindEnumId === 'EfkJunk' ? t('Not spam') : t('Report spam')}} (!)</q-tooltip></q-btn>
                                <q-btn flat round dense icon="sym_o_mark_email_unread" :aria-label="t('Mark unread')" @click="threadAction('unread')"><q-tooltip>{{t('Mark unread')}} (Shift+U)</q-tooltip></q-btn>
                                <q-btn flat round dense icon="sym_o_snooze" :aria-label="t('Snooze')" @click="openSnooze('thread')"><q-tooltip>{{t('Snooze')}} (b)</q-tooltip></q-btn>
                                <q-btn flat round dense icon="sym_o_more_vert" :aria-label="t('More')"><q-tooltip>{{t('More')}}</q-tooltip>
                                    <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:230px">
                                        <q-item v-if="thread.store === 'email'" clickable v-close-popup @click="openMove('thread')"><q-item-section avatar><q-icon name="sym_o_drive_file_move"></q-icon></q-item-section><q-item-section>{{t('Move to…')}}</q-item-section><q-item-section side>v</q-item-section></q-item>
                                        <q-item v-if="thread.store === 'email' || thread.store === 'internal'" clickable v-close-popup @click="openLabels('thread')"><q-item-section avatar><q-icon name="sym_o_label"></q-icon></q-item-section><q-item-section>{{t('Labels…')}}</q-item-section><q-item-section side>l</q-item-section></q-item>
                                        <q-item clickable v-close-popup @click="threadAction(thread.isFlagged ? 'unflag' : 'flag')"><q-item-section avatar><q-icon :name="thread.isFlagged ? 'star' : 'sym_o_star'" :color="thread.isFlagged ? 'warning' : undefined"></q-icon></q-item-section>
                                            <q-item-section>{{thread.isFlagged ? t('Remove flag') : t('Flag')}}</q-item-section><q-item-section side>s</q-item-section></q-item>
                                        <q-item clickable v-close-popup @click="openLink(lastMessage)"><q-item-section avatar><q-icon name="sym_o_add_link"></q-icon></q-item-section><q-item-section>{{t('Link to a record…')}}</q-item-section></q-item>
                                        <q-item clickable v-close-popup @click="createFrom(lastMessage, 'task')"><q-item-section avatar><q-icon name="sym_o_task_alt"></q-icon></q-item-section><q-item-section>{{t('Create a task')}}</q-item-section></q-item>
                                        <q-item clickable v-close-popup @click="createFrom(lastMessage, 'request')"><q-item-section avatar><q-icon name="sym_o_support"></q-icon></q-item-section><q-item-section>{{t('Create a request')}}</q-item-section></q-item>
                                        <q-item clickable v-close-popup @click="createFrom(lastMessage, 'event')"><q-item-section avatar><q-icon name="sym_o_event"></q-icon></q-item-section><q-item-section>{{t('Create an event')}}</q-item-section></q-item>
                                        <q-item v-if="thread.canModerate && !thread.isClosed" clickable v-close-popup @click="threadAction('close')"><q-item-section avatar><q-icon name="sym_o_lock"></q-icon></q-item-section><q-item-section>{{t('Close thread')}}</q-item-section></q-item>
                                        <q-item v-if="thread.canModerate && thread.isClosed" clickable v-close-popup @click="threadAction('reopen')"><q-item-section avatar><q-icon name="sym_o_lock_open"></q-icon></q-item-section><q-item-section>{{t('Reopen thread')}}</q-item-section></q-item>
                                        <q-item clickable v-close-popup @click="expandAll"><q-item-section avatar><q-icon name="sym_o_unfold_more"></q-icon></q-item-section><q-item-section>{{t('Expand all')}}</q-item-section></q-item>
                                        <q-item clickable v-close-popup @click="openDetail(lastMessage)"><q-item-section avatar><q-icon name="sym_o_print"></q-icon></q-item-section><q-item-section>{{t('Print or view source')}}</q-item-section></q-item>
                                    </q-list></q-menu>
                                </q-btn>
                                <q-btn v-if="splitMode" flat round dense icon="sym_o_close" :aria-label="t('Close')" @click="closeThread"><q-tooltip>{{t('Close')}}</q-tooltip></q-btn>
                            </div>
                        </div>
                        <!-- the records it is filed on -->
                        <div v-if="thread.linkList.length" class="row items-center q-gutter-xs q-mb-sm">
                            <span class="text-caption m-muted">{{t('On')}}</span>
                            <q-chip v-for="link in thread.linkList" :key="link.recordEntityName + link.recordId" dense square clickable :icon="link.icon || 'sym_o_link'"
                                    class="m-tonal text-primary q-ml-none" @click="go(link.url)">{{(link.typeLabel ? link.typeLabel + ' ' : '') + link.title}}</q-chip>
                        </div>

                        <!-- the messages, older ones collapsed -->
                        <template v-for="item in messageItems" :key="item.key">
                            <div v-if="item.kind === 'older'" class="row justify-center q-my-xs">
                                <q-btn flat dense no-caps color="primary" icon="sym_o_unfold_more" :label="item.count + ' ' + t('older messages')" @click="showOlder = true"></q-btn>
                            </div>
                            <q-card v-else-if="!isExpanded(item.message)" flat bordered class="q-mb-xs cursor-pointer" @click="expand(item.message)">
                                <q-card-section class="row items-center no-wrap q-py-xs q-px-md">
                                    <m-avatar :name="avatarName(item.message.from)" size="24px" class="q-mr-sm"></m-avatar>
                                    <span class="text-weight-medium q-mr-sm ellipsis" style="max-width:30%" :class="item.message.isUnread ? 'text-weight-bold' : ''">{{personName(item.message.from)}}</span>
                                    <span class="col ellipsis m-muted text-caption">{{plainSnippet(item.message)}}</span>
                                    <q-icon v-if="item.message.attachmentList.length" name="sym_o_attach_file" size="14px" class="m-muted q-mx-xs"></q-icon>
                                    <span class="text-caption m-muted text-no-wrap">{{shortDate(item.message.date)}}</span>
                                </q-card-section>
                            </q-card>
                            <q-card v-else flat bordered class="q-mb-sm" :id="domId('inbox-msg-', item.message.key)"
                                    :class="item.message.key === focusMessageKey ? 'shadow-2' : ''">
                                <q-card-section class="q-pb-xs">
                                    <div class="row no-wrap items-start">
                                        <m-avatar :name="avatarName(item.message.from)" size="36px" class="q-mr-sm"></m-avatar>
                                        <div class="col" style="min-width:0">
                                            <div class="row items-center no-wrap">
                                                <span class="text-weight-medium cursor-pointer text-no-wrap" @mouseenter="hoverContact(item.message.from, $event)"
                                                        @mouseleave="leaveContact" @click.stop="openContact(item.message.from, $event)">{{personName(item.message.from)}}</span>
                                                <span v-if="item.message.from && item.message.from.address" class="text-caption m-muted q-ml-xs ellipsis gt-xs" style="min-width:0">&lt;{{item.message.from.address}}&gt;</span>
                                                <q-btn v-if="item.message.unsubscribeMethod && !isPhone" flat dense no-caps size="sm" color="primary" class="q-ml-xs" :label="t('Unsubscribe')"
                                                        @click.stop="unsubscribe(item.message)"></q-btn>
                                                <q-space></q-space>
                                                <span class="text-caption m-muted text-no-wrap q-ml-sm">{{isPhone ? shortDate(item.message.date) : fullDate(item.message.date)}}</span>
                                                <q-btn flat round dense size="sm" :icon="item.message.isFlagged ? 'star' : 'sym_o_star'" :color="item.message.isFlagged ? 'warning' : undefined"
                                                        :aria-label="t('Flag')" @click.stop="flagMessage(item.message)"></q-btn>
                                                <q-btn v-if="canReplyTo(item.message)" flat round dense size="sm" icon="sym_o_reply" :aria-label="t('Reply')" @click.stop="reply(item.message, false)">
                                                    <q-tooltip>{{thread.contactListId ? t('Reply to mailbox') : t('Reply')}} (r)</q-tooltip></q-btn>
                                                <q-btn flat round dense size="sm" icon="sym_o_more_vert" :aria-label="t('More')" @click.stop>
                                                    <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:240px">
                                                        <q-item v-if="canReplyTo(item.message)" clickable v-close-popup @click="reply(item.message, false)"><q-item-section avatar><q-icon name="sym_o_reply"></q-icon></q-item-section>
                                                            <q-item-section>{{thread.contactListId ? t('Reply to mailbox') : t('Reply')}}</q-item-section></q-item>
                                                        <q-item v-if="item.message.store === 'internal' && thread.contactListId" clickable v-close-popup @click="replyToSender(item.message)"><q-item-section avatar><q-icon name="sym_o_person"></q-icon></q-item-section>
                                                            <q-item-section>{{t('Reply to sender')}}</q-item-section></q-item>
                                                        <q-item v-if="canReplyTo(item.message) && !thread.contactListId" clickable v-close-popup @click="reply(item.message, true)"><q-item-section avatar><q-icon name="sym_o_reply_all"></q-icon></q-item-section>
                                                            <q-item-section>{{t('Reply all')}}</q-item-section></q-item>
                                                        <q-item v-if="item.message.store === 'email'" clickable v-close-popup @click="forward(item.message)"><q-item-section avatar><q-icon name="sym_o_forward"></q-icon></q-item-section>
                                                            <q-item-section>{{t('Forward')}}</q-item-section></q-item>
                                                        <q-separator></q-separator>
                                                        <q-item clickable v-close-popup @click="markUnreadFrom(item.message)"><q-item-section avatar><q-icon name="sym_o_mark_email_unread"></q-icon></q-item-section>
                                                            <q-item-section>{{t('Mark unread from here')}}</q-item-section></q-item>
                                                        <q-item clickable v-close-popup @click="openLink(item.message)"><q-item-section avatar><q-icon name="sym_o_add_link"></q-icon></q-item-section><q-item-section>{{t('Link to a record…')}}</q-item-section></q-item>
                                                        <q-item clickable v-close-popup @click="createFrom(item.message, 'task')"><q-item-section avatar><q-icon name="sym_o_task_alt"></q-icon></q-item-section><q-item-section>{{t('Create a task')}}</q-item-section></q-item>
                                                        <q-item clickable v-close-popup @click="createFrom(item.message, 'request')"><q-item-section avatar><q-icon name="sym_o_support"></q-icon></q-item-section><q-item-section>{{t('Create a request')}}</q-item-section></q-item>
                                                        <q-item clickable v-close-popup @click="createFrom(item.message, 'event')"><q-item-section avatar><q-icon name="sym_o_event"></q-icon></q-item-section><q-item-section>{{t('Create an event')}}</q-item-section></q-item>
                                                        <q-item clickable v-close-popup @click="openDetail(item.message)"><q-item-section avatar><q-icon name="sym_o_code"></q-icon></q-item-section><q-item-section>{{t('Print or view source')}}</q-item-section></q-item>
                                                        <template v-if="item.message.store === 'email' && !(item.message.from && item.message.from.isMe)">
                                                            <q-separator></q-separator>
                                                            <q-item v-if="item.message.unsubscribeMethod" clickable v-close-popup @click="unsubscribe(item.message)"><q-item-section avatar><q-icon name="sym_o_unsubscribe"></q-icon></q-item-section><q-item-section>{{t('Unsubscribe')}}</q-item-section></q-item>
                                                            <q-item clickable v-close-popup @click="blockSender(item.message)"><q-item-section avatar><q-icon name="sym_o_block"></q-icon></q-item-section><q-item-section>{{t('Block sender')}}</q-item-section></q-item>
                                                            <q-item clickable v-close-popup @click="reportMessageSpam(item.message)"><q-item-section avatar><q-icon name="sym_o_report"></q-icon></q-item-section><q-item-section>{{t('Report spam')}}</q-item-section></q-item>
                                                        </template>
                                                    </q-list></q-menu>
                                                </q-btn>
                                            </div>
                                            <div class="text-caption m-muted cursor-pointer ellipsis" @click="toggleDetails(item.message)">{{recipientsText(item.message)}}
                                                <q-icon :name="details[item.message.key] ? 'sym_o_expand_less' : 'sym_o_expand_more'" size="14px"></q-icon></div>
                                            <div v-if="details[item.message.key]" class="text-caption q-mt-xs">
                                                <div><span class="m-muted">{{t('From')}}:</span> {{personFull(item.message.from)}}</div>
                                                <div v-if="item.message.toList.length"><span class="m-muted">{{t('To')}}:</span> {{item.message.toList.map(personFull).join(', ')}}</div>
                                                <div v-if="item.message.ccList.length"><span class="m-muted">{{t('Cc')}}:</span> {{item.message.ccList.map(personFull).join(', ')}}</div>
                                                <div v-if="item.message.bccList.length"><span class="m-muted">{{t('Bcc')}}:</span> {{item.message.bccList.map(personFull).join(', ')}}</div>
                                                <div><span class="m-muted">{{t('Date')}}:</span> {{longDate(item.message.date)}}</div>
                                            </div>
                                        </div>
                                    </div>
                                </q-card-section>
                                <q-card-section class="q-pt-xs">
                                    <q-banner v-if="item.message.isDraft" dense rounded class="m-tonal text-negative q-mb-sm">{{t('Draft')}}
                                        <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('Edit')" @click="compose({emailMessageId: item.message.emailMessageId})"></q-btn></template></q-banner>
                                    <q-banner v-if="item.message.sendError" dense rounded class="m-tonal text-negative q-mb-sm">{{t('Not sent')}}: {{item.message.sendError}}
                                        <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('Edit and retry')" @click="compose({emailMessageId: item.message.emailMessageId})"></q-btn></template></q-banner>
                                    <q-banner v-if="item.message.statusId === 'ES_SCHEDULED' && item.message.scheduledSendDate" dense rounded class="m-tonal text-info q-mb-sm">
                                        {{t('Sends')}} {{longDate(item.message.scheduledSendDate)}}
                                        <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('Cancel send')" @click="cancelScheduled(item.message)"></q-btn></template></q-banner>
                                    <m-html-view :html="item.message.html || undefined" :text="item.message.html ? undefined : (item.message.text || '')" :allow-remote="isTrusted(item.message)"
                                            :cid-map="cidMap(item.message)" :title="item.message.subject || t('Message')" @show-images="onShowImages(item.message)"></m-html-view>
                                    <div v-if="trustOffer === item.message.key && item.message.from && item.message.from.address" class="row items-center q-gutter-x-sm q-mt-xs text-caption">
                                        <span class="m-muted">{{t('Always show images from')}} {{item.message.from.address}}?</span>
                                        <q-btn flat dense no-caps size="sm" color="primary" :label="t('Always show')" @click="trustSender(item.message)"></q-btn>
                                        <q-btn flat dense no-caps size="sm" :label="t('Not now')" @click="trustOffer = null"></q-btn>
                                    </div>
                                    <!-- an invitation -->
                                    <q-card v-if="item.message.invitation" flat bordered class="q-mt-sm">
                                        <q-card-section class="row no-wrap items-start q-gutter-x-md">
                                            <q-icon name="sym_o_event" size="md" color="info"></q-icon>
                                            <div class="col">
                                                <div class="text-subtitle2">{{item.message.invitation.summary || t('Invitation')}}</div>
                                                <div class="text-caption">{{invitationWhen(item.message.invitation)}}</div>
                                                <div v-if="item.message.invitation.location" class="text-caption m-muted">{{item.message.invitation.location}}</div>
                                                <div v-if="item.message.invitation.organizer" class="text-caption m-muted">{{t('Organizer')}}: {{item.message.invitation.organizer.name || item.message.invitation.organizer.email}}</div>
                                                <div v-if="item.message.invitation.method === 'CANCEL'" class="text-caption text-negative">{{t('This event was cancelled')}}</div>
                                                <div v-else-if="item.message.invitation.method === 'REPLY'" class="text-caption m-muted">{{t('An answer to an invitation')}}</div>
                                                <div v-else class="row q-gutter-xs q-mt-xs">
                                                    <q-btn v-for="answer in invitationAnswers" :key="answer.value" dense no-caps unelevated :icon="answer.icon" :label="answer.label"
                                                            :color="item.message.invitation.myStatus === answer.status ? 'primary' : undefined"
                                                            :class="item.message.invitation.myStatus === answer.status ? '' : 'm-btn-tonal'" @click="respondInvite(item.message, answer.value)"></q-btn>
                                                    <q-btn v-if="item.message.invitation.workEffortId" flat dense no-caps color="primary" :label="t('Open event')"
                                                            @click="go('/qapps/Commons/Calendar/EventDetail?workEffortId=' + encodeURIComponent(item.message.invitation.workEffortId))"></q-btn>
                                                </div>
                                            </div>
                                        </q-card-section>
                                    </q-card>
                                    <!-- its files -->
                                    <div v-if="item.message.attachmentList.length" class="row q-gutter-xs q-mt-sm items-center">
                                        <span v-for="file in item.message.attachmentList" :key="file.id" class="row no-wrap items-center">
                                            <q-chip dense square clickable :icon="fileIcon(file)" class="m-tonal q-ml-none"
                                                    @click="openAttachment(item.message, file)">{{file.name}}<span v-if="file.size" class="m-muted q-ml-xs">{{sizeText(file.size)}}</span>
                                                <q-tooltip>{{t('Download')}} {{file.name}}</q-tooltip></q-chip>
                                            <q-btn flat round dense size="sm" icon="sym_o_drive_folder_upload" :aria-label="t('Save to Files')"
                                                    @click="openSaveFiles(item.message, file)"><q-tooltip>{{t('Save to Files')}}</q-tooltip></q-btn>
                                        </span>
                                    </div>
                                    <!-- the records it is filed on, each removable -->
                                    <div v-if="item.message.linkList.length" class="row items-center q-gutter-xs q-mt-sm">
                                        <q-icon name="sym_o_link" size="14px" class="m-muted"></q-icon>
                                        <q-chip v-for="link in item.message.linkList" :key="link.recordEntityName + link.recordId" dense square clickable removable
                                                class="m-tonal q-ml-none" :icon="link.icon || 'sym_o_link'" @click="go(link.url)" @remove="unlinkRecord(item.message, link)">{{(link.typeLabel ? link.typeLabel + ' ' : '') + link.title}}</q-chip>
                                    </div>
                                </q-card-section>
                            </q-card>
                        </template>

                        <!-- the reply bar -->
                        <div v-if="thread.isClosed && thread.contactListId" class="q-mt-sm text-caption m-muted row items-center q-gutter-x-xs">
                            <q-icon name="sym_o_lock" size="16px"></q-icon><span>{{t('This thread is closed: no more replies in the mailbox.')}}</span>
                            <q-btn flat dense no-caps size="sm" color="primary" :label="t('Reply to sender')" @click="replyToSender(lastMessage)"></q-btn>
                        </div>
                        <div v-else-if="lastMessage" class="row q-gutter-sm q-mt-sm">
                            <q-btn v-if="canReplyTo(lastMessage)" dense unelevated no-caps class="m-btn-tonal" icon="sym_o_reply"
                                    :label="thread.contactListId ? t('Reply to mailbox') : t('Reply')" @click="reply(lastMessage, false)"></q-btn>
                            <q-btn v-if="thread.contactListId && lastMessage.store === 'internal'" dense unelevated no-caps class="m-btn-tonal" icon="sym_o_person"
                                    :label="t('Reply to sender')" @click="replyToSender(lastMessage)"></q-btn>
                            <q-btn v-if="canReplyTo(lastMessage) && !thread.contactListId" dense unelevated no-caps class="m-btn-tonal" icon="sym_o_reply_all"
                                    :label="t('Reply all')" @click="reply(lastMessage, true)"></q-btn>
                            <q-btn v-if="lastMessage.store === 'email'" dense unelevated no-caps class="m-btn-tonal" icon="sym_o_forward" :label="t('Forward')" @click="forward(lastMessage)"></q-btn>
                            <span v-if="thread.store === 'email' && !thread.canSend" class="text-caption m-muted self-center">{{t('You may read this account but not send from it')}}</span>
                            <span v-if="thread.contactListId && !thread.canReply && !thread.isClosed" class="text-caption m-muted self-center">{{t('Join the mailbox to reply')}}</span>
                        </div>
                    </div>
                    <div v-else-if="splitMode" class="column flex-center full-height m-muted q-pa-lg text-center">
                        <q-icon name="sym_o_mark_email_read" size="xl"></q-icon>
                        <div class="q-mt-sm">{{t('Choose a conversation to read it here')}}</div>
                        <div class="text-caption q-mt-xs">{{t('Press ? for the keyboard shortcuts')}}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    </div>

    <!-- the composer docks at the bottom right, several side by side -->
    <div v-if="docks.length" class="fixed-bottom-right row items-end no-wrap" :class="isPhone ? '' : 'q-pr-md'" style="z-index:3000;pointer-events:none">
        <div v-for="dock in docks" :key="dock.key" class="q-ml-sm" style="pointer-events:auto">
            <m-dynamic-container :id="'inbox-dock-' + dock.key" :url="composeUrl(dock)"></m-dynamic-container>
        </div>
    </div>

    <!-- the contact card -->
    <q-menu v-model="contact.open" :target="contact.target || false" no-parent-event anchor="bottom left" self="top left" @mouseenter="keepContact" @mouseleave="leaveContact">
        <div class="q-pa-md" style="width:300px;max-width:90vw">
            <div class="row no-wrap items-center q-gutter-x-sm">
                <m-avatar :name="contact.card ? (contact.card.name || contact.card.emailAddress) : contact.name" size="40px"></m-avatar>
                <div class="col" style="min-width:0">
                    <div class="text-subtitle2 ellipsis">{{(contact.card && contact.card.name) || contact.name || contact.address}}</div>
                    <div v-if="contact.card && contact.card.organizationName" class="text-caption m-muted ellipsis">{{contact.card.organizationName}}</div>
                    <div class="text-caption ellipsis">{{(contact.card && contact.card.emailAddress) || contact.address}}</div>
                    <div v-if="contact.card && contact.card.phone" class="text-caption ellipsis">{{contact.card.phone}}</div>
                </div>
            </div>
            <q-skeleton v-if="contact.loading" type="text" class="q-mt-sm"></q-skeleton>
            <template v-if="contact.card && contact.card.recentList.length">
                <div class="text-caption m-muted q-mt-sm">{{t('Recent')}}</div>
                <div v-for="recent in contact.card.recentList" :key="recent.threadKey" class="text-caption ellipsis cursor-pointer text-primary"
                        @click="contact.open = false; openView({view: 'all', thread: recent.threadKey})">{{recent.subject || t('(no subject)')}}</div>
            </template>
            <div class="row q-gutter-xs q-mt-sm">
                <q-btn v-if="contact.card && contact.card.url" dense unelevated no-caps class="m-btn-tonal" icon="sym_o_person" :label="t('Open contact')"
                        @click="contact.open = false; go(contact.card.url)"></q-btn>
                <q-btn v-else-if="contact.card && contact.address" dense unelevated no-caps class="m-btn-tonal" icon="sym_o_person_add" :label="t('Add to contacts')"
                        @click="addContact"></q-btn>
                <q-btn v-if="contact.address" dense flat no-caps color="primary" icon="sym_o_edit" :label="t('Write')" @click="contact.open = false; compose({to: contact.address})"></q-btn>
            </div>
        </div>
    </q-menu>

    <!-- the rail on a phone -->
    <m-dialog v-model="railDialog" :title="t('Folders')" width="320">
        <inbox-rail :inbox="self" :mini="false"></inbox-rail>
    </m-dialog>
    <!-- Save to Files: a copy of one attachment in the folder shown; the message keeps its own -->
    <m-dialog v-model="saveTo.open" :title="t('Save to Files')" width="640">
        <div class="text-caption q-mb-xs ellipsis">{{saveTo.file ? saveTo.file.name : ''}}</div>
        <div class="row items-center q-gutter-xs">
            <q-chip v-for="drive in saveTo.drives" :key="drive.driveId" dense square clickable :class="saveTo.driveId === drive.driveId ? 'm-tonal text-primary' : ''"
                    @click="saveFilesOpen(drive.driveId, '')">{{drive.driveName}}</q-chip>
        </div>
        <div class="row items-center no-wrap q-mt-xs" style="overflow:hidden">
            <template v-for="(crumb, index) in saveTo.crumbs" :key="index">
                <q-icon v-if="index" name="sym_o_chevron_right" size="16px" class="m-muted"></q-icon>
                <q-btn flat dense no-caps size="sm" @click="saveFilesOpen(saveTo.driveId, crumb.path)">{{crumb.name}}</q-btn>
            </template>
        </div>
        <q-list dense bordered separator class="q-mt-xs rounded-borders" style="max-height:320px;overflow:auto">
            <q-item v-if="saveTo.loading"><q-item-section class="text-center"><q-spinner></q-spinner></q-item-section></q-item>
            <q-item v-for="row in saveTo.rows" :key="row.path" :clickable="row.isDirectory" @click="row.isDirectory && saveFilesOpen(saveTo.driveId, row.path)">
                <q-item-section avatar style="min-width:30px"><q-icon :name="row.icon || (row.isDirectory ? 'sym_o_folder' : 'sym_o_draft')" size="20px"></q-icon></q-item-section>
                <q-item-section class="ellipsis">{{row.name}}</q-item-section>
                <q-item-section v-if="row.isDirectory" side><q-icon name="sym_o_chevron_right" size="18px"></q-icon></q-item-section>
            </q-item>
            <q-item v-if="!saveTo.loading && !saveTo.rows.length"><q-item-section class="text-caption m-muted">{{t('No files here')}}</q-item-section></q-item>
        </q-list>
        <div class="row items-center q-mt-md q-gutter-sm">
            <q-btn unelevated no-caps color="primary" icon="sym_o_drive_folder_upload" :label="t('Save here')" :disable="!saveTo.driveId" :loading="saveTo.saving" @click="saveFilesHere"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" @click="saveTo.open = false"></q-btn>
            <span class="text-caption m-muted">{{t('The message keeps its own copy')}}</span>
        </div>
    </m-dialog>

    <!-- Snooze: until when -->
    <m-dialog v-model="snooze.open" :title="t('Snooze until…')" width="380">
        <q-list dense>
            <q-item v-for="option in snoozeOptions" :key="option.key" clickable @click="applySnooze(option.at)">
                <q-item-section avatar><q-icon :name="option.icon"></q-icon></q-item-section>
                <q-item-section>{{option.label}}</q-item-section>
                <q-item-section side class="text-caption">{{shortWhen(option.at)}}</q-item-section>
            </q-item>
        </q-list>
        <q-separator class="q-my-sm"></q-separator>
        <div class="row items-end q-gutter-sm">
            <div class="col"><m-date-time v-model="snooze.custom" name="snoozeUntil" type="date-time" :label="t('Pick a date and time')"></m-date-time></div>
            <q-btn unelevated no-caps color="primary" :label="t('Snooze')" :disable="!snooze.custom" @click="applySnooze(parseDateTime(snooze.custom))"></q-btn>
        </div>
    </m-dialog>

    <!-- MoveTo: a folder of the accounts of the selection (mail only) -->
    <m-dialog v-model="move.open" :title="t('Move to…')" width="420">
        <m-text-line v-model="move.filter" name="moveFilter" :label="t('Find a folder')"></m-text-line>
        <q-list dense class="q-mt-sm">
            <template v-for="account in moveAccounts" :key="account.emailAccountId">
                <q-item-label header class="q-py-xs">{{account.accountName}}</q-item-label>
                <q-item v-for="folder in account.folders" :key="folder.emailFolderId" clickable @click="applyMove(folder)" :inset-level="folder.depth * 0.5">
                    <q-item-section avatar><q-icon :name="folder.icon"></q-icon></q-item-section><q-item-section>{{folder.folderName}}</q-item-section></q-item>
            </template>
        </q-list>
        <div v-if="moveAccounts.length === 1" class="row items-end q-gutter-sm q-mt-sm">
            <div class="col"><m-text-line v-model="move.newFolder" name="newFolder" :label="t('New folder')"></m-text-line></div>
            <q-btn dense unelevated no-caps class="m-btn-tonal" :label="t('Create and move')" :disable="!move.newFolder" @click="createFolderAndMove"></q-btn>
        </div>
    </m-dialog>

    <!-- Labels: the selection's mail accounts, and the Internal account when an internal thread is selected -->
    <m-dialog v-model="labels.open" :title="t('Labels')" width="380">
        <div v-if="!labelAccounts.length" class="m-muted">{{t('No account to label')}}</div>
        <template v-for="account in labelAccounts" :key="account.emailAccountId">
            <div v-if="labelAccounts.length > 1" class="text-caption m-muted q-mt-sm">{{account.accountName}}</div>
            <q-list dense>
                <q-item v-for="label in account.labelList" :key="label.emailLabelId" clickable @click="toggleLabelChoice(label)">
                    <q-item-section avatar><q-icon :name="labels.choice[label.emailLabelId] === true ? 'sym_o_check_box' : (labels.choice[label.emailLabelId] === false ? 'sym_o_check_box_outline_blank' : 'sym_o_indeterminate_check_box')"
                            :color="labels.choice[label.emailLabelId] === true ? 'primary' : undefined"></q-icon></q-item-section>
                    <q-item-section>{{label.labelName}}</q-item-section></q-item>
            </q-list>
            <div class="row items-end q-gutter-sm q-mt-xs">
                <div class="col"><m-text-line v-model="labels.newName[account.emailAccountId]" :name="'newLabel' + account.emailAccountId" :label="t('New label')"></m-text-line></div>
                <q-btn dense unelevated no-caps class="m-btn-tonal" :label="t('Create')" :disable="!labels.newName[account.emailAccountId]" @click="createLabel(account)"></q-btn>
            </div>
        </template>
        <div class="row q-mt-md q-gutter-sm"><q-btn unelevated no-caps color="primary" :label="t('Apply')" @click="applyLabels"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" @click="labels.open = false"></q-btn></div>
    </m-dialog>

    <!-- LinkToRecord -->
    <m-dialog v-model="link.open" :title="t('Link to a record')" width="520">
        <div class="text-caption m-muted q-mb-sm">{{t('File this message on a contact, order, request, task, event or project: it shows in that record\'s Chatter.')}}</div>
        <m-drop-down v-model="link.value" name="linkRecord" server-search :server-min-length="2" :options-url="url('searchRecords')" :label="t('Record by id or name')"></m-drop-down>
        <div v-if="link.message && link.message.linkList.length" class="q-mt-md">
            <div class="text-caption m-muted">{{t('Filed on')}}</div>
            <div class="row q-gutter-xs"><q-chip v-for="item in link.message.linkList" :key="item.recordEntityName + item.recordId" dense square removable class="m-tonal q-ml-none"
                    :icon="item.icon || 'sym_o_link'" @remove="unlinkRecord(link.message, item)">{{(item.typeLabel ? item.typeLabel + ' ' : '') + item.title}}</q-chip></div>
        </div>
        <div class="row q-mt-md q-gutter-sm"><q-btn unelevated no-caps color="primary" :label="t('Link')" :disable="!link.value" :loading="link.busy" @click="applyLink"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" @click="link.open = false"></q-btn></div>
    </m-dialog>

    <!-- Save search -->
    <m-dialog v-model="saveSearch.open" :title="t('Save search')" width="420">
        <m-text-line v-model="saveSearch.name" name="searchName" :label="t('Name')"></m-text-line>
        <div class="text-caption m-muted q-mt-xs">{{params.q}}</div>
        <div class="row q-mt-md q-gutter-sm"><q-btn unelevated no-caps color="primary" :label="t('Save')" :disable="!saveSearch.name" @click="applySaveSearch"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" @click="saveSearch.open = false"></q-btn></div>
    </m-dialog>

    <!-- Go to a folder, label or mailbox by name (g l) -->
    <m-dialog v-model="goto.open" :title="t('Go to')" width="420">
        <div @keydown.enter.prevent="gotoFirst"><m-text-line v-model="goto.filter" name="gotoFilter" :label="t('Folder, label or mailbox')"></m-text-line></div>
        <q-list dense class="q-mt-sm">
            <q-item v-for="target in gotoTargets" :key="target.key" clickable @click="goto.open = false; openView(target.params)">
                <q-item-section avatar><q-icon :name="target.icon"></q-icon></q-item-section><q-item-section>{{target.label}}</q-item-section>
                <q-item-section side class="text-caption">{{target.group}}</q-item-section></q-item>
        </q-list>
    </m-dialog>

    <!-- BrowseMailboxes -->
    <m-dialog v-model="browse.open" :title="t('Browse mailboxes')" width="620">
        <div @keydown.enter.prevent="loadMailboxes"><m-text-line v-model="browse.search" name="mailboxSearch" :label="t('Find a mailbox')"></m-text-line></div>
        <q-list separator class="q-mt-sm">
            <q-item v-for="list in browse.list" :key="list.contactListId">
                <q-item-section avatar><q-icon :name="list.isPublic === 'Y' ? 'sym_o_forum' : 'sym_o_lock'"></q-icon></q-item-section>
                <q-item-section>
                    <q-item-label>{{list.contactListName}}</q-item-label>
                    <q-item-label caption>{{[list.description, (list.memberCount || 0) + ' ' + t('members'), list.lastPostDate ? t('last post') + ' ' + shortDate(asMillis(list.lastPostDate)) : null].filter((part) => part).join(' · ')}}</q-item-label>
                </q-item-section>
                <q-item-section side>
                    <div class="row q-gutter-xs no-wrap">
                        <q-btn dense flat no-caps color="primary" :label="t('Open')" @click="browse.open = false; openView({mailbox: list.contactListId})"></q-btn>
                        <q-btn v-if="!list.isMember && list.membershipStatusId !== 'CLPT_PENDING' && list.canJoin" dense unelevated no-caps class="m-btn-tonal"
                                :label="list.isPublic === 'Y' ? t('Join') : t('Request')" @click="joinFromBrowse(list)"></q-btn>
                        <q-chip v-else-if="list.isMember" dense square class="m-tonal text-positive">{{t('Joined')}}</q-chip>
                        <q-chip v-else-if="list.membershipStatusId === 'CLPT_PENDING'" dense square class="m-tonal text-warning">{{t('Pending')}}</q-chip>
                    </div>
                </q-item-section>
            </q-item>
            <q-item v-if="!browse.list.length && !browse.loading"><q-item-section class="m-muted">{{t('No mailboxes match')}}</q-item-section></q-item>
        </q-list>
        <div class="row q-mt-md"><q-btn dense unelevated no-caps class="m-btn-tonal" icon="sym_o_add" :label="t('New mailbox')" @click="browse.open = false; openNewMailbox()"></q-btn></div>
    </m-dialog>

    <!-- NewMailbox -->
    <m-dialog v-model="newMailbox.open" :title="t('New mailbox')" width="560">
        <inbox-done v-if="newMailbox.open" :key="newMailbox.key" :done="afterNewMailbox">
            <m-form :action="action('mailboxCreate')" :fields-initial="newMailboxInitial" v-slot="formProps" @submitted="onMailboxCreated">
                <m-text-line v-model="formProps.fields.contactListName" name="contactListName" :label="t('Name')" required></m-text-line>
                <m-text-area v-model="formProps.fields.description" name="description" rows="2" :label="t('What it is for')" class="q-mt-xs"></m-text-area>
                <m-radio v-model="formProps.fields.isPublic" name="isPublic" :options="publicOptions" class="q-mt-xs"></m-radio>
                <div class="row q-col-gutter-xs q-mt-none">
                    <div class="col-12 col-sm-6"><m-drop-down v-model="formProps.fields.postingEnumId" name="postingEnumId" :options="postingOptions" :label="t('Who may post')"></m-drop-down></div>
                    <div class="col-12 col-sm-6"><m-drop-down v-model="formProps.fields.defaultDeliveryEnumId" name="defaultDeliveryEnumId" :options="deliveryOptions" :label="t('Posts go to')"></m-drop-down></div>
                </div>
                <m-drop-down v-model="formProps.fields.memberPartyIds" name="memberPartyIds" multiple server-search :options-url="url('searchUsers')" :label="t('Members')" class="q-mt-xs"></m-drop-down>
                <div class="row q-mt-md"><q-btn type="submit" unelevated no-caps color="primary" :label="t('Create mailbox')"></q-btn></div>
            </m-form>
        </inbox-done>
    </m-dialog>

    <!-- MailboxSettings and MailboxMembers -->
    <m-dialog v-model="mailboxDialog.open" :title="mailbox ? mailbox.contactListName : t('Mailbox')" width="620">
        <template v-if="mailbox">
            <q-tabs v-model="mailboxDialog.tab" dense no-caps align="left" active-color="primary" indicator-color="primary">
                <q-tab name="members" :label="t('Members')"></q-tab>
                <q-tab v-if="mailbox.isOwner" name="settings" :label="t('Settings')"></q-tab>
            </q-tabs>
            <q-separator class="q-mb-sm"></q-separator>
            <div v-if="mailboxDialog.tab === 'members'">
                <template v-if="mailbox.pendingList.length && mailbox.canModerate">
                    <div class="text-subtitle2">{{t('Asking to join')}}</div>
                    <q-list dense>
                        <q-item v-for="member in mailbox.pendingList" :key="member.partyId">
                            <q-item-section avatar><m-avatar :name="member.name" size="28px"></m-avatar></q-item-section>
                            <q-item-section>{{member.name}}</q-item-section>
                            <q-item-section side><div class="row no-wrap q-gutter-xs">
                                <q-btn dense unelevated no-caps class="m-btn-tonal text-positive" :label="t('Accept')" @click="mailboxAccept(member)"></q-btn>
                                <q-btn dense flat no-caps color="negative" :label="t('Decline')" @click="mailboxDecline(member)"></q-btn></div></q-item-section>
                        </q-item>
                    </q-list>
                    <q-separator class="q-my-sm"></q-separator>
                </template>
                <q-list dense>
                    <q-item v-for="member in mailbox.memberList" :key="member.partyId">
                        <q-item-section avatar><m-avatar :name="member.name" size="28px"></m-avatar></q-item-section>
                        <q-item-section><q-item-label>{{member.name}}</q-item-label>
                            <q-item-label caption>{{[roleLabel(member.roleTypeId), member.deliveryEnumId === 'CldMailboxOnly' ? t('Mailbox only') : t('In Inbox')].join(' · ')}}</q-item-label></q-item-section>
                        <q-item-section v-if="mailbox.canModerate && member.partyId !== data.me.partyId" side>
                            <div class="row no-wrap">
                                <q-btn v-if="mailbox.isOwner" flat round dense size="sm" icon="sym_o_manage_accounts" :aria-label="t('Role')"><q-tooltip>{{t('Role')}}</q-tooltip>
                                    <q-menu><q-list dense>
                                        <q-item v-for="role in roleOptions" :key="role.value" clickable v-close-popup @click="mailboxSetRole(member, role.value)"><q-item-section>{{role.label}}</q-item-section></q-item>
                                    </q-list></q-menu></q-btn>
                                <q-btn flat round dense size="sm" icon="sym_o_person_remove" :aria-label="t('Remove')" @click="mailboxRemove(member)"><q-tooltip>{{t('Remove')}}</q-tooltip></q-btn>
                            </div>
                        </q-item-section>
                    </q-item>
                </q-list>
                <div v-if="mailbox.canModerate && !mailbox.isArchived" class="row items-end q-gutter-sm q-mt-sm">
                    <div class="col"><m-drop-down v-model="mailboxDialog.addPartyId" name="addMember" server-search :options-url="url('searchUsers')" :label="t('Add a member')"></m-drop-down></div>
                    <q-btn dense unelevated no-caps class="m-btn-tonal" :label="t('Add')" :disable="!mailboxDialog.addPartyId" @click="mailboxAddMember"></q-btn>
                </div>
            </div>
            <div v-else-if="mailboxDialog.tab === 'settings'">
                <inbox-done :key="mailboxDialog.key" :done="afterMailboxSettings">
                    <m-form :action="action('mailboxUpdate')" :fields-initial="mailboxSettingsInitial" v-slot="formProps">
                        <m-text-line v-model="formProps.fields.contactListName" name="contactListName" :label="t('Name')"></m-text-line>
                        <m-text-area v-model="formProps.fields.description" name="description" rows="2" :label="t('What it is for')" class="q-mt-xs"></m-text-area>
                        <m-radio v-model="formProps.fields.isPublic" name="isPublic" :options="publicOptions" class="q-mt-xs"></m-radio>
                        <div class="row q-col-gutter-xs q-mt-none">
                            <div class="col-12 col-sm-6"><m-drop-down v-model="formProps.fields.postingEnumId" name="postingEnumId" :options="postingOptions" :label="t('Who may post')"></m-drop-down></div>
                            <div class="col-12 col-sm-6"><m-drop-down v-model="formProps.fields.defaultDeliveryEnumId" name="defaultDeliveryEnumId" :options="deliveryOptions" :label="t('Posts go to')"></m-drop-down></div>
                        </div>
                        <m-radio v-model="formProps.fields.archived" name="archived" :options="archiveOptions" class="q-mt-xs"></m-radio>
                        <div class="row q-mt-md"><q-btn type="submit" unelevated no-caps color="primary" :label="t('Save')"></q-btn></div>
                    </m-form>
                </inbox-done>
            </div>
        </template>
    </m-dialog>
</div></template>

<script>
const DAY = 86400000;
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const pad = (n) => String(n).padStart(2, '0');
// the rail: views, the mail accounts with their folders and labels, the Internal account with its mailboxes, saved searches
const railTemplate = '' +
    '<div class="q-py-xs">' +
        '<div class="q-px-sm q-pb-sm" :class="mini ? \'text-center\' : \'\'">' +
            '<q-btn v-if="!mini" unelevated no-caps color="primary" icon="sym_o_edit" :label="t(\'Compose\')" class="full-width" @click="inbox.compose()"></q-btn>' +
            '<q-btn v-else unelevated round dense color="primary" icon="sym_o_edit" :aria-label="t(\'Compose\')" @click="inbox.compose()"><q-tooltip>{{t(\'Compose\')}} (c)</q-tooltip></q-btn>' +
        '</div>' +
        '<q-list dense>' +
            '<q-item v-for="item in inbox.viewItems" :key="item.key" clickable dense :active="inbox.isActiveView(item.params)" active-class="text-primary text-weight-medium" ' +
                    '@click="inbox.openView(item.params)">' +
                '<q-item-section avatar class="relative-position" style="min-width:30px"><q-icon :name="item.icon" size="20px"></q-icon>' +
                    '<q-badge v-if="mini && item.count" floating rounded :color="item.error ? \'negative\' : \'primary\'">{{item.count}}</q-badge></q-item-section>' +
                '<q-item-section v-if="!mini" class="ellipsis">{{item.label}}</q-item-section>' +
                '<q-item-section v-if="!mini && item.count" side><span class="text-caption" :class="item.error ? \'text-negative text-weight-bold\' : \'text-weight-bold\'">{{item.count}}</span></q-item-section>' +
                '<q-tooltip v-if="mini" anchor="center right" self="center left">{{item.label}}</q-tooltip>' +
            '</q-item>' +
            '<template v-if="!mini">' +
                '<template v-for="account in inbox.mailAccounts" :key="account.emailAccountId">' +
                    '<q-separator spaced></q-separator>' +
                    '<q-item dense clickable @click="inbox.toggleAccount(account)">' +
                        '<q-item-section class="text-caption text-weight-medium ellipsis">{{account.accountName}}' +
                            '<div v-if="account.accountName !== account.emailAddress" class="text-caption m-muted ellipsis">{{account.emailAddress}}</div>' +
                            '<div v-if="account.storageText" class="text-caption m-muted ellipsis">{{t(\'Storage\')}} · {{account.storageText}}</div></q-item-section>' +
                        '<q-item-section side class="row no-wrap items-center">' +
                            '<q-spinner v-if="account.syncing" size="14px" color="info"><q-tooltip>{{t(\'Syncing…\')}}</q-tooltip></q-spinner>' +
                            '<q-btn v-if="account.warning" dense flat no-caps size="sm" color="warning" icon="sym_o_warning" :label="t(\'Fix\')" @click.stop="inbox.go(inbox.fixUrl(account))">' +
                                '<q-tooltip>{{account.warning === \'authFailed\' ? t(\'The sign-in failed\') : (account.lastSyncError || t(\'The last sync failed\'))}}</q-tooltip></q-btn>' +
                            '<q-icon :name="inbox.collapsedAccounts[account.emailAccountId] ? \'sym_o_expand_more\' : \'sym_o_expand_less\'" size="18px"></q-icon>' +
                        '</q-item-section>' +
                    '</q-item>' +
                    '<template v-if="!inbox.collapsedAccounts[account.emailAccountId]">' +
                        '<q-item v-for="folder in account.folderList" :key="folder.emailFolderId" clickable dense :inset-level="folder.depth * 0.3" ' +
                                ':active="inbox.isActiveView({account: account.emailAccountId, folder: folder.emailFolderId})" active-class="text-primary text-weight-medium" ' +
                                '@click="inbox.openView({account: account.emailAccountId, folder: folder.emailFolderId})">' +
                            '<q-item-section avatar style="min-width:30px"><q-icon :name="folder.icon" size="18px"></q-icon></q-item-section>' +
                            '<q-item-section class="ellipsis">{{folder.folderName}}</q-item-section>' +
                            '<q-item-section v-if="folder.unreadCount && folder.folderKindEnumId !== \'EfkTrash\' && folder.folderKindEnumId !== \'EfkJunk\'" side>' +
                                '<span class="text-caption text-weight-bold">{{folder.unreadCount}}</span></q-item-section>' +
                        '</q-item>' +
                        '<q-item v-for="label in account.labelList" :key="label.emailLabelId" clickable dense ' +
                                ':active="inbox.isActiveView({account: account.emailAccountId, label: label.emailLabelId})" active-class="text-primary text-weight-medium" ' +
                                '@click="inbox.openView({account: account.emailAccountId, label: label.emailLabelId})">' +
                            '<q-item-section avatar style="min-width:30px"><q-icon name="sym_o_label" size="18px" :color="label.color || undefined"></q-icon></q-item-section>' +
                            '<q-item-section class="ellipsis">{{label.labelName}}</q-item-section>' +
                        '</q-item>' +
                    '</template>' +
                '</template>' +
                '<q-separator spaced></q-separator>' +
                '<q-item-label header class="q-py-xs text-caption text-weight-medium">{{t(\'Internal messages\')}}</q-item-label>' +
                '<q-item v-for="item in inbox.internalItems" :key="item.key" clickable dense :active="inbox.isActiveView(item.params)" active-class="text-primary text-weight-medium" ' +
                        '@click="inbox.openView(item.params)">' +
                    '<q-item-section avatar style="min-width:30px"><q-icon :name="item.icon" size="18px"></q-icon></q-item-section>' +
                    '<q-item-section class="ellipsis">{{item.label}}</q-item-section>' +
                    '<q-item-section v-if="item.count" side><span class="text-caption text-weight-bold">{{item.count}}</span></q-item-section>' +
                '</q-item>' +
                '<q-item v-for="label in (inbox.internalAccount ? inbox.internalAccount.labelList : [])" :key="label.emailLabelId" clickable dense ' +
                        ':active="inbox.isActiveView({account: inbox.internalAccount.emailAccountId, label: label.emailLabelId})" active-class="text-primary text-weight-medium" ' +
                        '@click="inbox.openView({account: inbox.internalAccount.emailAccountId, label: label.emailLabelId})">' +
                    '<q-item-section avatar style="min-width:30px"><q-icon name="sym_o_label" size="18px" :color="label.color || undefined"></q-icon></q-item-section>' +
                    '<q-item-section class="ellipsis">{{label.labelName}}</q-item-section>' +
                '</q-item>' +
                '<q-item-label header class="q-py-xs text-caption text-weight-medium">{{t(\'Mailboxes\')}}</q-item-label>' +
                '<q-item v-for="box in inbox.data.mailboxList" :key="box.contactListId" clickable dense :active="inbox.isActiveView({mailbox: box.contactListId})" ' +
                        'active-class="text-primary text-weight-medium" @click="inbox.openView({mailbox: box.contactListId})">' +
                    '<q-item-section avatar style="min-width:30px"><q-icon :name="box.membershipStatusId === \'CLPT_PENDING\' ? \'sym_o_hourglass_empty\' : \'sym_o_forum\'" size="18px"></q-icon></q-item-section>' +
                    '<q-item-section class="ellipsis">{{box.contactListName}}</q-item-section>' +
                    '<q-item-section v-if="box.membershipStatusId === \'CLPT_PENDING\'" side><span class="text-caption text-warning">{{t(\'Pending\')}}</span></q-item-section>' +
                    '<q-item-section v-else-if="box.unreadCount" side><span class="text-caption text-weight-bold">{{box.unreadCount}}</span></q-item-section>' +
                '</q-item>' +
                '<q-item clickable dense @click="inbox.openBrowse()"><q-item-section avatar style="min-width:30px"><q-icon name="sym_o_travel_explore" size="18px"></q-icon></q-item-section>' +
                    '<q-item-section class="text-primary">{{t(\'Browse mailboxes\')}}</q-item-section></q-item>' +
                '<q-item clickable dense @click="inbox.openNewMailbox()"><q-item-section avatar style="min-width:30px"><q-icon name="sym_o_add" size="18px"></q-icon></q-item-section>' +
                    '<q-item-section class="text-primary">{{t(\'New mailbox\')}}</q-item-section></q-item>' +
                '<template v-if="inbox.data.searchList.length">' +
                    '<q-separator spaced></q-separator>' +
                    '<q-item-label header class="q-py-xs text-caption text-weight-medium">{{t(\'Saved searches\')}}</q-item-label>' +
                    '<q-item v-for="search in inbox.data.searchList" :key="search.emailSearchId" clickable dense :active="inbox.params.q === search.queryText" ' +
                            'active-class="text-primary text-weight-medium" @click="inbox.openView({q: search.queryText})">' +
                        '<q-item-section avatar style="min-width:30px"><q-icon name="sym_o_saved_search" size="18px"></q-icon></q-item-section>' +
                        '<q-item-section class="ellipsis">{{search.searchName}}</q-item-section>' +
                        '<q-item-section side><q-btn flat round dense size="xs" icon="sym_o_close" :aria-label="t(\'Delete\')" @click.stop="inbox.deleteSearch(search)"></q-btn></q-item-section>' +
                    '</q-item>' +
                '</template>' +
                '<q-separator spaced></q-separator>' +
                '<q-item clickable dense @click="inbox.go(\'/qapps/Comms/Settings/MailAccounts\')"><q-item-section avatar style="min-width:30px"><q-icon name="sym_o_settings" size="18px"></q-icon></q-item-section>' +
                    '<q-item-section class="m-muted">{{t(\'Mail accounts\')}}</q-item-section></q-item>' +
            '</template>' +
        '</q-list>' +
    '</div>';

module.exports = {
    name: 'BossInbox',
    components: {
        // a form's scope: m-form calls mSubmitHide.hide() after an answer without errors (webroot js/README.md)
        'inbox-done': {
            props: { done: Function },
            provide() { return { mSubmitHide: { hide: () => { if (this.done) this.done(); } } }; },
            template: '<div><slot></slot></div>'
        },
        'inbox-rail': { props: { inbox: Object, mini: Boolean }, methods: { t }, template: railTemplate }
    },
    // the composer docks talk to the Inbox through this (Compose.qvue injects it)
    provide() {
        const self = this;
        return {
            mComposeHost: {
                get: (key) => self.docks.find((dock) => dock.key === key) || null,
                close: (key) => self.closeDock(key),
                minimize: (key, flag) => self.minimizeDock(key, flag),
                popOut: (key, flag) => self.popOutDock(key, flag),
                retitle: (key, title) => { const dock = self.docks.find((item) => item.key === key); if (dock) dock.title = title; },
                draftSaved: (key, emailMessageId) => {
                    const dock = self.docks.find((item) => item.key === key);
                    if (dock && emailMessageId && dock.query.emailMessageId !== emailMessageId) { dock.query = { emailMessageId }; self.saveDocks(); }
                },
                sent: (key, info) => self.onComposeSent(key, info)
            }
        };
    },
    data() {
        return {
            loaded: false, height: 600, data: { accountList: [], mailboxList: [], searchList: [], totals: {}, me: {}, prefs: {} },
            threads: [], hasMore: false, nextCursor: null, loadingList: false, listError: null, storeList: [], failedStores: [], termList: [], listSeq: 0,
            loadedViewKey: null, selected: {}, allInView: false, lastCheckedIndex: null, hoverKey: null, focusKey: null, shiftDown: false,
            openKey: null, thread: null, loadingThread: false, threadSeq: 0, expanded: {}, showOlder: false, details: {}, focusMessageKey: null,
            trustOffer: null, searchInput: '', advancedOpen: false, advanced: { from: '', to: '', subject: '', words: '', without: '', within: null, where: null, flags: [] },
            railCollapsed: false, railDialog: false, collapsedAccounts: {}, pane: 'right', splitRight: 42, splitBottom: 45, drag: null,
            mailbox: null, docks: [], dockCount: 0, syncBusy: false, syncPolls: 0, showSetupCard: true, undoStack: [],
            contact: { open: false, target: null, address: null, name: null, partyId: null, card: null, loading: false },
            snooze: { open: false, targets: [], custom: '' }, move: { open: false, targets: [], filter: '', newFolder: '' },
            labels: { open: false, targets: [], choice: {}, original: {}, newName: {} }, link: { open: false, message: null, value: null, busy: false },
            saveSearch: { open: false, name: '' }, goto: { open: false, filter: '' }, browse: { open: false, search: '', list: [], loading: false },
            saveTo: { open: false, file: null, message: null, drives: [], driveId: null, path: '', crumbs: [], rows: [], loading: false, saving: false },
            swipe: null, swipeSuppress: null,
            newMailbox: { open: false, key: 0 }, mailboxDialog: { open: false, tab: 'members', key: 0, addPartyId: null }, pendingCreateFrom: false, markReadTimer: null
        };
    },
    computed: {
        self() { return this; },
        isPhone() { return this.$q.screen.lt.sm; },
        isTouch() { return !!(this.$q.platform && this.$q.platform.has && this.$q.platform.has.touch) && this.$q.screen.lt.md; },
        params() { return this.$root.currentParameters || {}; },
        view() { return this.params.view || (this.params.folder ? 'folder' : (this.params.label ? 'label' : (this.params.mailbox ? 'mailbox' : 'inbox'))); },
        viewKey() {
            const p = this.params;
            return [p.view || '', p.account || '', p.folder || '', p.label || '', p.mailbox || '', p.q || '', p.unread || ''].join('|');
        },
        unreadOnly() { return this.params.unread === 'Y'; },
        me() { return this.data.me || {}; },
        myAddresses() { return new Set((this.me.addressList || []).map((address) => String(address).toLowerCase())); },
        mailAccounts() { return (this.data.accountList || []).filter((account) => !account.isInternal); },
        internalAccount() { return (this.data.accountList || []).find((account) => account.isInternal) || null; },
        warnedAccounts() { return this.mailAccounts.filter((account) => account.warning && account.warning !== 'paused'); },
        syncingAny() { return this.mailAccounts.some((account) => account.syncing); },
        totals() { return this.data.totals || {}; },
        viewItems() {
            const totals = this.totals;
            const hasMail = this.mailAccounts.length > 0;
            const items = [{ key: 'inbox', label: hasMail ? t('Unified inbox') : t('Inbox'), icon: 'sym_o_inbox', params: { view: 'inbox' }, count: totals.unifiedUnreadCount || 0 },
                { key: 'flagged', label: t('Flagged'), icon: 'sym_o_star', params: { view: 'flagged' } },
                { key: 'snoozed', label: t('Snoozed'), icon: 'sym_o_snooze', params: { view: 'snoozed' } }];
            if (hasMail) items.push({ key: 'scheduled', label: t('Scheduled'), icon: 'sym_o_schedule_send', params: { view: 'scheduled' } },
                { key: 'drafts', label: t('Drafts'), icon: 'sym_o_draft', params: { view: 'drafts' }, count: totals.draftCount || 0 });
            items.push({ key: 'sent', label: t('Sent'), icon: 'sym_o_send', params: { view: 'sent' } },
                { key: 'archive', label: t('Archive'), icon: 'sym_o_archive', params: { view: 'archive' } });
            if (hasMail) items.push({ key: 'junk', label: t('Spam'), icon: 'sym_o_report', params: { view: 'junk' } },
                { key: 'trash', label: t('Trash'), icon: 'sym_o_delete', params: { view: 'trash' } },
                { key: 'outbox', label: t('Outbox'), icon: 'sym_o_outbox', params: { view: 'outbox' }, count: totals.outboxCount || 0, error: (totals.outboxErrorCount || 0) > 0 });
            items.push({ key: 'all', label: t('All mail'), icon: 'sym_o_all_inbox', params: { view: 'all' } });
            return items;
        },
        internalItems() {
            return [{ key: 'internal', label: t('Received'), icon: 'sym_o_move_to_inbox', params: { view: 'internal' }, count: this.totals.internalUnreadCount || 0 },
                { key: 'internalSent', label: t('Sent'), icon: 'sym_o_send', params: { view: 'internalSent' } },
                { key: 'comments', label: t('Comments on my records'), icon: 'sym_o_comment', params: { view: 'comments' } },
                { key: 'internalArchive', label: t('Archive'), icon: 'sym_o_archive', params: { view: 'internalArchive' } }];
        },
        viewTitle() {
            const p = this.params;
            if (p.q) return t('Search results');
            if (p.mailbox) return (this.mailbox && this.mailbox.contactListName) || t('Mailbox');
            const account = p.account ? (this.mailAccounts.find((item) => item.emailAccountId === p.account) ||
                (this.internalAccount && this.internalAccount.emailAccountId === p.account ? this.internalAccount : null)) : null;
            if (account && p.folder) { const folder = account.folderList.find((item) => item.emailFolderId === p.folder); return folder ? folder.folderName + ' · ' + account.accountName : t('Folder'); }
            if (account && p.label) { const label = account.labelList.find((item) => item.emailLabelId === p.label); return label ? label.labelName : t('Label'); }
            const item = this.viewItems.concat(this.internalItems).find((entry) => entry.params.view === (p.view || 'inbox'));
            const title = item ? item.label : t('Inbox');
            return ['internal', 'internalSent', 'internalArchive'].includes(p.view) ? t('Internal messages') + ' · ' + title : (account ? account.accountName + ' · ' + title : title);
        },
        emptyText() {
            const texts = { inbox: t('Your Inbox is empty'), flagged: t('Nothing flagged'), snoozed: t('Nothing snoozed'), scheduled: t('Nothing scheduled'),
                drafts: t('No drafts'), sent: t('Nothing sent yet'), outbox: t('The Outbox is empty'), junk: t('No spam'), trash: t('The Trash is empty'),
                internal: t('No internal messages'), comments: t('No comments on your records') };
            return this.unreadOnly ? t('No unread conversations') : (texts[this.params.view || 'inbox'] || t('No conversations here'));
        },
        termChips() {
            return (this.termList || []).map((term) => ({ term, label: (term.negate ? '-' : '') + term.operator + ':' + term.value }));
        },
        freeText() {
            return String(this.params.q || '').replace(/-?[a-z_]+:("[^"]*"|\([^)]*\)|\S+)/gi, ' ').replace(/\s+/g, ' ').trim();
        },
        groups() {
            const now = new Date();
            const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
            const startWeek = startToday - 6 * DAY;
            const startMonth = new Date(now.getFullYear(), now.getMonth(), 1).getTime();
            const out = [];
            let current = null;
            this.threads.forEach((row) => {
                const at = Number(row.sortDate) || 0;
                let key, label;
                if (at >= startToday) { key = 'today'; label = t('Today'); }
                else if (at >= startToday - DAY) { key = 'yesterday'; label = t('Yesterday'); }
                else if (at >= startWeek) { key = 'week'; label = t('This week'); }
                else if (at >= startMonth) { key = 'month'; label = t('Earlier this month'); }
                else { const d = new Date(at); key = 'm' + d.getFullYear() + '-' + d.getMonth(); label = d.toLocaleDateString(undefined, { month: 'long', year: 'numeric' }); }
                if (!current || current.key !== key) { current = { key, label, rows: [] }; out.push(current); }
                current.rows.push(row);
            });
            return out;
        },
        selectedKeys() { return Object.keys(this.selected); },
        allLoadedSelected() { return this.threads.length > 0 && this.threads.every((row) => this.selected[row.rowKey]); },
        headerCheck() { return this.selectedKeys.length === 0 ? false : (this.allLoadedSelected ? true : null); },
        selectionRows() { return this.threads.filter((row) => this.selected[row.rowKey]); },
        selectionHasEmail() { return this.allInView ? this.storeList.includes('email') : this.selectionRows.some((row) => row.store === 'email'); },
        selectionCanLabel() {
            const internal = this.allInView ? this.storeList.includes('internal') : this.selectionRows.some((row) => row.store === 'internal');
            return this.selectionHasEmail || internal;
        },
        activeClass() { return this.$q.dark.isActive ? 'bg-grey-9 text-white' : 'bg-blue-1 text-dark'; },
        selectedClass() { return this.$q.dark.isActive ? 'bg-grey-10' : 'bg-blue-grey-1'; },
        splitMode() { return this.pane !== 'off' && !this.isPhone && (this.pane === 'bottom' || this.$q.screen.gt.sm); },
        showList() { return this.splitMode || !this.openKey; },
        showPane() { return this.splitMode || !!this.openKey; },
        listStyle() {
            if (!this.splitMode) return { flex: '1 1 auto', minWidth: 0, minHeight: 0 };
            return this.pane === 'bottom' ? { height: this.splitBottom + '%', minHeight: '140px', minWidth: 0 } : { width: this.splitRight + '%', minWidth: '300px', minHeight: 0 };
        },
        paneStyle() { return this.splitMode ? { flex: '1 1 0', minWidth: 0, minHeight: 0 } : { minHeight: 0 }; },
        gutterStyle() { return this.pane === 'bottom' ? { height: '6px', cursor: 'row-resize' } : { width: '6px', cursor: 'col-resize' }; },
        paneIcon() { return this.pane === 'bottom' ? 'sym_o_splitscreen' : (this.pane === 'off' ? 'sym_o_view_agenda' : 'sym_o_vertical_split'); },
        paneOptions() {
            return [{ value: 'right', label: t('Reading pane at the right'), icon: 'sym_o_vertical_split' }, { value: 'bottom', label: t('Reading pane below'), icon: 'sym_o_splitscreen' },
                { value: 'off', label: t('No reading pane'), icon: 'sym_o_view_agenda' }];
        },
        lastMessage() { return this.thread && this.thread.messageList.length ? this.thread.messageList[this.thread.messageList.length - 1] : null; },
        threadInTrash() { return this.thread && this.thread.folderKindEnumId === 'EfkTrash'; },
        threadFolderLabel() {
            if (!this.thread || this.thread.store !== 'email' || !this.thread.folderKindEnumId || this.thread.folderKindEnumId === 'EfkInbox') return null;
            return { EfkSent: t('Sent'), EfkDrafts: t('Drafts'), EfkArchive: t('Archive'), EfkJunk: t('Spam'), EfkTrash: t('Trash'), EfkOther: null }[this.thread.folderKindEnumId] || null;
        },
        // the messages as the pane shows them: a run of older read ones folds into one line until "older messages"
        messageItems() {
            if (!this.thread) return [];
            const list = this.thread.messageList;
            const items = list.map((message) => ({ kind: 'message', key: message.key, message }));
            if (this.showOlder || list.length <= 4) return items;
            const middle = [];
            for (let i = 1; i < list.length - 2; i++) if (!this.expanded[list[i].key]) middle.push(i);
            const contiguous = middle.length >= 3 && middle[middle.length - 1] - middle[0] === middle.length - 1;
            if (!contiguous) return items;
            return items.slice(0, middle[0]).concat([{ kind: 'older', key: 'older', count: middle.length }]).concat(items.slice(middle[middle.length - 1] + 1));
        },
        memberCountText() {
            const count = this.mailbox ? (this.mailbox.memberCount ?? this.mailbox.memberList.length) : 0;
            return count === 1 ? t('1 member') : count + ' ' + t('members');
        },
        snoozeOptions() {
            const now = new Date();
            const at = (days, hour) => { const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + days, hour, 0, 0); return d.getTime(); };
            const options = [];
            if (now.getHours() < 17) options.push({ key: 'later', label: t('Later today'), icon: 'sym_o_schedule', at: Math.max(at(0, 18), now.getTime() + 3 * 3600000) });
            options.push({ key: 'tomorrow', label: t('Tomorrow'), icon: 'sym_o_wb_sunny', at: at(1, 8) });
            const toSaturday = (6 - now.getDay() + 7) % 7 || 7;
            options.push({ key: 'weekend', label: t('This weekend'), icon: 'sym_o_weekend', at: at(toSaturday, 8) });
            const toMonday = (8 - now.getDay()) % 7 || 7;
            options.push({ key: 'week', label: t('Next week'), icon: 'sym_o_next_week', at: at(toMonday, 8) });
            return options;
        },
        moveAccounts() {
            const ids = new Set(this.snoozeOrMoveRows(this.move.targets).filter((row) => row.store === 'email').map((row) => row.emailAccountId));
            const filter = String(this.move.filter || '').toLowerCase();
            return this.mailAccounts.filter((account) => ids.has(account.emailAccountId)).map((account) => ({ emailAccountId: account.emailAccountId,
                accountName: account.accountName, folders: account.folderList.filter((folder) => folder.folderKindEnumId !== 'EfkDrafts' &&
                    (!filter || String(folder.folderName).toLowerCase().includes(filter))) }));
        },
        accountsWithLabels() { return this.mailAccounts.concat(this.internalAccount ? [this.internalAccount] : []); },
        labelAccounts() {
            const internal = this.internalAccount;
            const ids = new Set();
            this.snoozeOrMoveRows(this.labels.targets).forEach((row) => {
                if (row.store === 'email' && row.emailAccountId) ids.add(row.emailAccountId);
                if (row.store === 'internal' && internal) ids.add(internal.emailAccountId);
            });
            return this.accountsWithLabels.filter((account) => ids.has(account.emailAccountId));
        },
        gotoTargets() {
            const filter = String(this.goto.filter || '').toLowerCase();
            const targets = [];
            this.viewItems.concat(this.internalItems).forEach((item) => targets.push({ key: 'v' + item.key, label: item.label, icon: item.icon, params: item.params, group: t('Views') }));
            this.accountsWithLabels.forEach((account) => {
                account.folderList.forEach((folder) => targets.push({ key: 'f' + folder.emailFolderId, label: folder.folderName, icon: folder.icon,
                    params: { account: account.emailAccountId, folder: folder.emailFolderId }, group: account.accountName }));
                account.labelList.forEach((label) => targets.push({ key: 'l' + label.emailLabelId, label: label.labelName, icon: 'sym_o_label',
                    params: { account: account.emailAccountId, label: label.emailLabelId }, group: account.accountName }));
            });
            (this.data.mailboxList || []).forEach((box) => targets.push({ key: 'm' + box.contactListId, label: box.contactListName, icon: 'sym_o_forum',
                params: { mailbox: box.contactListId }, group: t('Mailboxes') }));
            return targets.filter((target) => !filter || target.label.toLowerCase().includes(filter)).slice(0, 30);
        },
        newMailboxInitial() { return { contactListName: '', description: '', isPublic: 'Y', postingEnumId: 'ClpMembers', defaultDeliveryEnumId: 'CldInbox', memberPartyIds: [] }; },
        mailboxSettingsInitial() {
            const box = this.mailbox || {};
            return { contactListId: box.contactListId, contactListName: box.contactListName || '', description: box.description || '', isPublic: box.isPublic ? 'Y' : 'N',
                postingEnumId: box.postingEnumId || 'ClpMembers', defaultDeliveryEnumId: box.defaultDeliveryEnumId || 'CldInbox', archived: box.isArchived ? 'true' : 'false' };
        },
        publicOptions() { return [{ value: 'Y', label: t('Public: anyone here may read and join') }, { value: 'N', label: t('Private: members only') }]; },
        postingOptions() { return [{ value: 'ClpMembers', label: t('Members') }, { value: 'ClpModerators', label: t('Owners and moderators') }, { value: 'ClpAnyUser', label: t('Anyone here (a help mailbox)') }]; },
        deliveryOptions() { return [{ value: 'CldInbox', label: t('Members\' Inboxes') }, { value: 'CldMailboxOnly', label: t('The mailbox only') }]; },
        archiveOptions() { return [{ value: 'false', label: t('Active') }, { value: 'true', label: t('Archived: read-only') }]; },
        roleOptions() { return [{ value: '', label: t('Member') }, { value: 'ListModerator', label: t('Moderator') }, { value: 'ListOwner', label: t('Owner') }]; },
        withinOptions() {
            return [{ value: '1d', label: t('1 day') }, { value: '3d', label: t('3 days') }, { value: '1w', label: t('1 week') }, { value: '2w', label: t('2 weeks') },
                { value: '1m', label: t('1 month') }, { value: '6m', label: t('6 months') }, { value: '1y', label: t('1 year') }];
        },
        whereOptions() {
            return [{ value: 'inbox', label: t('Inbox') }, { value: 'sent', label: t('Sent') }, { value: 'drafts', label: t('Drafts') }, { value: 'archive', label: t('Archive') },
                { value: 'spam', label: t('Spam') }, { value: 'trash', label: t('Trash') }, { value: 'anywhere', label: t('Anywhere') }];
        },
        advancedFlagOptions() { return [{ value: 'attachment', label: t('Has attachment') }, { value: 'unread', label: t('Unread') }, { value: 'flagged', label: t('Flagged') }]; },
        invitationAnswers() {
            return [{ value: 'accept', label: t('Yes'), icon: 'sym_o_check', status: 'accepted' }, { value: 'tentative', label: t('Maybe'), icon: 'sym_o_help', status: 'tentative' },
                { value: 'decline', label: t('No'), icon: 'sym_o_close', status: 'declined' }];
        }
    },
    watch: {
        // a view change reloads the list, a thread change opens the thread; the screen is not remounted for either
        '$root.currentParameters': { handler() { if (this.isCurrent()) this.applyParams(); }, deep: true },
        '$root.shellCounts': { handler() { this.onCounts(); }, deep: true },
        '$root.quickCreateShow'(shown) { if (!shown && this.pendingCreateFrom) { this.pendingCreateFrom = false; this.reloadThread(); } },
        pane() { this.$nextTick(() => this.measure()); }
    },
    methods: {
        t,
        // ---- paths ----
        inboxPath() {
            const list = this.$root.currentPathList || [];
            const at = list.indexOf('Inbox');
            return at >= 0 ? list.slice(0, at + 1).join('/') : 'Comms/Inbox';
        },
        url(name) { return this.$root.basePath + '/' + this.inboxPath() + '/Mail/' + name; },
        action(name) {
            const rootPath = this.$root.appRootPath || '';
            const path = this.url(name);
            return rootPath && path.indexOf(rootPath) === 0 ? path.slice(rootPath.length) : path;
        },
        linkPath() {
            const list = this.$root.currentPathList || [];
            return list[list.length - 1] === 'Mail' ? this.$root.currentLinkPath : this.$root.linkBasePath + '/' + this.inboxPath();
        },
        go(target) { if (target) this.$root.setUrl(target); },
        // a sign-in that failed: the account's page asks for the password again; another warning: its page
        fixUrl(account) {
            return '/qapps/Comms/Settings/MailAccounts/Account?emailAccountId=' + encodeURIComponent(account.emailAccountId) + (account.warning === 'authFailed' ? '&fix=Y' : '');
        },
        request(name, params, method) {
            return moqui.request(this.url(name), { method: method || 'GET', params: params || {} }).then((result) => {
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                return json;
            }, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        post(name, params) { return this.request(name, params, 'POST'); },

        // ---- the view in the URL ----
        openView(params) {
            const query = {};
            Object.keys(params || {}).forEach((key) => { if (params[key] !== null && params[key] !== undefined && params[key] !== '') query[key] = params[key]; });
            const search = moqui.objToSearch(query);
            if (this.isPhone) this.railDialog = false;
            this.$root.setUrl(this.linkPath() + (search ? '?' + search : ''));
        },
        isActiveView(params) {
            const p = this.params;
            if (p.q) return false;
            const want = Object.assign({ view: null, account: null, folder: null, label: null, mailbox: null }, params);
            const have = { view: p.view || (p.folder || p.label || p.mailbox ? null : 'inbox'), account: p.account || null, folder: p.folder || null, label: p.label || null, mailbox: p.mailbox || null };
            if (want.view === 'inbox' && !have.view && !have.folder && !have.label && !have.mailbox) have.view = 'inbox';
            return ['view', 'account', 'folder', 'label', 'mailbox'].every((key) => (want[key] || null) === (have[key] || null));
        },
        applyParams() {
            const p = this.params;
            if (this.viewKey !== this.loadedViewKey) {
                this.loadedViewKey = this.viewKey;
                this.searchInput = p.q || '';
                this.clearSelection();
                this.loadList(true);
                if (p.mailbox) this.loadMailbox(); else this.mailbox = null;
            }
            const wanted = p.thread || null;
            if (wanted !== this.openKey) { if (wanted) this.openThread(wanted); else this.clearThread(); }
        },
        // the client is the screen shown (not a sibling it is leaving for, such as MessageDetail)
        isCurrent() {
            const list = this.$root.currentPathList || [];
            const last = list[list.length - 1];
            return last === 'Mail' || last === 'Inbox';
        },
        setThreadParam(key) { this.$root.setParameters({ thread: key || null }); },

        // ---- data ----
        loadData() {
            return moqui.request(this.url('inboxData')).then((result) => {
                const json = result.json || {};
                this.data = Object.assign({ accountList: [], mailboxList: [], searchList: [], totals: {}, me: {}, prefs: {} }, json);
                if (!this.loaded) {
                    const prefs = json.prefs || {};
                    this.pane = prefs.readingPane || 'right';
                    if (prefs.splitRight > 0) this.splitRight = prefs.splitRight;
                    if (prefs.splitBottom > 0) this.splitBottom = prefs.splitBottom;
                    this.railCollapsed = !!prefs.railCollapsed;
                }
                this.loaded = true;
                if (this.syncPolls > 0 && !this.syncingAny) { this.syncPolls = 0; this.loadList(true); }
            }, moqui.handleAjaxError);
        },
        listParams(extra) {
            const p = this.params;
            return Object.assign({ view: p.view || '', account: p.account || '', folder: p.folder || '', label: p.label || '', mailbox: p.mailbox || '', q: p.q || '',
                unreadOnly: this.unreadOnly ? 'true' : 'false' }, extra || {});
        },
        loadList(reset) {
            const seq = ++this.listSeq;
            if (reset) { this.nextCursor = null; this.hasMore = false; }
            this.loadingList = true;
            this.listError = null;
            const params = this.listParams({ pageSize: 50 });
            if (!reset && this.nextCursor) params.cursor = this.nextCursor;
            return moqui.request(this.url('threads'), { params }).then((result) => {
                if (seq !== this.listSeq) return;
                this.loadingList = false;
                const json = result.json || {};
                const rows = json.threadList || [];
                if (reset) { this.threads = rows; if (this.$refs.list) this.$refs.list.scrollTop = 0; }
                else {
                    const known = new Set(this.threads.map((row) => row.rowKey));
                    this.threads = this.threads.concat(rows.filter((row) => !known.has(row.rowKey)));
                }
                this.hasMore = !!json.hasMore;
                this.nextCursor = json.nextCursor || null;
                this.storeList = json.storeList || [];
                this.failedStores = json.failedStores || [];
                this.termList = json.termList || [];
                if (!this.focusKey && this.threads.length) this.focusKey = this.threads[0].rowKey;
            }, (err) => {
                if (seq !== this.listSeq) return;
                this.loadingList = false;
                const json = err && err.json;
                this.listError = (json && json.errors) || t('The list did not load');
                if (!json || !json.errors) moqui.handleAjaxError(err);
            });
        },
        loadMore() { if (this.hasMore && !this.loadingList) this.loadList(false); },
        reloadAll() { this.loadData(); this.loadList(true); if (this.openKey) this.reloadThread(); if (this.params.mailbox) this.loadMailbox(); },
        onListScroll() {
            const el = this.$refs.list;
            if (el && el.scrollTop + el.clientHeight > el.scrollHeight - 300) this.loadMore();
        },
        onCounts() {
            if (this.countsTimer) clearTimeout(this.countsTimer);
            this.countsTimer = setTimeout(() => {
                this.countsTimer = null;
                this.loadData();
                const el = this.$refs.list;
                if (!this.loadingList && !this.selectedKeys.length && (!el || el.scrollTop < 60)) this.loadList(true);
            }, 1200);
        },
        loadMailbox() {
            const id = this.params.mailbox;
            if (!id) { this.mailbox = null; return Promise.resolve(); }
            return moqui.request(this.url('mailbox'), { params: { contactListId: id } }).then((result) => {
                if (this.params.mailbox !== id) return;
                this.mailbox = (result.json || {}).mailbox || null;
            }, (err) => { this.mailbox = null; moqui.handleAjaxError(err); });
        },

        // ---- rows ----
        participantsText(row) {
            const list = row.participantList || [];
            const mine = (entry) => (row.store === 'email' ? this.myAddresses.has(String(entry.address || '').toLowerCase()) : entry.partyId === this.me.partyId);
            const nameOf = (entry) => (mine(entry) ? t('me') : (entry.name || String(entry.address || '').split('@')[0] || entry.partyId || ''));
            const toView = ['sent', 'drafts', 'outbox', 'scheduled', 'internalSent'].includes(this.params.view);
            if (toView) {
                const others = list.filter((entry) => !mine(entry));
                return t('To') + ': ' + (others.slice(0, 3).map(nameOf).join(', ') || t('me')) + (others.length > 3 ? ' +' + (others.length - 3) : '');
            }
            if (row.store === 'email' && row.messageCount === 1 && this.myAddresses.has(String(row.fromAddress || '').toLowerCase())) {
                const others = list.filter((entry) => !mine(entry));
                return t('To') + ': ' + (others.slice(0, 3).map(nameOf).join(', ') || t('me'));
            }
            if (row.store === 'email') {
                const names = [];
                if (list[0]) names.push(nameOf(list[0]));
                const lastName = nameOf({ address: row.fromAddress, name: row.fromName });
                if (row.messageCount > 1 && !names.includes(lastName)) names.push(lastName);
                return names.join(', ') || row.fromAddress || '';
            }
            const from = list.find((entry) => entry.partyId === row.fromPartyId);
            const names = [];
            if (from) names.push(nameOf(from));
            list.forEach((entry) => { const name = nameOf(entry); if (!names.includes(name) && names.length < 3 && (!mine(entry) || !names.length)) names.push(name); });
            return names.join(', ');
        },
        rowChips(row) {
            const chips = [];
            if (row.snoozedThruDate && Number(row.snoozedThruDate) > Date.now()) chips.push({ key: 'snooze', icon: 'sym_o_snooze', label: t('Until') + ' ' + this.shortWhen(row.snoozedThruDate), color: 'info' });
            if (row.statusId === 'ES_SCHEDULED' && row.scheduledSendDate) chips.push({ key: 'sched', icon: 'sym_o_schedule_send', label: t('Sends') + ' ' + this.shortWhen(row.scheduledSendDate), color: 'info' });
            if (row.sendError) chips.push({ key: 'error', icon: 'sym_o_error', label: t('Not sent'), color: 'negative' });
            if (row.isClosed) chips.push({ key: 'closed', icon: 'sym_o_lock', label: t('Closed'), color: 'positive' });
            if (row.contactListId && row.contactListId !== this.params.mailbox) chips.push({ key: 'box', icon: 'sym_o_forum', label: row.contactListName || t('Mailbox') });
            if (row.contactListId && row.replyCount) chips.push({ key: 'replies', icon: 'sym_o_forum', label: row.replyCount === 1 ? t('1 reply') : row.replyCount + ' ' + t('replies') });
            (row.labelList || []).slice(0, 3).forEach((label) => chips.push({ key: 'l' + label.emailLabelId, icon: 'sym_o_label', label: label.labelName }));
            return chips;
        },
        flatIndex(key) { return this.threads.findIndex((row) => row.rowKey === key); },
        // a phone swipe runs the two preferred actions (MAIL_SWIPE_LEFT, MAIL_SWIPE_RIGHT), the same posts as the row buttons
        swipeStart(row, event) {
            if (!this.isPhone || !event.changedTouches || !event.changedTouches[0]) return;
            const touch = event.changedTouches[0];
            this.swipe = { key: row.rowKey, x: touch.clientX, y: touch.clientY, dx: 0, active: true };
        },
        swipeMove(row, event) {
            if (!this.swipe || this.swipe.key !== row.rowKey || !this.swipe.active || !event.changedTouches) return;
            const touch = event.changedTouches[0];
            const dx = touch.clientX - this.swipe.x;
            const dy = touch.clientY - this.swipe.y;
            if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 12) { this.swipe.active = false; this.swipe.dx = 0; return; }
            this.swipe.dx = dx;
        },
        swipeEnd(row) {
            if (!this.swipe || this.swipe.key !== row.rowKey) return;
            const dx = this.swipe.active ? this.swipe.dx : 0;
            this.swipe = null;
            if (Math.abs(dx) < 72) return;
            const prefs = this.data.prefs || {};
            const name = dx < 0 ? (prefs.swipeLeft || 'archive') : (prefs.swipeRight || 'read');
            this.swipeSuppress = row.rowKey;
            this.rowAction(row, this.swipeAction(row, name));
        },
        swipeStyle(row) {
            if (!this.swipe || this.swipe.key !== row.rowKey || !this.swipe.dx) return null;
            const dx = Math.max(-120, Math.min(120, this.swipe.dx));
            return { transform: 'translateX(' + dx + 'px)', transition: 'none' };
        },
        swipeAction(row, action) {
            if (action === 'trash' && this.view === 'trash') return 'deleteForever';
            if (action === 'read' && !row.isUnread) return 'unread';
            if (action === 'unread' && row.isUnread) return 'read';
            if (action === 'flag') return row.isFlagged ? 'unflag' : 'flag';
            return action;
        },
        clickRow(row, event) {
            if (this.swipeSuppress === row.rowKey) { this.swipeSuppress = null; return; }
            if (event && (event.shiftKey || event.ctrlKey || event.metaKey) && !this.isPhone) { this.checkRow(row, !this.selected[row.rowKey], event.shiftKey); return; }
            this.focusKey = row.rowKey;
            // a draft opens in the composer, as Gmail does
            if (this.params.view === 'drafts' && row.store === 'email' && row.statusId === 'ES_DRAFT') { this.compose({ emailMessageId: row.emailMessageId }); return; }
            this.setThreadParam(row.rowKey);
        },
        checkRow(row, checked, shift) {
            const index = this.flatIndex(row.rowKey);
            const next = Object.assign({}, this.selected);
            const useShift = shift === true || this.shiftDown;
            if (useShift && this.lastCheckedIndex != null && index >= 0) {
                const [from, to] = this.lastCheckedIndex < index ? [this.lastCheckedIndex, index] : [index, this.lastCheckedIndex];
                for (let i = from; i <= to; i++) { if (checked) next[this.threads[i].rowKey] = true; else delete next[this.threads[i].rowKey]; }
            } else if (checked) next[row.rowKey] = true;
            else delete next[row.rowKey];
            this.selected = next;
            this.allInView = false;
            this.lastCheckedIndex = index;
        },
        toggleAll() {
            if (this.selectedKeys.length) { this.clearSelection(); return; }
            const next = {};
            this.threads.forEach((row) => { next[row.rowKey] = true; });
            this.selected = next;
        },
        clearSelection() { this.selected = {}; this.allInView = false; this.lastCheckedIndex = null; },
        toggleUnread() {
            const query = Object.assign({}, this.params);
            delete query.thread;
            if (this.unreadOnly) delete query.unread; else query.unread = 'Y';
            this.openView(query);
        },
        clearFilters() { this.openView({ view: this.params.view, account: this.params.account, folder: this.params.folder, label: this.params.label, mailbox: this.params.mailbox }); },

        // ---- actions on threads ----
        targetOf(row) {
            return { store: row.store, threadId: row.threadId, lastEmailMessageId: row.lastEmailMessageId || null, lastCommEventId: row.lastCommEventId || null,
                emailFolderId: row.emailFolderId || null, emailAccountId: row.emailAccountId || null, rowKey: row.rowKey };
        },
        snoozeOrMoveRows(targets) {
            if (targets === 'thread') return this.thread ? [this.threadRow()] : [];
            if (Array.isArray(targets)) return targets;
            return this.selectionRows;
        },
        threadRow() {
            const thread = this.thread;
            const row = this.threads.find((item) => item.rowKey === this.openKey);
            if (row) return row;
            const last = this.lastMessage || {};
            return { store: thread.store, threadId: thread.threadId, rowKey: this.openKey, lastEmailMessageId: last.emailMessageId || null,
                lastCommEventId: last.communicationEventId || null, emailAccountId: thread.emailAccountId || last.emailAccountId || null, emailFolderId: null };
        },
        removesFromView(action) {
            const membership = ['archive', 'unarchive', 'trash', 'deleteForever', 'spam', 'notSpam', 'move', 'snooze', 'unsnooze'];
            if (action === 'unflag' && this.params.view === 'flagged') return true;
            if (action === 'read' && this.unreadOnly) return false;
            if (!membership.includes(action)) return false;
            if ((this.params.view === 'all' || this.params.q) && ['archive', 'unarchive', 'snooze', 'unsnooze'].includes(action)) return false;
            if (this.params.view === 'archive' && action === 'archive') return false;
            return true;
        },
        // change threads by store, with the list changed at once and an Undo for what can be undone
        applyAction(rows, action, extra, quiet) {
            if (!rows.length) return Promise.resolve();
            const targets = rows.map((row) => this.targetOf(row));
            const params = Object.assign({ targetsJson: JSON.stringify(targets), action }, extra || {});
            const openRemoved = this.openKey && rows.some((row) => row.rowKey === this.openKey) && this.removesFromView(action);
            const nextKey = openRemoved ? this.neighbourKey(this.openKey, 1) : null;
            return this.post('state', params).then((json) => {
                const failed = new Set((json.failedList || []).map((item) => item.key));
                const done = rows.filter((row) => !failed.has(row.store + ':' + row.threadId));
                this.applyLocal(done, action, extra);
                if (json.failedList && json.failedList.length) moqui.notifyMessages(null, json.failedList.map((item) => item.message).join('\n'));
                if (!quiet && done.length) this.offerUndo(done, action, extra);
                if (openRemoved && !failed.has(this.openKey)) {
                    if (nextKey && this.splitMode && this.data.prefs.archiveOpensNext !== false) this.setThreadParam(nextKey); else this.setThreadParam(null);
                } else if (this.openKey && rows.some((row) => row.rowKey === this.openKey)) this.reloadThread();
                this.loadData();
                return json;
            }, () => {});
        },
        applyLocal(rows, action, extra) {
            const keys = new Set(rows.map((row) => row.rowKey));
            if (this.removesFromView(action)) {
                this.threads = this.threads.filter((row) => !keys.has(row.rowKey));
                const next = Object.assign({}, this.selected);
                keys.forEach((key) => delete next[key]);
                this.selected = next;
                return;
            }
            this.threads.forEach((row) => {
                if (!keys.has(row.rowKey)) return;
                if (action === 'read') { row.isUnread = false; row.unreadCount = 0; }
                if (action === 'unread') { row.isUnread = true; row.unreadCount = Math.max(1, row.unreadCount || 0); }
                if (action === 'flag') row.isFlagged = true;
                if (action === 'unflag') row.isFlagged = false;
                if (action === 'labels') {
                    const accountId = row.store === 'internal' ? (this.internalAccount || {}).emailAccountId : row.emailAccountId;
                    const accountLabels = (this.accountsWithLabels.find((account) => account.emailAccountId === accountId) || { labelList: [] }).labelList;
                    const add = String((extra && extra.addLabelIds) || '').split(',').filter((id) => id);
                    const remove = String((extra && extra.removeLabelIds) || '').split(',').filter((id) => id);
                    const kept = (row.labelList || []).filter((label) => !remove.includes(label.emailLabelId));
                    add.forEach((id) => { if (!kept.some((label) => label.emailLabelId === id)) { const label = accountLabels.find((item) => item.emailLabelId === id); if (label) kept.push(label); } });
                    row.labelList = kept;
                }
                if (action === 'close') row.isClosed = true;
                if (action === 'reopen') row.isClosed = false;
            });
        },
        offerUndo(rows, action, extra) {
            const inverse = { archive: 'unarchive', unarchive: 'archive', read: 'unread', unread: 'read', flag: 'unflag', unflag: 'flag', snooze: 'unsnooze',
                spam: 'notSpam', notSpam: 'spam', close: 'reopen', reopen: 'close' };
            const words = { archive: t('Archived'), unarchive: t('Moved to the Inbox'), trash: t('Moved to the Trash'), spam: t('Reported as spam'),
                notSpam: t('Not spam: back in the Inbox'), snooze: t('Snoozed'), move: t('Moved'), deleteForever: t('Deleted forever') };
            const count = rows.length;
            const undo = () => {
                if (action === 'trash' || action === 'move') {
                    // back to the folder each was in (an internal thread is unarchived)
                    const internal = rows.filter((row) => row.store === 'internal');
                    if (internal.length) this.applyAction(internal, 'unarchive', null, true);
                    const byFolder = {};
                    rows.filter((row) => row.store === 'email' && row.emailFolderId).forEach((row) => { (byFolder[row.emailFolderId] = byFolder[row.emailFolderId] || []).push(row); });
                    Object.keys(byFolder).forEach((folderId) => this.applyAction(byFolder[folderId], 'move', { emailFolderId: folderId }, true));
                    setTimeout(() => this.loadList(true), 400);
                } else if (action === 'labels') {
                    this.applyAction(rows, 'labels', { addLabelIds: (extra && extra.removeLabelIds) || '', removeLabelIds: (extra && extra.addLabelIds) || '' }, true);
                } else if (inverse[action]) {
                    this.applyAction(rows, inverse[action], null, true).then(() => this.loadList(true));
                }
            };
            this.undoStack.push(undo);
            if (this.undoStack.length > 10) this.undoStack.shift();
            if (!words[action]) return;
            const message = words[action] + (count > 1 ? ' · ' + count : '');
            if (this.$q.notify) this.$q.notify({ message, timeout: 6000, position: 'bottom-left', group: false,
                actions: action === 'deleteForever' ? [] : [{ label: t('Undo'), color: 'yellow', handler: () => { this.undoStack = this.undoStack.filter((item) => item !== undo); undo(); } }] });
        },
        undo() { const last = this.undoStack.pop(); if (last) last(); return !!last; },
        rowAction(row, action) { this.applyAction([row], action); },
        toggleRowFlag(row) { this.applyAction([row], row.isFlagged ? 'unflag' : 'flag', null, true); },
        bulk(action) {
            if (this.allInView) {
                const params = Object.assign(this.listParams(), { action });
                this.post('viewAction', params).then((json) => {
                    moqui.notifyMessages([{ type: 'success', message: (json.updatedCount || 0) + ' ' + t('conversations changed') }], (json.failedList || []).map((item) => item.message).join('\n') || null);
                    this.clearSelection();
                    this.loadList(true);
                    this.loadData();
                }, () => {});
                return;
            }
            this.applyAction(this.selectionRows, action).then(() => { if (!this.removesFromView(action)) this.clearSelection(); });
        },
        threadAction(action) {
            if (!this.thread) return;
            const row = this.threadRow();
            if (action === 'close' || action === 'reopen') {
                this.applyAction([row], action, null, true).then(() => this.reloadThread());
                return;
            }
            this.applyAction([row], action);
        },
        neighbourKey(key, step) {
            const index = this.flatIndex(key);
            if (index < 0) return null;
            const next = this.threads[index + step] || this.threads[index - step];
            return next ? next.rowKey : null;
        },

        // ---- the reading pane ----
        openThread(key) {
            const at = String(key).indexOf(':');
            if (at <= 0) return;
            const store = key.substring(0, at);
            const threadId = key.substring(at + 1);
            const seq = ++this.threadSeq;
            this.openKey = key;
            this.focusKey = key;
            this.loadingThread = true;
            this.thread = null;
            this.showOlder = false;
            this.details = {};
            this.trustOffer = null;
            if (this.markReadTimer) { clearTimeout(this.markReadTimer); this.markReadTimer = null; }
            moqui.request(this.url('thread'), { params: { store, threadId } }).then((result) => {
                if (seq !== this.threadSeq) return;
                this.loadingThread = false;
                const thread = (result.json || {}).thread || null;
                this.thread = thread;
                if (!thread) return;
                const expanded = {};
                const list = thread.messageList;
                list.forEach((message, index) => { if (message.isUnread || message.isDraft || index === list.length - 1) expanded[message.key] = true; });
                this.expanded = expanded;
                this.focusMessageKey = list.length ? list[list.length - 1].key : null;
                if (this.$refs.pane) this.$refs.pane.scrollTop = 0;
                this.$nextTick(() => this.scrollToFirstUnread());
                if (thread.unreadCount > 0) this.scheduleMarkRead(key);
            }, (err) => {
                if (seq !== this.threadSeq) return;
                this.loadingThread = false;
                moqui.handleAjaxError(err);
            });
        },
        reloadThread() {
            if (!this.openKey) return;
            const key = this.openKey;
            const at = key.indexOf(':');
            const seq = ++this.threadSeq;
            moqui.request(this.url('thread'), { params: { store: key.substring(0, at), threadId: key.substring(at + 1) } }).then((result) => {
                if (seq !== this.threadSeq || this.openKey !== key) return;
                const thread = (result.json || {}).thread || null;
                if (thread) {
                    const expanded = Object.assign({}, this.expanded);
                    if (thread.messageList.length) expanded[thread.messageList[thread.messageList.length - 1].key] = true;
                    this.expanded = expanded;
                }
                this.thread = thread;
            }, () => {});
        },
        scheduleMarkRead(key) {
            const delay = Math.max(0, Number(this.data.prefs.markReadSeconds || 0)) * 1000;
            this.markReadTimer = setTimeout(() => {
                this.markReadTimer = null;
                if (this.openKey !== key || !this.thread) return;
                const row = this.threadRow();
                this.post('state', { targetsJson: JSON.stringify([this.targetOf(row)]), action: 'read' }).then(() => {
                    this.applyLocal([row], 'read');
                    if (this.thread) this.thread.messageList.forEach((message) => { message.isUnread = false; });
                    this.loadData();
                }, () => {});
            }, delay);
        },
        clearThread() { this.openKey = null; this.thread = null; this.loadingThread = false; this.threadSeq++; },
        closeThread() { this.setThreadParam(null); },
        isExpanded(message) { return !!this.expanded[message.key]; },
        expand(message) { this.expanded = Object.assign({}, this.expanded, { [message.key]: true }); this.focusMessageKey = message.key; },
        expandAll() {
            const all = {};
            (this.thread ? this.thread.messageList : []).forEach((message) => { all[message.key] = true; });
            this.expanded = all;
            this.showOlder = true;
        },
        toggleDetails(message) { this.details = Object.assign({}, this.details, { [message.key]: !this.details[message.key] }); },
        scrollToFirstUnread() {
            const list = this.thread ? this.thread.messageList : [];
            const first = list.find((message) => message.isUnread);
            if (!first || list.length < 2) return;
            const el = document.getElementById('inbox-msg-' + first.key.replace(/[^A-Za-z0-9_-]/g, '_'));
            if (el && el.scrollIntoView) el.scrollIntoView({ block: 'start' });
        },
        avatarName(person) { return person && person.isMe ? (this.me.name || person.name || person.address) : this.personName(person); },
        personName(person) { return person ? (person.isMe ? t('me') : (person.name || person.address || person.partyId || '')) : t('Unknown'); },
        personFull(person) { return person ? (person.name && person.address ? person.name + ' <' + person.address + '>' : (person.name || person.address || person.partyId || '')) : ''; },
        recipientsText(message) {
            const names = message.toList.concat(message.ccList).map((person) => this.personName(person));
            if (message.bccList.length) names.push(t('bcc') + ': ' + message.bccList.map((person) => this.personName(person)).join(', '));
            return (message.contactListId && this.thread && this.thread.contactListName ? t('to') + ' ' + this.thread.contactListName + (names.length ? ', ' : '') : t('to') + ' ') + names.join(', ');
        },
        plainSnippet(message) {
            if (message.snippet) return message.snippet;
            const text = message.text || String(message.html || '').replace(/<style[\s\S]*?<\/style>/gi, ' ').replace(/<[^>]*>/g, ' ');
            return text.replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim().substring(0, 160);
        },
        isTrusted(message) {
            if (message.store === 'internal') return true;
            const address = message.from && message.from.address ? String(message.from.address).toLowerCase() : null;
            return !!address && (this.data.prefs.remoteImages === 'always' || (this.data.prefs.trustedSenders || []).includes(address) || (message.from && message.from.isMe));
        },
        onShowImages(message) { if (message.store === 'email' && message.from && message.from.address && !message.from.isMe) this.trustOffer = message.key; },
        trustSender(message) {
            this.post('trustSender', { emailAddress: message.from.address }).then((json) => {
                this.data.prefs.trustedSenders = json.trustedSenders || [];
                this.trustOffer = null;
            }, () => {});
        },
        cidMap(message) {
            const map = {};
            Object.keys(message.cidMap || {}).forEach((cid) => { map[cid] = this.url(message.cidMap[cid]) + '&inline=true'; });
            return map;
        },
        canReplyTo(message) {
            if (!this.thread || !message) return false;
            if (message.store === 'email') return this.thread.canSend;
            return this.thread.canReply || (!this.thread.contactListId);
        },
        fileIcon(file) {
            const name = String(file.name || '').toLowerCase();
            const type = String(file.contentType || '');
            if (/^image\//.test(type) || /\.(png|jpe?g|gif|webp)$/.test(name)) return 'sym_o_image';
            if (/pdf/.test(type) || /\.pdf$/.test(name)) return 'sym_o_picture_as_pdf';
            if (/calendar/.test(type) || /\.ics$/.test(name)) return 'sym_o_event';
            return 'sym_o_attach_file';
        },
        sizeText(size) {
            const n = Number(size) || 0;
            if (n >= 1048576) return (n / 1048576).toFixed(1) + ' MB';
            if (n >= 1024) return Math.round(n / 1024) + ' KB';
            return n + ' B';
        },
        openSaveFiles(message, file) {
            this.saveTo = { open: true, file, message, drives: [], driveId: null, path: '', crumbs: [], rows: [], loading: true, saving: false };
            moqui.request(this.url('pickerData')).then((result) => {
                const json = result.json || {};
                this.saveTo.drives = json.driveList || [];
                this.saveTo.loading = false;
                if (json.personalDriveId) this.saveFilesOpen(json.personalDriveId, '');
            }, () => { this.saveTo.loading = false; });
        },
        saveFilesOpen(driveId, path) {
            Object.assign(this.saveTo, { driveId, path: path || '', loading: true });
            moqui.request(this.url('pickerFolder'), { params: { driveId, path: path || '' } }).then((result) => {
                const json = result.json || {};
                this.saveTo.rows = json.fileList || [];
                this.saveTo.crumbs = (json.breadcrumbList || []).filter((crumb) => !crumb.view);
                this.saveTo.loading = false;
            }, () => { this.saveTo.loading = false; this.saveTo.rows = []; });
        },
        saveFilesHere() {
            const file = this.saveTo.file, message = this.saveTo.message;
            if (!file || !message || !this.saveTo.driveId) return;
            this.saveTo.saving = true;
            this.request('saveFiles', { store: message.store, id: file.id, driveId: this.saveTo.driveId, path: this.saveTo.path || '' }, 'POST').then((json) => {
                this.saveTo.saving = false;
                const saved = (json.savedList || [])[0];
                if (saved) {
                    this.saveTo.open = false;
                    moqui.notifyMessages([{ type: 'success', message: t('Saved to Files') + ': ' + (saved.name || file.name) }]);
                } else moqui.notifyMessages(null, (json.failedList && json.failedList[0] && json.failedList[0].error) || t('Not saved'));
            }, () => { this.saveTo.saving = false; });
        },
        openAttachment(message, file) {
            const href = (inline) => this.url('attachment') + '?' + moqui.objToSearch({ store: message.store, id: file.id, inline: inline ? 'true' : 'false' });
            const name = String(file.name || '').toLowerCase();
            if (/\.(png|jpe?g|gif|webp|pdf)$/.test(name) || /^image\/|pdf/.test(String(file.contentType || ''))) { window.open(href(true), '_blank', 'noopener'); return; }
            const link = document.createElement('a');
            link.href = href(false);
            link.setAttribute('download', file.name || '');
            document.body.appendChild(link);
            link.click();
            link.remove();
        },
        invitationWhen(invitation) {
            if (!invitation.start) return '';
            const start = new Date(Number(invitation.start));
            const end = invitation.end ? new Date(Number(invitation.end)) : null;
            const day = start.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
            if (invitation.allDay) return day + ' · ' + t('all day');
            const time = (d) => d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
            return day + ' · ' + time(start) + (end ? ' – ' + time(end) : '');
        },
        respondInvite(message, response) {
            this.post('respondInvite', { emailMessageId: message.emailMessageId, response }).then((json) => {
                const status = { accept: 'accepted', tentative: 'tentative', decline: 'declined' }[response];
                message.invitation.myStatus = status;
                if (json.workEffortId) message.invitation.workEffortId = json.workEffortId;
            }, () => {});
        },
        flagMessage(message) {
            const target = message.store === 'email' ? { store: 'email', emailMessageId: message.emailMessageId } : { store: 'internal', communicationEventId: message.communicationEventId };
            const action = message.isFlagged ? 'unflag' : 'flag';
            this.post('state', { targetsJson: JSON.stringify([target]), action }).then(() => {
                message.isFlagged = !message.isFlagged;
                const flagged = this.thread.messageList.some((item) => item.isFlagged);
                this.thread.isFlagged = flagged;
                const row = this.threads.find((item) => item.rowKey === this.openKey);
                if (row) row.isFlagged = flagged;
            }, () => {});
        },
        markUnreadFrom(message) {
            const list = this.thread.messageList;
            const from = list.indexOf(message);
            const targets = list.slice(Math.max(from, 0)).map((item) => item.store === 'email' ? { store: 'email', emailMessageId: item.emailMessageId }
                : { store: 'internal', communicationEventId: item.communicationEventId });
            this.post('state', { targetsJson: JSON.stringify(targets), action: 'unread' }).then(() => {
                const row = this.threads.find((item) => item.rowKey === this.openKey);
                if (row) { row.isUnread = true; row.unreadCount = targets.length; }
                this.setThreadParam(null);
                this.loadData();
            }, () => {});
        },
        cancelScheduled(message) {
            moqui.request(this.composeBase() + '/cancelSend', { method: 'POST', params: { emailMessageId: message.emailMessageId } }).then(() => {
                moqui.notifyMessages([{ type: 'success', message: t('Back in Drafts') }]);
                this.reloadAll();
            }, moqui.handleAjaxError);
        },
        unsubscribe(message) {
            this.confirm(t('Unsubscribe'), t('Stop getting mail from this list?'), t('Unsubscribe')).then(() => {
                this.post('unsubscribe', { emailMessageId: message.emailMessageId }).then((json) => {
                    if (json.method === 'url' && json.url) window.open(json.url, '_blank', 'noopener');
                }, () => {});
            });
        },
        blockSender(message) {
            const who = message.from ? this.personFull(message.from) : '';
            this.confirm(t('Block sender'), t('Mail from this sender will go to Spam') + ': ' + who, t('Block'), true).then(() => {
                this.post('blockSender', { emailMessageId: message.emailMessageId }).then(() => { this.setThreadParam(null); this.loadList(true); this.loadData(); }, () => {});
            });
        },
        reportMessageSpam(message) {
            this.post('state', { targetsJson: JSON.stringify([{ store: 'email', emailMessageId: message.emailMessageId }]), action: 'spam' }).then(() => {
                moqui.notifyMessages([{ type: 'success', message: t('Reported as spam') }]);
                this.reloadThread();
                this.loadList(true);
            }, () => {});
        },
        openDetail(message) {
            if (!message) return;
            const query = message.store === 'email' ? 'emailMessageId=' + encodeURIComponent(message.emailMessageId) : 'communicationEventId=' + encodeURIComponent(message.communicationEventId);
            this.go(this.$root.linkBasePath + '/' + this.inboxPath() + '/MessageDetail?' + query);
        },

        // ---- the contact card ----
        hoverContact(person, event) {
            if (this.isTouch || !person) return;
            if (this.contactTimer) clearTimeout(this.contactTimer);
            const target = event.currentTarget;
            this.contactTimer = setTimeout(() => { this.contactTimer = null; this.openContact(person, { currentTarget: target }); }, 600);
        },
        leaveContact() {
            if (this.contactTimer) { clearTimeout(this.contactTimer); this.contactTimer = null; }
            if (this.contactCloseTimer) clearTimeout(this.contactCloseTimer);
            this.contactCloseTimer = setTimeout(() => { this.contactCloseTimer = null; if (!this.contactHover) this.contact.open = false; }, 500);
        },
        keepContact() { this.contactHover = true; if (this.contactCloseTimer) { clearTimeout(this.contactCloseTimer); this.contactCloseTimer = null; } },
        openContact(person, event) {
            if (!person) return;
            this.contactHover = false;
            const target = event && (event.currentTarget || event.target);
            this.contact = { open: true, target: target || null, address: person.address || null, name: person.name || null, partyId: person.partyId || null, card: null, loading: true };
            moqui.request(this.url('contactCard'), { params: { emailAddress: person.address || '', partyId: person.partyId || '', name: person.name || '' } }).then((result) => {
                if (this.contact.address !== (person.address || null) || this.contact.partyId !== (person.partyId || null)) return;
                this.contact.card = (result.json || {}).card || null;
                this.contact.loading = false;
            }, () => { this.contact.loading = false; });
        },
        addContact() {
            const card = this.contact.card || {};
            this.contact.open = false;
            this.openQuickCreate('/qapps/Commons/QuickCreate?' + moqui.objToSearch({ kind: 'contact', contactName: card.name || this.contact.name || '', emailAddress: card.emailAddress || this.contact.address || '' }), t('New contact'));
        },
        openQuickCreate(url, title) {
            this.$root.quickCreateTitle = title || '';
            this.$root.quickCreateUrl = this.$root.shellLoadPath ? this.$root.shellLoadPath(url) : url.replace(/^\/qapps/, '/apps');
            this.$root.quickCreateShow = true;
        },

        // ---- create from a message, link to a record ----
        createFrom(message, kind) {
            if (!message) return;
            const params = message.store === 'email' ? { kind, emailMessageId: message.emailMessageId } : { kind, communicationEventId: message.communicationEventId };
            this.post('createFrom', params).then((json) => {
                if (!json.url) return;
                this.pendingCreateFrom = true;
                this.openQuickCreate(json.url, { task: t('New task'), request: t('New request'), event: t('New event') }[kind]);
            }, () => {});
        },
        openLink(message) { if (message) this.link = { open: true, message, value: null, busy: false }; },
        applyLink() {
            const value = String(this.link.value || '');
            const at = value.indexOf('|');
            if (at <= 0) return;
            const message = this.link.message;
            this.link.busy = true;
            const params = { recordEntityName: value.substring(0, at), recordId: value.substring(at + 1) };
            if (message.store === 'email') params.emailMessageId = message.emailMessageId; else params.communicationEventId = message.communicationEventId;
            this.post('linkRecord', params).then(() => { this.link.open = false; this.link.busy = false; this.reloadThread(); }, () => { this.link.busy = false; });
        },
        unlinkRecord(message, link) {
            const params = { recordEntityName: link.recordEntityName, recordId: link.recordId };
            if (message.store === 'email') params.emailMessageId = message.emailMessageId; else params.communicationEventId = message.communicationEventId;
            this.post('unlinkRecord', params).then(() => {
                message.linkList = message.linkList.filter((item) => item !== link);
                this.reloadThread();
            }, () => {});
        },

        // ---- dialogs: snooze, move, labels ----
        openSnooze(targets) {
            const rows = this.snoozeOrMoveRows(targets);
            if (!rows.length) return;
            this.snooze = { open: true, targets: rows, custom: '' };
        },
        shortWhen(millis) {
            const d = new Date(Number(millis));
            const now = new Date();
            const sameDay = d.toDateString() === now.toDateString();
            const time = d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
            if (sameDay) return time;
            return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) + ' ' + time;
        },
        parseDateTime(text) {
            const match = /^(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2}))?/.exec(String(text || ''));
            if (!match) return null;
            return new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]), Number(match[4] || 8), Number(match[5] || 0)).getTime();
        },
        applySnooze(at) {
            if (!at) return;
            const rows = this.snooze.targets;
            this.snooze.open = false;
            this.applyAction(rows, 'snooze', { snoozedThruDate: String(at) }).then(() => this.clearSelection());
        },
        openMove(targets) {
            const rows = this.snoozeOrMoveRows(targets).filter((row) => row.store === 'email');
            if (!rows.length) { moqui.notifyMessages(null, t('Internal messages have no folders')); return; }
            this.move = { open: true, targets: rows, filter: '', newFolder: '' };
        },
        applyMove(folder) {
            const rows = this.move.targets;
            this.move.open = false;
            this.applyAction(rows, 'move', { emailFolderId: folder.emailFolderId }).then(() => this.clearSelection());
        },
        createFolderAndMove() {
            const account = this.moveAccounts[0];
            this.post('createFolder', { emailAccountId: account.emailAccountId, folderName: this.move.newFolder }).then((json) => {
                this.loadData();
                if (json.emailFolderId) this.applyMove({ emailFolderId: json.emailFolderId });
            }, () => {});
        },
        openLabels(targets) {
            const internal = this.internalAccount;
            const rows = this.snoozeOrMoveRows(targets).filter((row) => row.store === 'email' || row.store === 'internal');
            if (!rows.length) { moqui.notifyMessages(null, t('Labels are for mail')); return; }
            const choice = {};
            const accounts = new Set(rows.map((row) => row.store === 'internal' && internal ? internal.emailAccountId : row.emailAccountId));
            this.accountsWithLabels.filter((account) => accounts.has(account.emailAccountId)).forEach((account) => account.labelList.forEach((label) => {
                const has = rows.filter((row) => (row.labelList || (this.thread && targets === 'thread' ? this.thread.labelList : [])).some((item) => item.emailLabelId === label.emailLabelId)).length;
                choice[label.emailLabelId] = has === 0 ? false : (has === rows.length ? true : null);
            }));
            this.labels = { open: true, targets: rows, choice, original: Object.assign({}, choice), newName: {} };
        },
        toggleLabelChoice(label) { this.labels.choice = Object.assign({}, this.labels.choice, { [label.emailLabelId]: this.labels.choice[label.emailLabelId] !== true }); },
        createLabel(account) {
            const name = this.labels.newName[account.emailAccountId];
            this.post('createLabel', { emailAccountId: account.emailAccountId, labelName: name }).then((json) => {
                this.labels.newName = Object.assign({}, this.labels.newName, { [account.emailAccountId]: '' });
                return this.loadData().then(() => {
                    if (json.emailLabelId) this.labels.choice = Object.assign({}, this.labels.choice, { [json.emailLabelId]: true });
                });
            }, () => {});
        },
        applyLabels() {
            const add = [], remove = [];
            Object.keys(this.labels.choice).forEach((id) => {
                if (this.labels.choice[id] === true && this.labels.original[id] !== true) add.push(id);
                if (this.labels.choice[id] === false && this.labels.original[id] !== false) remove.push(id);
            });
            const rows = this.labels.targets;
            this.labels.open = false;
            if (!add.length && !remove.length) return;
            this.applyAction(rows, 'labels', { addLabelIds: add.join(','), removeLabelIds: remove.join(',') }).then(() => this.clearSelection());
        },
        removeLabel(label) { this.applyAction([this.threadRow()], 'labels', { removeLabelIds: label.emailLabelId }, true); },

        // ---- search ----
        runSearch() {
            const q = String(this.searchInput || '').trim();
            const query = { q };
            if (this.params.mailbox) query.mailbox = this.params.mailbox;
            else if (this.params.account) query.account = this.params.account;
            else if (['internal', 'internalSent', 'internalArchive', 'comments'].includes(this.params.view)) query.view = this.params.view;
            if (!q) { this.clearSearch(); return; }
            this.openView(query);
        },
        clearSearchInput() { this.searchInput = this.params.q || ''; },
        clearSearch() {
            const query = Object.assign({}, this.params);
            delete query.q;
            delete query.thread;
            this.openView(query);
        },
        removeTerm(chip) {
            const term = chip.term;
            const operator = term.operator === 'larger' ? '(larger|size)' : term.operator;
            const pattern = new RegExp('(^|\\s)' + (term.negate ? '-' : '') + operator + ':("[^"]*"|\\([^)]*\\)|\\S+)', 'i');
            const q = String(this.params.q || '').replace(pattern, ' ').replace(/\s+/g, ' ').trim();
            this.searchInput = q;
            if (q) this.openView(Object.assign({}, this.params, { q, thread: null })); else this.clearSearch();
        },
        fillAdvanced() {
            const q = String(this.params.q || this.searchInput || '');
            const read = (operator) => { const match = new RegExp('(?:^|\\s)' + operator + ':("([^"]*)"|\\(([^)]*)\\)|(\\S+))', 'i').exec(q); return match ? (match[2] || match[3] || match[4] || '') : ''; };
            const flags = [];
            if (/has:attachment/i.test(q)) flags.push('attachment');
            if (/is:unread/i.test(q)) flags.push('unread');
            if (/is:(flagged|starred)/i.test(q)) flags.push('flagged');
            const within = read('newer_than') || null;
            const where = read('in') || null;
            const words = q.replace(/-?[a-z_]+:("[^"]*"|\([^)]*\)|\S+)/gi, ' ').split(/\s+/).filter((word) => word && !word.startsWith('-'));
            const without = q.replace(/-?[a-z_]+:("[^"]*"|\([^)]*\)|\S+)/gi, ' ').split(/\s+/).filter((word) => word.startsWith('-') && word.length > 1).map((word) => word.substring(1));
            this.advanced = { from: read('from'), to: read('to'), subject: read('subject'), words: words.join(' '), without: without.join(' '), within, where, flags };
        },
        runAdvanced() {
            const a = this.advanced;
            const quote = (value) => (/\s/.test(value) ? '"' + value.replace(/"/g, '') + '"' : value);
            const parts = [];
            if (a.from) parts.push('from:' + quote(a.from.trim()));
            if (a.to) parts.push('to:' + quote(a.to.trim()));
            if (a.subject) parts.push('subject:' + quote(a.subject.trim()));
            if (a.words) parts.push(a.words.trim());
            if (a.without) a.without.trim().split(/\s+/).forEach((word) => parts.push('-' + word));
            (a.flags || []).forEach((flag) => parts.push(flag === 'attachment' ? 'has:attachment' : 'is:' + flag));
            if (a.within) parts.push('newer_than:' + a.within);
            if (a.where) parts.push('in:' + a.where);
            this.searchInput = parts.join(' ');
            this.advancedOpen = false;
            this.runSearch();
        },
        clearAdvanced() { this.advanced = { from: '', to: '', subject: '', words: '', without: '', within: null, where: null, flags: [] }; },
        openSaveSearch() { this.saveSearch = { open: true, name: this.freeText || String(this.params.q || '').substring(0, 40) }; },
        applySaveSearch() {
            this.post('saveSearch', { searchName: this.saveSearch.name, queryText: this.params.q || '' }).then(() => {
                this.saveSearch.open = false;
                moqui.notifyMessages([{ type: 'success', message: t('Search saved') }]);
                this.loadData();
            }, () => {});
        },
        deleteSearch(search) { this.post('deleteSearch', { emailSearchId: search.emailSearchId }).then(() => this.loadData(), () => {}); },
        focusSearch() {
            const input = document.getElementById('InboxSearch');
            if (input) { input.focus(); if (input.select) input.select(); }
            return true;
        },

        // ---- rail, panes, sync ----
        toggleRail() {
            this.railCollapsed = !this.railCollapsed;
            if (this.$root.setPreference) this.$root.setPreference('MAIL_RAIL_COLLAPSED', this.railCollapsed ? 'Y' : 'N');
        },
        toggleAccount(account) { this.collapsedAccounts = Object.assign({}, this.collapsedAccounts, { [account.emailAccountId]: !this.collapsedAccounts[account.emailAccountId] }); },
        setPane(value) {
            this.pane = value;
            if (this.$root.setPreference) this.$root.setPreference('MAIL_READING_PANE', value);
        },
        startDrag(event) {
            const box = this.$refs.panes;
            if (!box) return;
            const rect = box.getBoundingClientRect();
            const bottom = this.pane === 'bottom';
            const move = (e) => {
                const ratio = bottom ? (e.clientY - rect.top) / rect.height : (e.clientX - rect.left) / rect.width;
                const value = Math.round(Math.min(80, Math.max(20, ratio * 100)));
                if (bottom) this.splitBottom = value; else this.splitRight = value;
            };
            const up = () => {
                document.removeEventListener('mousemove', move);
                document.removeEventListener('mouseup', up);
                if (this.$root.setPreference) this.$root.setPreference(bottom ? 'MAIL_SPLIT_BOTTOM' : 'MAIL_SPLIT_RIGHT', String(bottom ? this.splitBottom : this.splitRight));
            };
            document.addEventListener('mousemove', move);
            document.addEventListener('mouseup', up);
        },
        measure() {
            const box = this.$el && this.$el.querySelector ? this.$el.querySelector('.m-inbox') : null;
            if (!box || !box.getBoundingClientRect) return;
            const top = box.getBoundingClientRect().top + (window.scrollY || 0);
            const footer = document.querySelector('.q-footer');
            this.height = Math.max(this.isPhone ? 420 : 480, window.innerHeight - top - (footer ? footer.offsetHeight : 0) - 6);
            // what still overflows the window (the page's own padding) comes off once it is laid out
            this.$nextTick(() => {
                const over = document.documentElement.scrollHeight - window.innerHeight;
                if (over > 0 && over < 80 && this.height - over >= (this.isPhone ? 420 : 480)) this.height -= over;
            });
        },
        syncNow() {
            this.syncBusy = true;
            this.post('syncNow', {}).then((json) => {
                this.syncBusy = false;
                const count = (json.startedList || []).length;
                moqui.notifyMessages([{ type: 'info', message: count ? t('Syncing your mail…') : t('No account to sync') }]);
                if (count) { this.syncPolls = 1; this.pollSync(); }
            }, () => { this.syncBusy = false; });
        },
        pollSync() {
            if (this.syncPolls <= 0 || this.syncPolls > 30) { this.syncPolls = 0; return; }
            setTimeout(() => {
                if (this.syncPolls <= 0) return;
                this.syncPolls++;
                this.loadData().then(() => { if (this.syncingAny) this.pollSync(); else if (this.syncPolls > 0) { this.syncPolls = 0; this.loadList(true); } });
            }, 2500);
        },

        // ---- mailboxes ----
        mailboxJoin() {
            this.post('mailboxJoin', { contactListId: this.params.mailbox }).then(() => { this.loadMailbox(); this.loadData(); this.loadList(true); }, () => {});
        },
        mailboxLeave() {
            this.confirm(t('Leave'), t('Leave this mailbox? Its posts stop coming to you.'), t('Leave'), true).then(() => {
                this.post('mailboxLeave', { contactListId: this.params.mailbox }).then(() => { this.loadMailbox(); this.loadData(); }, () => {});
            });
        },
        mailboxDelivery(value) {
            this.post('mailboxDelivery', { contactListId: this.params.mailbox, deliveryEnumId: value }).then(() => { this.loadMailbox(); this.loadData(); }, () => {});
        },
        mailboxAccept(member) { this.post('mailboxAddMember', { contactListId: this.params.mailbox, partyId: member.partyId }).then(() => this.loadMailbox(), () => {}); },
        mailboxDecline(member) { this.post('mailboxDecline', { contactListId: this.params.mailbox, partyId: member.partyId }).then(() => this.loadMailbox(), () => {}); },
        mailboxRemove(member) {
            this.confirm(t('Remove'), t('Remove from this mailbox') + ': ' + member.name, t('Remove'), true).then(() => {
                this.post('mailboxRemoveMember', { contactListId: this.params.mailbox, partyId: member.partyId }).then(() => this.loadMailbox(), () => {});
            });
        },
        mailboxSetRole(member, roleTypeId) {
            this.post('mailboxAddMember', { contactListId: this.params.mailbox, partyId: member.partyId, roleTypeId }).then(() => this.loadMailbox(), () => {});
        },
        mailboxAddMember() {
            const partyId = this.mailboxDialog.addPartyId;
            this.post('mailboxAddMember', { contactListId: this.params.mailbox, partyId }).then(() => { this.mailboxDialog.addPartyId = null; this.loadMailbox(); }, () => {});
        },
        roleLabel(roleTypeId) { return roleTypeId === 'ListOwner' ? t('Owner') : (roleTypeId === 'ListModerator' ? t('Moderator') : t('Member')); },
        openMailboxSettings(tab) { if (!this.mailbox) return; this.mailboxDialog = { open: true, tab: tab || 'members', key: this.mailboxDialog.key + 1, addPartyId: null }; },
        afterMailboxSettings() { this.mailboxDialog.open = false; this.loadMailbox(); this.loadData(); },
        openBrowse() { this.browse = { open: true, search: '', list: [], loading: true }; this.loadMailboxes(); if (this.isPhone) this.railDialog = false; },
        loadMailboxes() {
            this.browse.loading = true;
            moqui.request(this.url('mailboxes'), { params: { searchText: this.browse.search || '' } }).then((result) => {
                this.browse.loading = false;
                this.browse.list = (result.json || {}).contactListList || [];
            }, (err) => { this.browse.loading = false; moqui.handleAjaxError(err); });
        },
        joinFromBrowse(list) {
            this.post('mailboxJoin', { contactListId: list.contactListId }).then(() => { this.loadMailboxes(); this.loadData(); }, () => {});
        },
        openNewMailbox() { this.newMailbox = { open: true, key: this.newMailbox.key + 1 }; if (this.isPhone) this.railDialog = false; },
        afterNewMailbox() { this.newMailbox.open = false; this.loadData(); },
        onMailboxCreated(answer) {
            const json = answer && (answer.json || answer);
            if (json && json.contactListId) this.openView({ mailbox: json.contactListId });
        },
        asMillis(value) { return value == null ? null : (typeof value === 'number' ? value : (/^\d+$/.test(String(value)) ? Number(value) : Date.parse(value))); },

        // ---- composer docks ----
        composeBase() { return this.$root.basePath + '/' + this.inboxPath() + '/Compose'; },
        composeUrl(dock) { return this.composeBase() + '.qvue?' + moqui.objToSearch(Object.assign({ mode: 'dock', dockKey: dock.key }, dock.query)); },
        compose(query) {
            // a draft already open comes to the front rather than twice
            const same = query && query.emailMessageId ? this.docks.find((dock) => dock.query.emailMessageId === query.emailMessageId) : null;
            if (same) { same.minimized = false; this.saveDocks(); return true; }
            const open = this.docks.filter((dock) => !dock.minimized);
            const max = this.isPhone ? 1 : (this.$q.screen.gt.md ? 3 : 2);
            if (open.length >= max) open[0].minimized = true;
            this.dockCount++;
            this.docks.push({ key: 'd' + Date.now().toString(36) + this.dockCount, query: query || {}, minimized: false, layout: 'dock', title: '' });
            this.saveDocks();
            return true;
        },
        composeToMailbox() { this.compose({ contactListId: this.params.mailbox }); },
        reply(message, all) {
            if (!message) return;
            if (message.store === 'email') this.compose({ replyToEmailMessageId: message.emailMessageId, replyAll: all ? 'true' : 'false' });
            else this.compose({ replyToCommEventId: message.communicationEventId });
        },
        replyToSender(message) { if (message) this.compose({ replyToCommEventId: message.communicationEventId, replyToSender: 'true' }); },
        forward(message) { if (message && message.store === 'email') this.compose({ forwardEmailMessageId: message.emailMessageId }); },
        closeDock(key) { this.docks = this.docks.filter((dock) => dock.key !== key); this.saveDocks(); },
        minimizeDock(key, flag) { const dock = this.docks.find((item) => item.key === key); if (dock) { dock.minimized = flag !== false; this.saveDocks(); } },
        popOutDock(key, flag) { const dock = this.docks.find((item) => item.key === key); if (dock) dock.layout = flag === false ? 'dock' : 'dialog'; },
        saveDocks() {
            try { sessionStorage.setItem('ironstone.inbox.docks', JSON.stringify(this.docks.map((dock) => ({ key: dock.key, query: dock.query, minimized: dock.minimized })))); }
            catch (err) { /* no storage */ }
        },
        restoreDocks() {
            let saved = null;
            try { saved = JSON.parse(sessionStorage.getItem('ironstone.inbox.docks') || 'null'); } catch (err) { saved = null; }
            if (!Array.isArray(saved)) return;
            this.docks = saved.filter((dock) => dock && dock.key).map((dock) => ({ key: dock.key, query: dock.query || {}, minimized: !!dock.minimized, layout: 'dock', title: '' }));
        },
        onComposeSent(key, info) {
            this.closeDock(key);
            const result = info || {};
            const held = result.mode === 'email' && result.statusId === 'ES_SCHEDULED' && result.holdSeconds > 0;
            const scheduled = result.mode === 'email' && result.statusId === 'ES_SCHEDULED' && !held;
            const message = held ? t('Sending…') : (scheduled ? t('Scheduled') + ' ' + this.shortWhen(result.scheduledSendDate) : (result.message || t('Sent')));
            const undo = () => {
                const params = result.mode === 'email' ? { emailMessageId: result.emailMessageId } : { communicationEventIdsJson: JSON.stringify(result.communicationEventIdList || []) };
                moqui.request(this.composeBase() + '/cancelSend', { method: 'POST', params }).then(() => {
                    if (result.mode === 'email') this.compose({ emailMessageId: result.emailMessageId });
                    else if (result.restoreKey) this.compose({ restoreKey: result.restoreKey });
                    this.loadList(true);
                    this.loadData();
                }, moqui.handleAjaxError);
            };
            const canUndo = held || scheduled || (result.mode === 'internal' && (result.communicationEventIdList || []).length);
            if (this.$q.notify) this.$q.notify({ message, timeout: held ? Math.max(4000, result.holdSeconds * 1000) : 8000, position: 'bottom-left', group: false,
                type: result.sendError ? 'warning' : undefined, actions: canUndo ? [{ label: t('Undo'), color: 'yellow', handler: undo }] : [] });
            const wait = held ? (result.holdSeconds + 2) * 1000 : 800;
            setTimeout(() => { this.loadList(true); this.loadData(); if (this.openKey) this.reloadThread(); }, wait);
        },

        // ---- keys ----
        inField() {
            const el = document.activeElement;
            return !!(el && moqui.keymap && moqui.keymap.isText && moqui.keymap.isText(el));
        },
        moveFocus(step, select) {
            if (!this.threads.length) return false;
            let index = this.flatIndex(this.focusKey);
            if (index < 0) index = step > 0 ? -1 : this.threads.length;
            const next = this.threads[Math.min(this.threads.length - 1, Math.max(0, index + step))];
            if (!next) return false;
            if (select) {
                const current = this.threads[index];
                const keys = Object.assign({}, this.selected);
                if (current) keys[current.rowKey] = true;
                keys[next.rowKey] = true;
                this.selected = keys;
            }
            this.focusKey = next.rowKey;
            if (this.openKey && this.splitMode && !select) this.setThreadParam(next.rowKey);
            this.$nextTick(() => {
                const el = document.getElementById('inbox-row-' + next.rowKey.replace(/[^A-Za-z0-9_-]/g, '_'));
                if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' });
            });
            if (index + step >= this.threads.length - 3) this.loadMore();
            return true;
        },
        openFocused() {
            if (this.inField()) return false;
            if (this.selectedKeys.length && !this.focusKey) this.focusKey = this.selectedKeys[0];
            if (!this.focusKey) return false;
            this.setThreadParam(this.focusKey);
            return true;
        },
        backToList() { if (!this.openKey) return false; this.setThreadParam(null); return true; },
        keyRows() {
            if (this.selectedKeys.length) return this.selectionRows;
            if (this.openKey && this.thread) return [this.threadRow()];
            const row = this.threads.find((item) => item.rowKey === this.focusKey);
            return row ? [row] : [];
        },
        keyAction(action) {
            const rows = this.keyRows();
            if (!rows.length) return false;
            if (action === 'trash' && this.params.view === 'trash') action = 'deleteForever';
            if (this.selectedKeys.length) this.bulk(action); else this.applyAction(rows, action);
            return true;
        },
        keyFlag() {
            const rows = this.keyRows();
            if (!rows.length) return false;
            const flag = !rows.every((row) => row.isFlagged);
            this.applyAction(rows, flag ? 'flag' : 'unflag', null, true);
            return true;
        },
        keyMessage() {
            if (!this.thread) return null;
            return this.thread.messageList.find((message) => message.key === this.focusMessageKey) || this.lastMessage;
        },
        keyReply(all) { const message = this.keyMessage(); if (!message) return false; this.reply(message, all); return true; },
        keyForward() { const message = this.keyMessage(); if (!message || message.store !== 'email') return false; this.forward(message); return true; },
        moveMessage(step) {
            if (!this.thread) return false;
            const list = this.thread.messageList;
            const index = list.findIndex((message) => message.key === this.focusMessageKey);
            const next = list[Math.min(list.length - 1, Math.max(0, (index < 0 ? list.length - 1 : index) + step))];
            if (!next) return false;
            this.expand(next);
            this.showOlder = true;
            this.$nextTick(() => {
                const el = document.getElementById('inbox-msg-' + next.key.replace(/[^A-Za-z0-9_-]/g, '_'));
                if (el && el.scrollIntoView) el.scrollIntoView({ block: 'start', behavior: 'smooth' });
            });
            return true;
        },
        archiveAndMove(step) {
            if (!this.openKey) return false;
            const next = this.neighbourKey(this.openKey, step);
            const row = this.threadRow();
            this.applyAction([row], 'archive').then(() => { if (next) this.setThreadParam(next); });
            return true;
        },
        toggleSelectFocused() {
            const row = this.threads.find((item) => item.rowKey === this.focusKey);
            if (!row) return false;
            this.checkRow(row, !this.selected[row.rowKey]);
            return true;
        },
        registerKeys() {
            if (!moqui.keymap || !moqui.keymap.registerScope) return;
            const key = (keys, label, run, action) => ({ keys, label, action: action || keys, run: (event) => run(event) !== false });
            this.unregisterKeys = moqui.keymap.registerScope('Inbox', [
                key('j', t('Next conversation'), () => this.moveFocus(1)),
                key('k', t('Previous conversation'), () => this.moveFocus(-1)),
                key('o', t('Open the conversation'), () => this.openFocused()),
                key('Enter', t('Open the conversation'), () => this.openFocused(), 'openEnter'),
                key('u', t('Back to the list'), () => this.backToList()),
                key('e', t('Archive'), () => this.keyAction('archive')),
                key('#', t('Delete'), () => this.keyAction('trash')),
                key('!', t('Report spam'), () => this.keyAction('spam')),
                key('r', t('Reply'), () => this.keyReply(false)),
                key('a', t('Reply all'), () => this.keyReply(true)),
                key('f', t('Forward'), () => this.keyForward()),
                key('s', t('Flag'), () => this.keyFlag()),
                key('b', t('Snooze'), () => { const rows = this.keyRows(); if (!rows.length) return false; this.openSnooze(rows); return true; }),
                key('l', t('Labels'), () => { const rows = this.keyRows(); if (!rows.length) return false; this.openLabels(rows); return true; }),
                key('v', t('Move to'), () => { const rows = this.keyRows(); if (!rows.length) return false; this.openMove(rows); return true; }),
                key('Shift+I', t('Mark read'), () => this.keyAction('read')),
                key('Shift+U', t('Mark unread'), () => this.keyAction('unread')),
                key('x', t('Select the conversation'), () => this.toggleSelectFocused()),
                key('* a', t('Select all'), () => { this.toggleAll(); if (!this.selectedKeys.length) this.toggleAll(); return true; }),
                key('* n', t('Select none'), () => { this.clearSelection(); return true; }),
                key('Shift+J', t('Select and go down'), () => this.moveFocus(1, true)),
                key('Shift+K', t('Select and go up'), () => this.moveFocus(-1, true)),
                key('n', t('Next message in the conversation'), () => this.moveMessage(1)),
                key('p', t('Previous message in the conversation'), () => this.moveMessage(-1)),
                key('c', t('Compose'), () => this.compose()),
                key('/', t('Search'), () => this.focusSearch()),
                key('z', t('Undo'), () => this.undo()),
                key(']', t('Archive and open the next'), () => this.archiveAndMove(1)),
                key('[', t('Archive and open the previous'), () => this.archiveAndMove(-1)),
                key('g i', t('Go to the Inbox'), () => { this.openView({ view: 'inbox' }); return true; }),
                key('g s', t('Go to Flagged'), () => { this.openView({ view: 'flagged' }); return true; }),
                key('g t', t('Go to Sent'), () => { this.openView({ view: 'sent' }); return true; }),
                key('g d', t('Go to Drafts'), () => { this.openView({ view: 'drafts' }); return true; }),
                key('g a', t('Go to All mail'), () => { this.openView({ view: 'all' }); return true; }),
                key('g m', t('Go to internal messages'), () => { this.openView({ view: 'internal' }); return true; }),
                key('g l', t('Go to a folder, label or mailbox'), () => { this.goto = { open: true, filter: '' }; return true; }),
                key('Ctrl+Left', t('Focus the folders'), () => { if (this.inField()) return false; const el = this.$el.querySelector('.q-item'); if (el) el.focus(); return true; }),
                key('Ctrl+Right', t('Focus the reading pane'), () => { if (this.inField() || !this.$refs.pane) return false; this.$refs.pane.setAttribute('tabindex', '-1'); this.$refs.pane.focus(); return true; })
            ]);
        },
        domId(prefix, key) { return prefix + String(key || '').replace(/[^A-Za-z0-9_-]/g, '_'); },
        // a confirmation (Quasar's Dialog plugin): resolves on OK; Cancel, Esc or a click outside resolves nothing
        confirm(title, message, okLabel, danger) {
            return new Promise((resolve) => {
                this.$q.dialog({ title, message, ok: { label: okLabel || t('OK'), color: danger ? 'negative' : 'primary', unelevated: true, noCaps: true },
                    cancel: { label: t('Cancel'), flat: true, noCaps: true } }).onOk(() => resolve());
            });
        },
        gotoFirst() { const first = this.gotoTargets[0]; if (first) { this.goto.open = false; this.openView(first.params); } },
        onShift(event) { this.shiftDown = !!event.shiftKey; },

        // ---- dates ----
        shortDate(millis) {
            if (!millis) return '';
            const d = new Date(Number(millis));
            const now = new Date();
            if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
            if (d.getFullYear() === now.getFullYear()) return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
            return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
        },
        fullDate(millis) {
            if (!millis) return '';
            const d = new Date(Number(millis));
            const minutes = Math.round((Date.now() - d.getTime()) / 60000);
            let ago = '';
            if (minutes >= 0 && minutes < 60) ago = minutes <= 1 ? t('just now') : minutes + ' ' + t('min ago');
            else if (minutes >= 60 && minutes < 24 * 60) ago = Math.round(minutes / 60) + ' ' + t('h ago');
            const text = d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) + ', ' + d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
            return ago ? text + ' (' + ago + ')' : text;
        },
        longDate(millis) { return millis ? new Date(Number(millis)).toLocaleString(undefined, { dateStyle: 'full', timeStyle: 'short' }) : ''; }
    },
    mounted() {
        this.restoreDocks();
        this.measure();
        this.onResize = () => this.measure();
        window.addEventListener('resize', this.onResize);
        document.addEventListener('keydown', this.onShift, true);
        document.addEventListener('keyup', this.onShift, true);
        this.registerKeys();
        this.loadData().then(() => this.$nextTick(() => this.measure()));
        this.applyParams();
        setTimeout(() => this.measure(), 300);
    },
    beforeUnmount() {
        window.removeEventListener('resize', this.onResize);
        document.removeEventListener('keydown', this.onShift, true);
        document.removeEventListener('keyup', this.onShift, true);
        if (this.unregisterKeys) this.unregisterKeys();
        if (this.markReadTimer) clearTimeout(this.markReadTimer);
        if (this.countsTimer) clearTimeout(this.countsTimer);
    }
};
</script>
<style>
/* the end column of a thread row: the date and the hover actions share one fixed width, so the row never shifts on hover —
   the actions fade in over the date (opacity only, no layout change) */
.m-inbox-root .m-inbox-row-end { position:relative; width:112px; height:24px; flex:none; }
.m-inbox-root .m-inbox-row-end-date, .m-inbox-root .m-inbox-row-end-actions { position:absolute; right:0; top:0; bottom:0; }
.m-inbox-root .m-inbox-row-end-date { transition:opacity 120ms ease-out; }
.m-inbox-root .m-inbox-row-end-date.m-inbox-hidden { opacity:0; }
.m-inbox-root .m-inbox-row-end-actions { opacity:0; pointer-events:none; transition:opacity 120ms ease-out; }
.m-inbox-root .m-inbox-row-end-actions.m-inbox-shown { opacity:1; pointer-events:auto; }
</style>
