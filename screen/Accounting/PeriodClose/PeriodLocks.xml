<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Posting locks" default-menu-index="2" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="lock">
        <actions>
            <service-call name="mantle.ledger.CloseServices.store#Lock" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="exception">
        <actions>
            <service-call name="mantle.ledger.CloseServices.grant#Exception" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="Object.assign({},context,{kind:'locks'})" out-map="context" />
        <set field="recordsCount" from="recordCount" />
        <script>const dateLabels=ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js')
records = dateLabels.formatDates(records,[["lastUpdatedStamp", "yyyy-MM-dd HH:mm"]])</script>
    </actions>
    <widgets>
        <label text="Posting locks" type="h5" />
        <form-single name="Find" transition="." map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="text">
                <default-field title="Search">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Find" type="primary" />
                </default-field>
            </field>
        </form-single>
        <form-list name="Records" list="records" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="accountingLockId">
                <default-field title="Record">
                    <display />
                </default-field>
            </field>
            <field name="changeReason">
                <default-field title="Name">
                    <display />
                </default-field>
            </field>
            <field name="lastUpdatedStamp">
                <default-field title="Updated">
                    <display text="${lastUpdatedStampText}" />
                </default-field>
            </field>
            <field name="lockScope">
                <default-field title="Scope">
                    <display />
                </default-field>
            </field>
            <field name="lockThroughDate">
                <default-field title="Lock through">
                    <display />
                </default-field>
            </field>
            <field name="isHard">
                <default-field title="Hard">
                    <display />
                </default-field>
            </field>
            <field name="lockActions">
                <default-field title="Actions">
                    <container-dialog id="Editpostinglock" button-text="Edit lock" condition="(accounting.capabilities.admin) &amp;&amp; accounting.capabilities.admin">
                        <form-single name="EditLock" transition="lock" map="context">
                            <field name="accountingLockId" from="accountingLockId">
                                <default-field title="Lock">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                <default-field title="Revision">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="organizationPartyId" from="organizationPartyId">
                                <default-field title="Organization party id">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="lockScope">
                                <default-field title="Scope">
                                    <drop-down allow-empty="true">
                                        <option key="all" text="All" />
                                        <option key="sales" text="Sales" />
                                        <option key="purchases" text="Purchases" />
                                        <option key="tax" text="Tax" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="lockThroughDate">
                                <default-field title="Lock through">
                                    <date-time type="date" />
                                </default-field>
                            </field>
                            <field name="isHard">
                                <default-field title="Hard lock">
                                    <drop-down allow-empty="true">
                                        <option key="N" text="No" />
                                        <option key="Y" text="Yes" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="Submit">
                                    <submit text="Save lock" type="primary" />
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="accountingLockId" />
                    <field-ref name="changeReason" />
                </column>
                <column>
                    <field-ref name="lastUpdatedStamp" />
                    <field-ref name="lockActions" />
                </column>
            </columns>
        </form-list>
        <label text="No matching records. Adjust the organization or filters." type="p" condition="!records.length" />
        <container-dialog id="Addpostinglock" button-text="Add posting lock" condition="(accounting.capabilities.admin) &amp;&amp; accounting.capabilities.admin">
            <form-single name="PostingLock" transition="lock" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="lockScope">
                    <default-field title="Scope">
                        <drop-down allow-empty="true">
                            <option key="all" text="All" />
                            <option key="sales" text="Sales" />
                            <option key="purchases" text="Purchases" />
                            <option key="tax" text="Tax" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="lockThroughDate">
                    <default-field title="Lock through">
                        <date-time type="date" />
                    </default-field>
                </field>
                <field name="isHard">
                    <default-field title="Hard lock">
                        <drop-down allow-empty="true">
                            <option key="N" text="No" />
                            <option key="Y" text="Yes" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Save lock" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <container-dialog id="Grantsoftlockexception" button-text="Grant soft-lock exception" condition="(accounting.capabilities.admin) &amp;&amp; accounting.capabilities.admin">
            <form-single name="LockException" transition="exception" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="accountingLockId">
                    <default-field title="Soft lock">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'locks',organizationPartyId:organizationPartyId,selected:accountingLockId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="userId">
                    <default-field title="User">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'users',organizationPartyId:organizationPartyId,selected:userId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="userGroupId">
                    <default-field title="Group">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'groups',organizationPartyId:organizationPartyId,selected:userGroupId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="acctgTransId">
                    <default-field title="Entry (optional)">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'journals',organizationPartyId:organizationPartyId,selected:acctgTransId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="thruDate">
                    <default-field title="Expires">
                        <date-time />
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Grant exception" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
    </widgets>
</screen>
