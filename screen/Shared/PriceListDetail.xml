<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Price list" default-menu-index="1">
    <parameter name="appRoot" />
    <parameter name="priceListId" />
    <parameter name="asOfDate" />
    <parameter name="includeHistory" />
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="sharedMountContext"/>
        <script>if(!sharedMountContext.capabilities.read)throw new Error('Catalog read access is required')</script>
        <set field="appRoot" from="sharedMountContext.appRoot"/>
        <set field="sharedLinks" from="sharedMountContext.sharedLinks"/>
        <set field="printBase" from="sharedMountContext.printBase"/>
    </always-actions>
    <transition name="store">
        <actions>
            <service-call name="ironstone.products.PriceListServices.store#ProductPriceList" in-map="context" out-map="saved" />
        </actions>
        <default-response url=".">
            <parameter name="priceListId" from="saved.priceListId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="rule">
        <actions>
            <service-call name="ironstone.products.PriceListServices.store#ProductPriceRule" in-map="context" />
        </actions>
        <default-response url=".">
            <parameter name="priceListId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="publish">
        <actions>
            <service-call name="ironstone.products.PriceListServices.publish#ProductPriceList" in-map="context" />
        </actions>
        <default-response url=".">
            <parameter name="priceListId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="retire">
        <actions>
            <service-call name="ironstone.products.PriceListServices.retire#ProductPriceList" in-map="context" />
        </actions>
        <default-response url=".">
            <parameter name="priceListId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <set field="includeHistory" from="sri.getRenderMode() === 'html-print' ? false : includeHistory" />
        <service-call name="ironstone.products.PriceListServices.get#PriceListOptions" out-map="context" />
        <service-call name="ironstone.products.PriceListServices.get#PriceListDetail" in-map="context" out-map="context" />
        <set field="ruleEdits" from="priceRuleRows.map(r =&gt; Object.assign({},r,{expectedLastUpdatedStamp:r.lastUpdatedStamp,fromDate:null}))" />
        <set field="header" from="Object.assign({},successor,{fromDate:null,expectedLastUpdatedStamp:priceList.lastUpdatedStamp,priority:String(priceList.priority || 0)})" />
