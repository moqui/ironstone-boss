<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Identifiers" default-menu-index="4">
    <transition name="storeRow">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#CatalogRow" in-map="Object.assign({},context,{kind:'identifier'})"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="storeOther">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#CatalogRow" in-map="Object.assign({},context,{kind:'otherIdentifier'})"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="assignGenerated">
        <actions>
            <service-call name="ironstone.products.CatalogServices.get#SharedContext" in-map="{appRoot:appRoot}" out-map="identifierAppAccess"/>
            <script>if(!identifierAppAccess.capabilities.catalogEdit)throw new Error('Catalog edit access is required')</script>
            <service-call name="mantle.product.ProductServices.validate#ProductIdentifier" in-map="{productId:productId,productIdTypeEnumId:previewIdentifierType,generate:true,forAssignment:true}" out-map="checked"/>
            <script>if(!checked.valid || checked.generatedValue!==previewValue)throw new Error('Identifier policy or value changed; preview again')</script>
            <service-call name="mantle.product.ProductServices.store#ProductIdentifier" in-map="{productId:productId,productIdTypeEnumId:previewIdentifierType,idValue:checked.generatedValue,changeReason:'Confirmed generated identifier'}"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <condition>
        <expression>!Array.isArray(product360Tabs) || product360Tabs.includes('Identifiers')</expression>
    </condition>
    <actions>
        <script>if (previewIdentifierType) identifierPreview=ec.service.sync().name('mantle.product.ProductServices.validate#ProductIdentifier').parameters({productId:productId,productIdTypeEnumId:previewIdentifierType,generate:true,forAssignment:true}).call()</script>
    </actions>
    <widgets>
        <section name="RowsAvailable" condition="productFound">
            <widgets>
                <container-box>
                    <box-header title="Identifiers"/>
                    <box-body>
                        <form-list name="IdentifiersRows" list="detail.identifierRows" skip-form="true" paginate="false">
                            <field name="productIdTypeEnumId">
                                <header-field title="Type"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="idValue">
                                <header-field title="Value"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="rowActions">
                                <default-field title="">
                                    <container-dialog condition="canEdit" id="EditIdentifiers" button-text="Edit" icon="sym_o_edit" title="Edit identifier" width="640">
                                        <form-single name="EditIdentifiers" transition="storeRow">
                                            <field name="productId">
                                                <default-field>
                                                    <hidden/>
                                                </default-field>
                                            </field>
                                            <field name="productIdTypeEnumId">
                                                <default-field>
                                                    <hidden/>
                                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                                </default-field>
                                            </field>
                                            <field name="idValue">
                                                <default-field title="Value">
                                                    <text-line/>
                                                </default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Save">
                                                    <submit/>
                                                </default-field>
                                            </field>
                                        </form-single>
                                    </container-dialog>
                                </default-field>
                            </field>
                        </form-list>
                        <section name="IdentifiersEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddIdentifiers" button-text="Add identifier" icon="sym_o_add" title="Add an identifier" width="640">
                                    <form-single name="AddIdentifiers" transition="storeRow">
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productIdTypeEnumId">
                                            <default-field title="Type">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.idTypes" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="idValue">
                                            <default-field title="Value">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section>
                        <container-box>
                            <box-header title="Scoped identifiers"/>
                            <box-body>
                                <form-list name="OtherIdentifiers" list="detail.otherIdentifierRows" skip-form="true" paginate="false">
                                    <field name="productIdTypeEnumId">
                                        <header-field title="Type"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="idValue">
                                        <header-field title="Value"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="productStoreId">
                                        <header-field title="Store"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="marketSegmentId">
                                        <header-field title="Market segment"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="rowActions">
                                        <default-field title="">
                                            <container-dialog condition="canEdit" id="EditOther" button-text="Edit" icon="sym_o_edit" title="Scoped identifier" width="640">
                                                <form-single name="OtherIdentifications" transition="storeOther">
                                                    <field name="productId">
                                                        <default-field>
                                                        <hidden/>
                                                        </default-field>
                                                    </field>
                                                    <field name="productOtherIdentId">
                                                        <default-field title="ID">
                                                        <hidden/>
                                                        </default-field>
                                                    </field>
                                                    <field name="productIdTypeEnumId">
                                                        <default-field title="Type">
                                                        <drop-down allow-empty="true">
                                                        <list-options list="options.idTypes" key="${value}" text="${label}"/>
                                                        </drop-down>
                                                        </default-field>
                                                    </field>
                                                    <field name="idValue">
                                                        <default-field title="Value">
                                                        <text-line/>
                                                        </default-field>
                                                    </field>
                                                    <field name="productStoreId">
                                                        <default-field title="Store">
                                                        <text-line/>
                                                        </default-field>
                                                    </field>
                                                    <field name="marketSegmentId">
                                                        <default-field title="Market segment">
                                                        <text-line/>
                                                        </default-field>
                                                    </field>
                                                    <field name="submitButton">
                                                        <default-field title="Save">
                                                        <submit/>
                                                        </default-field>
                                                    </field>
                                                </form-single>
                                            </container-dialog>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column><field-ref name="productIdTypeEnumId"/></column>
                                        <column><field-ref name="idValue"/></column>
                                    </columns>
                                </form-list>
                                <section name="OtherEditor" condition="canEdit">
                                    <widgets>
                                        <container-dialog id="AddOtherId" button-text="Add scoped ID" title="Scoped identifier" width="640">
                                            <form-single name="AddOtherIdentification" transition="storeOther">
                                                <field name="productId">
                                                    <default-field>
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="productOtherIdentId">
                                                    <default-field title="ID">
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="productIdTypeEnumId">
                                                    <default-field title="Type">
                                                        <drop-down allow-empty="true">
                                                            <list-options list="options.idTypes" key="${value}" text="${label}"/>
                                                        </drop-down>
                                                    </default-field>
                                                </field>
                                                <field name="idValue">
                                                    <default-field title="Value">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="productStoreId">
                                                    <default-field title="Store">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="marketSegmentId">
                                                    <default-field title="Market segment">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="submitButton">
                                                    <default-field title="Save">
                                                        <submit/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </container-dialog>
                                    </widgets>
                                </section>
                            </box-body>
                        </container-box>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="GeneratedIdentifier" condition="productFound &amp;&amp; canEdit">
            <widgets>
                <label text="Generate an internal identifier" type="h6"/>
                <form-single name="GenerateIdentifierPreview" transition=".">
                    <field name="productId">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="previewIdentifierType">
                        <default-field title="Identifier type">
                            <drop-down allow-empty="false">
                                <list-options list="options.idTypes" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Preview generated code">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
                <section name="GeneratedPreview" condition="!!identifierPreview">
                    <widgets>
                        <label text="${identifierPreview.normalizedValue}: ${identifierPreview.valid ? 'Ready to assign' : identifierPreview.issues.join('; ')}" type="p"/>
                        <section name="ConfirmGenerated" condition="identifierPreview.valid">
                            <widgets>
                                <form-single name="AssignGeneratedIdentifier" transition="assignGenerated">
                                    <field name="productId">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="previewIdentifierType">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="previewValue" from="identifierPreview.generatedValue">
                                        <default-field>
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="submitButton">
                                        <default-field title="Assign this generated code">
                                            <submit confirmation="Assign this code to the product?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </widgets>
                        </section>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
