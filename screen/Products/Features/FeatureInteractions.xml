<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Interactions" default-menu-index="3">
    <parameter name="productFeatureId"/>
    <parameter name="productId"/>
    <parameter name="productFeatureIds"/>
    <transition-include name="choices" location="component://mr-boss/template/CatalogChoiceTransitions.xml"/>
    <transition name="saveInteraction">
        <actions>
            <service-call name="ironstone.products.FeatureServices.store#FeatureInteraction" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="preview">
        <default-response url=".">
            <parameter name="productId"/>
            <parameter name="productFeatureIds"/>
        </default-response>
    </transition>
    <actions>
        <service-call name="ironstone.products.CatalogServices.get#CatalogAccess" out-map="access"/>
        <service-call name="ironstone.products.FeatureServices.get#FeatureOptions" out-map="context"/>
        <service-call name="ironstone.products.FeatureServices.find#FeatureInteractions" in-map="context" out-map="context"/>
        <set field="canEdit" from="access.capabilities.catalogEdit"/>
        <if condition="productId &amp;&amp; productFeatureIds">
            <service-call name="ironstone.products.FeatureServices.preview#FeatureInteractions" in-map="context" out-map="preview"/>
        </if>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Feature interactions"/>
            <box-body>
                <form-list name="Interactions" list="rows" skip-form="true" paginate="false">
                    <field name="productFeatureId">
                        <header-field title="Feature"/>
                        <default-field>
                            <link url="//Products/Features/FeatureDetail" text="${productFeatureId}" parameter-map="{productFeatureId:productFeatureId}" link-type="anchor"/>
                        </default-field>
                    </field>
                    <field name="toProductFeatureId">
                        <header-field title="Related feature"/>
                        <default-field>
                            <link url="//Products/Features/FeatureDetail" text="${toProductFeatureId}" parameter-map="{productFeatureId:toProductFeatureId}" link-type="anchor"/>
                        </default-field>
                    </field>
                    <field name="iactnTypeEnumId">
                        <header-field title="Interaction"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="productId">
                        <header-field title="Product scope"/>
                        <default-field>
                            <link url="//Products/Products/Product360" text="${productId}" parameter-map="{productId:productId}" link-type="anchor"/>
                        </default-field>
                    </field>
                    <field name="quantity">
                        <header-field title="Quantity"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                    <field name="amount">
                        <header-field title="Amount"/>
                        <default-field>
                            <display/>
                        </default-field>
                    </field>
                </form-list>
                <section name="InteractionEditor" condition="canEdit">
                    <widgets>
                        <container-dialog id="NewInteraction" button-text="Add rule" title="One rule per feature pair" width="640">
                            <form-single name="Interaction" transition="saveInteraction">
                                <field name="productFeatureId">
                                    <default-field title="Feature">
                                        <drop-down allow-empty="true">
                                            <list-options list="options.features" key="${value}" text="${label}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="toProductFeatureId">
                                    <default-field title="Related feature">
                                        <drop-down allow-empty="true">
                                            <list-options list="options.features" key="${value}" text="${label}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="iactnTypeEnumId">
                                    <default-field title="Interaction">
                                        <drop-down allow-empty="true">
                                            <list-options list="options.interactionTypes" key="${value}" text="${label}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="productId">
                                    <default-field title="Product scope" tooltip="Leave empty for a rule on every product">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'products',selected:productId}"/>
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="quantity">
                                    <default-field>
                                        <text-line input-type="number"/>
                                    </default-field>
                                </field>
                                <field name="amount">
                                    <default-field>
                                        <text-line input-type="number"/>
                                    </default-field>
                                </field>
                                <field name="submitButton">
                                    <default-field title="Save">
                                        <submit/>
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                        <section-iterate name="InteractionRows" list="rows" entry="entry">
                            <widgets>
                                <container-dialog id="EditInteraction_${entry_index}" button-text="Edit ${entry.productFeatureId} → ${entry.toProductFeatureId}" title="Edit feature rule" width="640">
                                    <form-single name="EditInteraction" transition="saveInteraction" map="entry">
                                        <field name="productFeatureId">
                                            <default-field>
                                                <hidden/>
                                                <display/>
                                            </default-field>
                                        </field>
                                        <field name="toProductFeatureId">
                                            <default-field>
                                                <hidden/>
                                                <display/>
                                            </default-field>
                                        </field>
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                                <display/>
                                            </default-field>
                                        </field>
                                        <field name="iactnTypeEnumId">
                                            <default-field title="Interaction">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.interactionTypes" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="quantity">
                                            <default-field>
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="amount">
                                            <default-field>
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                            </widgets>
                        </section-iterate>
                    </widgets>
                </section>
            </box-body>
        </container-box>
        <container-box>
            <box-header title="Preview selection"/>
            <box-body>
                <form-single name="InteractionPreview" transition="preview">
                    <field name="productId">
                        <default-field title="Product">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'products',selected:productId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="productFeatureIds">
                        <default-field title="Selected features">
                            <drop-down allow-empty="true" allow-multiple="true">
                                <list-options list="options.features" key="${value}" text="${label}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Preview">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
                <section name="PreviewResults" condition="preview">
                    <widgets>
                        <label text="${preview.valid ? 'Selection is valid' : 'Selection has conflicts'}" type="p"/>
                        <form-list name="InteractionIssues" list="preview ? preview.issues : []" skip-form="true" paginate="false">
                            <field name="rule">
                                <header-field title="Rule"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="message">
                                <header-field title="Issue"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                        </form-list>
                    </widgets>
                </section>
            </box-body>
        </container-box>
    </widgets>
</screen>
