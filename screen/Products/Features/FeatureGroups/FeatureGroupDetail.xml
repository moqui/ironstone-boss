<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Feature group" default-menu-include="false">
    <parameter name="productFeatureGroupId" required="true"/>
    <always-actions>
        <service-call name="ironstone.products.CatalogServices.get#CatalogRecord" in-map="{recordEntityName:'mantle.product.feature.ProductFeatureGroup',recordId:productFeatureGroupId,checkOnly:true}" out-map="catalog"/>
        <set field="recordFound" from="!!catalog.record"/>
        <if condition="recordFound">
            <service-call name="ironstone.products.FeatureServices.get#FeatureGroupDetail" in-map="context" out-map="context"/>
            <service-call name="ironstone.products.FeatureServices.get#FeatureOptions" out-map="context"/>
            <set field="master" from="detail.master"/>
            <set field="canEdit" from="detail.canEdit"/>
        </if>
    </always-actions>
    <transition name="save">
        <actions>
            <service-call name="ironstone.products.FeatureServices.store#FeatureGroup" in-map="context"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="delete">
        <actions>
            <service-call name="ironstone.products.FeatureServices.delete#UnusedFeatureGroup" in-map="context"/>
        </actions>
        <default-response url="../List"/>
        <error-response url="."/>
    </transition>
    <subscreens default-item="Summary"/>
    <actions>
        <if condition="recordFound">
            <!-- the header's facts: the type and the owner by name -->
            <entity-find-one entity-name="mantle.party.Organization" value-field="ownerOrganization" cache="true">
                <field-map field-name="partyId" from="master.ownerPartyId"/>
            </entity-find-one>
            <set field="factsText" from="[master.ownerPartyId === '_NA_' || !master.ownerPartyId ? ec.l10n.localize('Shared catalog') : (ownerOrganization?.organizationName || master.ownerPartyId)].filter(Boolean).join(' · ')"/>
        </if>
    </actions>
    <widgets>
        <section name="Record" condition="recordFound">
            <widgets>
                <context record-entity="mantle.product.feature.ProductFeatureGroup" record-id="${productFeatureGroupId}" title="${master.description}"/>
                <!-- the header card (style-guide §3.3): the ID and name, then the type and owner with the actions at their right -->
                <container style="m-record-header">
                    <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                        <container style="col-12 col-md m-record-title">
                            <container style="row items-center no-wrap">
                                <render-mode>
                                    <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none q-mr-sm text-mono">${WebUtilities.encodeHtml(productFeatureGroupId)}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: productFeatureGroupId})}]]></text>
                                </render-mode>
                                <label text="${master.description}" type="h5"/>
                            </container>
                            <label text="${factsText}" type="p" style="text-caption m-muted q-mb-none"/>
                        </container>
                        <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions">
                            <button-menu text="More" icon="more_horiz" condition="canEdit">
                                <link url="delete" text="Delete unused group" link-type="hidden-form-link" icon="sym_o_delete" btn-type="danger"
                                        confirmation="Delete the unused feature group ${master.description}?" parameter-map="{productFeatureGroupId:productFeatureGroupId}"/>
                            </button-menu>
                        </container>
                    </container>
                </container>
                <subscreens-panel id="FeatureGroupTabs" type="tab"/>
            </widgets>
        </section>
        <section name="Unavailable" condition="!recordFound">
            <widgets>
                <container-box type="warning">
                    <box-header title="Not available"/>
                    <box-body>
                        <label text="This feature group is not available: it does not exist, or it belongs to an organization you are not in." type="p"/>
                        <link url=".." text="Back to the list" link-type="anchor"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
