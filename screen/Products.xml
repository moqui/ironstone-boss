<!-- Products catalog workspace; services enforce owner and action capabilities (impl-products P1). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Products" menu-image="sym_o_inventory_2" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Products"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
    </subscreens>

    <shell-providers>
        <quick-create kind="category" label="Category" icon="sym_o_category" screen="Products/Categories/NewCategory" sequence="86"/>
        <quick-create kind="feature" label="Feature" icon="sym_o_style" screen="Products/Features/NewFeature" sequence="87"/>
        <quick-create kind="product" label="Product" icon="sym_o_inventory_2" screen="Products/Products/NewProduct" sequence="85"/>
        <palette-source group="Products" label="Products" icon="sym_o_inventory_2" service="ironstone.products.CatalogServices.search#Catalog" sequence="46"/>
        <palette-type doc-type="MantleProduct"/>
        <palette-source group="Products" label="Product identifiers" icon="sym_o_inventory_2" prefix="#"
                service="ironstone.products.CatalogServices.search#ProductIds" sequence="45"/>
        <notification-topic topic="ProductPriceChanged"/><notification-topic topic="ProductPriceExpiring"/><keymap scope="products">
            <key keys="g p" label="Products" screen="Products/Products"/>
            <key keys="g c" label="Categories" screen="Products/Categories"/>
            <key keys="g f" label="Features" screen="Products/Features"/>
        </keymap>
    </shell-providers>
    <widgets><subscreens-panel id="products-panel" type="popup"/></widgets>
</screen>
