<!-- A new draft invoice, from quick create or the list (template/AccountingDocuments.xml DraftDocument). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="New invoice"
        default-menu-index="1"
        default-menu-include="false"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="createDraft" location="component://mr-boss/template/AccountingDocuments.xml"/>
    <actions>
        <set field="documentKind" value="invoices"/>
        <set field="documentLabel" value="invoice"/>
        <set field="counterpartyTitle" value="Customer"/>
        <set field="askAmount" from="false"/>
    </actions>
    <widgets>
        <section-include name="DraftDocument" location="component://mr-boss/template/AccountingDocuments.xml"/>
    </widgets>
</screen>
