<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Home" default-menu-index="1" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <actions>
        <service-call name="ironstone.accounting.HomeServices.get#Summary" in-map="context" out-map="context" />
    </actions>
    <widgets>
        <label text="Accounting workspace" type="h5" />
        <form-single name="Organization" transition="selectOrganization" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'allOrganizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Choose organization" type="primary" />
                </default-field>
            </field>
        </form-single>
        <dashboard min-width="150">
            <number-card title="Unposted entries" value="${summary.unposted == null ? '—' : String(summary.unposted)}" link="//Accounting/GeneralLedger/JournalEntries?isPosted=N&amp;organizationPartyId=${encodeURIComponent(organizationPartyId || '')}" condition="accounting.capabilities.reportRead || accounting.capabilities.glPost" />
            <number-card title="Posted entries" value="${summary.posted == null ? '—' : String(summary.posted)}" link="//Accounting/GeneralLedger/JournalEntries?isPosted=Y&amp;organizationPartyId=${encodeURIComponent(organizationPartyId || '')}" condition="accounting.capabilities.reportRead || accounting.capabilities.glPost" />
            <number-card title="Chart accounts" value="${summary.accounts == null ? '—' : String(summary.accounts)}" link="//Accounting/GeneralLedger/ChartOfAccounts?&amp;organizationPartyId=${encodeURIComponent(organizationPartyId || '')}" condition="accounting.capabilities.reportRead || accounting.capabilities.glPost" />
            <number-card title="Fiscal periods" value="${summary.periods == null ? '—' : String(summary.periods)}" link="//Accounting/PeriodClose/Periods?&amp;organizationPartyId=${encodeURIComponent(organizationPartyId || '')}" condition="accounting.capabilities.glPost || accounting.capabilities.fiscalClose" />
            <number-card title="Receivables due" value="—" />
            <number-card title="Payables due" value="—" />
            <number-card title="Unmatched bank lines" value="—" />
        </dashboard>
        <label text="As of ${summary.asOf}" type="p" style="text-caption m-muted" />
        <label text="Later finance queues become available as their workflows are enabled." type="p" />
        <link url="//Accounting/Settings/Settings" text="Review accounting setup" link-type="anchor-button" btn-type="primary" condition="accounting.capabilities.admin" />
        <link url="//Accounting/GeneralLedger/JournalEntries" text="Journal entries" link-type="anchor-button" condition="accounting.capabilities.glPost || accounting.capabilities.reportRead" />
        <section-iterate name="SetupFindings" list="findings" entry="finding">
            <widgets>
                <label text="${finding}" type="p" />
            </widgets>
        </section-iterate>
        <label text="My finance work" type="h6" />
        <label text="No finance work sources are enabled yet." type="p" />
    </widgets>
</screen>
