<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Settings" default-menu-index="1" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Preferences" in-map="{organizationPartyId:organizationPartyId}" out-map="readiness" />
        <set from="readiness?.findings || []" field="readinessFindings" />
        <set from="(readinessFindings || []).length" field="readinessFindingsCount" />
        <set from="readinessFindingsCount || 1" field="readinessFindingsPageSize" />
        <set from="0" field="readinessFindingsPageIndex" />
        <set from="0" field="readinessFindingsPageMaxIndex" />
        <set from="readinessFindingsCount ? 1 : 0" field="readinessFindingsPageRangeLow" />
        <set from="readinessFindingsCount" field="readinessFindingsPageRangeHigh" />
    </actions>
    <widgets>
        <label text="Accounting settings" type="h5" />
        <form-single name="SelectOrganization" transition="selectOrganization" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'allOrganizations',organizationPartyId:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Choose organization" type="primary" />
                </default-field>
            </field>
        </form-single>
        <label text="Choose an organization before changing finance settings." type="p" />
        <form-list name="Readiness" list="readinessFindings" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="code">
                <default-field title="Check">
                    <display />
                </default-field>
            </field>
            <field name="message">
                <default-field title="Action">
                    <display />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="code" />
                </column>
                <column>
                    <field-ref name="message" />
                </column>
            </columns>
        </form-list>
    </widgets>
</screen>
