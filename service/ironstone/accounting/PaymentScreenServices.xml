    <service verb="save" noun="PaymentDraft" allow-remote="false">
        <description>Create a payment draft from the payment form (mantle.account.PaymentServices.create#PaymentDraft), or
            change the draft paymentId at its sourceVersion (store#PaymentDraft). The chosen methods come as reviewed
            id~version tokens, so Mantle refuses a method changed since the user chose it. Passes nothing else of the
            form.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="paymentId"/>
            <parameter name="sourceVersion"/>
            <parameter name="cashDirection"/>
            <parameter name="partyId"/>
            <parameter name="amount"/>
            <parameter name="currencyUomId"/>
            <parameter name="effectiveDate"/>
            <parameter name="paymentInstrumentEnumId"/>
            <parameter name="organizationMethodToken"/>
            <parameter name="counterpartyMethodToken"/>
            <parameter name="referenceNumber"/>
            <parameter name="comments"/>
            <parameter name="operationKey"/>
        </in-parameters>
        <out-parameters>
            <parameter name="paymentId"/>
            <parameter name="sourceVersion"/>
        </out-parameters>
        <actions>
            <set field="payments" value="component://mr-boss/service/ironstone/accounting/Payments.js"/>
            <set field="draftInput" from="ec.resource.script(payments).execute('draftInput', context)"/>
            <if condition="paymentId &amp;&amp; sourceVersion">
                <then>
                    <service-call name="mantle.account.PaymentServices.store#PaymentDraft" in-map="draftInput"
                            out-map="savedPayment"/>
                </then>
                <else>
                    <service-call name="mantle.account.PaymentServices.create#PaymentDraft" in-map="draftInput"
                            out-map="savedPayment"/>
                </else>
            </if>
            <set field="paymentId" from="savedPayment.paymentId"/>
            <set field="sourceVersion" from="savedPayment.sourceVersion"/>
        </actions>
    </service>
    <service verb="preview" noun="PaymentState" allow-remote="false">
        <description>Review a payment state change (mantle.account.PaymentServices.preview#PaymentState) with the evidence
            files chosen as reviewed id~version tokens.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="paymentId" required="true"/>
            <parameter name="sourceVersion"/>
            <parameter name="action"/>
            <parameter name="settlementDate"/>
            <parameter name="referenceNumber"/>
            <parameter name="reason"/>
            <parameter name="evidenceTokenList" type="Object"/>
        </in-parameters>
        <out-parameters>
            <parameter name="previewId"/>
        </out-parameters>
        <actions>
            <set field="payments" value="component://mr-boss/service/ironstone/accounting/Payments.js"/>
            <service-call name="mantle.account.PaymentServices.preview#PaymentState" out-map="statePreview"
