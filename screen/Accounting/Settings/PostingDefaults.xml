        <label text="Specific asset/product/category and item mappings precede the organization type default; parent organization defaults are inherited." type="p" />
        <form-single name="MappingFilter" transition="." map="context">
            <field name="organizationPartyId" from="organizationPartyId">
                <default-field title="Organization">
                    <hidden />
                </default-field>
            </field>
            <field name="mappingKind">
                <default-field title="Mapping kind">
                    <drop-down>
                        <list-options list="mappingKinds" key="${entry}" text="${entry}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Find">
                    <submit text="Show mappings" />
                </default-field>
            </field>
        </form-single>
        <form-list name="PostingMappings" list="mappingRows" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="mappingKind">
                <default-field title="Kind">
                    <display />
                </default-field>
            </field>
            <field name="mappingKey">
                <default-field title="Type">
                    <display />
                </default-field>
            </field>
            <field name="glAccountId">
                <default-field title="Account">
                    <display-entity entity-name="mantle.ledger.account.GlAccount" text="${accountCode} ${accountName}" />
                </default-field>
            </field>
            <field name="mappingActions">
                <default-field title="Actions">
                    <link parameter-map="{organizationPartyId:organizationPartyId,mappingKind:mappingKind,mappingToken:mappingToken,pageIndex:pageIndex,_openDialog:'Editmapping'}" url="." text="Edit mapping" />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="mappingKind" />
                    <field-ref name="mappingKey" />
                </column>
                <column>
                    <field-ref name="glAccountId" />
                    <field-ref name="mappingActions" />
                </column>
            </columns>
        </form-list>
        <label text="Missing mappings" type="h6" />
