<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Document Settings" default-menu-index="7" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#Preferences" in-map="Object.assign({},context,{settings:context})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Context" in-map="context" out-map="context" />
        <service-call name="ironstone.accounting.DocumentServices.preview#Output" in-map="{organizationPartyId:organizationPartyId,template:settings.invoiceDocumentTemplate}" out-map="context" />
    </actions>
    <widgets>
        <label text="Document Settings" type="h5" />
        <form-single name="SelectOrganization" transition="selectOrganization" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'allOrganizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Choose organization" type="primary" />
                </default-field>
            </field>
        </form-single>
        <form-single name="DocumentDefaults" transition="save" map="settings">
            <field name="organizationPartyId" from="organizationPartyId">
                <default-field title="Organization party id">
                    <hidden />
                </default-field>
            </field>
            <field name="lastUpdatedStamp" from="settings.lastUpdatedStamp">
                <default-field title="Last updated stamp">
                    <hidden />
                </default-field>
            </field>
            <field name="invoiceIdPrefix">
                <default-field title="Invoice prefix">
                    <text-line />
                </default-field>
            </field>
            <field name="invoiceSequenceEnumId">
                <default-field title="Invoice sequence">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'enum:InvoiceSequence',organizationPartyId:organizationPartyId,selected:invoiceSequenceEnumId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="orderIdPrefix">
                <default-field title="Order prefix">
                    <text-line />
                </default-field>
            </field>
            <field name="invoiceDocumentTemplate">
                <default-field title="Invoice layout">
                    <drop-down allow-empty="true">
                        <option key="standard" text="Standard" />
                    </drop-down>
                </default-field>
            </field>
            <field name="paymentDocumentTemplate">
                <default-field title="Payment layout">
                    <drop-down allow-empty="true">
                        <option key="standard" text="Standard" />
                    </drop-down>
                </default-field>
            </field>
            <field name="documentLocale">
                <default-field title="Locale">
                    <text-line />
                </default-field>
            </field>
            <field name="documentFooter">
                <default-field title="Footer">
                    <text-area />
                </default-field>
            </field>
            <field name="changeReason">
                <default-field title="Reason">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Save document defaults" type="primary" />
                </default-field>
            </field>
        </form-single>
        <label text="Document preview" type="h6" />
        <html-view html="${previewHtml}" text="${previewText}" />
    </widgets>
</screen>
