<screen default-menu-title="Accounting" menu-image="sym_o_account_balance" menu-image-type="icon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <always-actions>
        <set field="appRoot" value="Accounting"/>
        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
        <service-call name="ironstone.accounting.AccessServices.get#SharedContext" in-map="{organizationPartyId:organizationPartyId}" out-map="accounting"/>
        <set field="organizationPartyId" from="organizationPartyId || accounting.activeOrganizationPartyId || (accounting.organizationPartyIds.length === 1 ? accounting.organizationPartyIds[0] : null)"/>
    </always-actions>
    <subscreens default-item="Home" always-use-full-path="true">
        <subscreens-item name="Chatter" location="component://mr-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://mr-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
    </subscreens>
    <shell-providers>
        <quick-create kind="accountingNewInvoice" label="Invoice" screen="Accounting/QuickCreate/NewInvoice" icon="sym_o_add" sequence="90"/>
        <quick-create kind="accountingNewBill" label="Bill" screen="Accounting/QuickCreate/NewBill" icon="sym_o_add" sequence="90"/>
        <quick-create kind="accountingNewPayment" label="Payment" screen="Accounting/QuickCreate/NewPayment" icon="sym_o_add" sequence="90"/>
        <quick-create kind="accountingNewEntry" label="Journal entry" screen="Accounting/QuickCreate/NewEntry" icon="sym_o_add" sequence="90"/>
        <palette-source group="Accounting" label="Finance records" service="ironstone.accounting.AccessServices.search#Records" sequence="47"/>
        <palette-type doc-type="MantleInvoice"/><palette-type doc-type="MantlePayment"/>
        <palette-type doc-type="MantleGlAccount"/><palette-type doc-type="MantleAcctgTrans"/>
        <keymap scope="accounting"><key keys="g j" label="Journal entries" screen="Accounting/GeneralLedger/JournalEntries"/><key keys="g a" label="Chart of accounts" screen="Accounting/GeneralLedger/ChartOfAccounts"/></keymap>
    </shell-providers>
    <widgets><subscreens-panel id="accounting-panel" type="popup"/></widgets>
</screen>
