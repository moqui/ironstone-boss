<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Features" default-menu-index="2">
    <transition name="storeFeaturesRows">
        <actions>
            <service-call name="ironstone.products.FeatureServices.store#FeatureRow" in-map="Object.assign({},context,{rowKind:'groupFeature'})"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="Available" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Features"/>
                    <box-body>
                        <form-list name="FeaturesRowsList" list="detail.features" skip-form="true" paginate="false">
                            <field name="productFeatureId">
                                <header-field title="Feature"/>
                                <default-field>
                                    <link url="//Products/Features/FeatureDetail" text="${productFeatureId}" parameter-map="{productFeatureId:productFeatureId}" link-type="anchor"/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <header-field title="Sequence"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                        </form-list>
                        <section name="FeaturesRowsEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddFeaturesRows" button-text="Add" title="FeaturesRows" width="640">
                                    <form-single name="AddFeaturesRows" transition="storeFeaturesRows">
                                        <field name="productFeatureGroupId">
                                            <default-field title="Group">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productFeatureId">
                                            <default-field title="Feature">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.features" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="sequenceNum">
                                            <default-field title="Sequence">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                                <section-iterate name="FeaturesRowsRows" list="detail.features" entry="entry">
                                    <widgets>
                                        <container-dialog id="EditFeaturesRows_${entry_index}" button-text="Edit ${entry.productFeatureId}" title="FeaturesRows" width="640">
                                            <form-single name="EditFeaturesRows" transition="storeFeaturesRows" map="entry">
                                                <field name="productFeatureGroupId">
                                                    <default-field title="Group">
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="productFeatureId">
                                                    <default-field title="Feature">
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="fromDate">
                                                    <default-field title="From">
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="thruDate">
                                                    <default-field title="Through">
                                                        <date-time/>
                                                    </default-field>
                                                </field>
                                                <field name="sequenceNum">
                                                    <default-field title="Sequence">
                                                        <text-line input-type="number"/>
                                                    </default-field>
                                                </field>
                                                <field name="submitButton">
                                                    <default-field title="Save">
                                                        <submit/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </container-dialog>
                                    </widgets>
                                </section-iterate>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
