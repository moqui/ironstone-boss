<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Statements" default-menu-index="3">
    <parameter name="organizationPartyId"/>
    <parameter name="customerPartyId"/>
    <parameter name="snapshotId"/>
    <parameter name="inputFingerprint"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingReceivables.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="previewStatements">
        <actions>
            <service-call name="mantle.account.CollectionServices.preview#Statements" in-map="{organizationPartyId:organizationPartyId,customerPartyIdList:customerPartyId ? [customerPartyId] : null,fromDate:fromDate,asOfDate:asOfDate,currencyUomId:currencyUomId,includeZeroBalance:includeZeroBalance === 'Y'}" out-map="preview"/>
            <set field="snapshotId" from="preview.snapshotId"/>
            <set field="inputFingerprint" from="preview.inputFingerprint"/>
        </actions>
        <default-response url=".">
            <parameter name="snapshotId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="customerPartyId"/>
            <parameter name="inputFingerprint"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <transition name="sendStatements">
        <actions>
            <service-call name="mantle.account.CollectionServices.send#Statements" in-map="{snapshotId:snapshotId,inputFingerprint:inputFingerprint,operationKey:operationKey,toAddresses:toAddresses}" out-map="delivery"/>
            <script><![CDATA[
for (const result of Array.from(delivery.results || [])) {
    const accepted = ['sent','queued'].includes(result.status)
    const outcome = result.status === 'queued' ? 'Queued for delivery' : result.status === 'sent' ? 'Sent' : result.errorMessage || 'Failed'
    ec.message.addMessage((result.recipient || result.customerPartyId || 'Recipient') + ': ' + outcome,
        accepted && !result.errorMessage ? 'success' : 'warning')
}
]]></script>
        </actions>
        <default-response url=".">
            <parameter name="snapshotId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="customerPartyId"/>
            <parameter name="inputFingerprint"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="statementPreview" from="{}"/>
        <if condition="snapshotId">
            <service-call name="mantle.account.CollectionServices.get#StatementPreview" in-map="{snapshotId:snapshotId,organizationPartyId:organizationPartyId}" out-map="statementPreview"/>
        </if>
    </actions>
    <widgets>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <label text="Choose an organization to prepare customer statements." type="p" condition="!organizationPartyId"/>
        <section name="StatementOrganizationChosen" condition="organizationPartyId">
            <widgets>
                <label text="Customer statements" type="h5"/>
                <form-single name="StatementOptions" transition="previewStatements" map="context">
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field title="">
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="customerPartyId">
                        <default-field title="Customer">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'parties',organizationPartyId:organizationPartyId,selected:customerPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="fromDate">
                        <default-field title="From">
                            <date-time type="date"/>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="As of">
                            <date-time type="date"/>
                        </default-field>
                    </field>
                    <field name="currencyUomId">
                        <default-field title="Currency">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId,selected:currencyUomId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="includeZeroBalance">
                        <default-field title="Balances">
                            <check>
                                <option key="Y" text="Include zero balances"/>
                            </check>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Preview statements"/>
                        </default-field>
                    </field>
                </form-single>
                <section name="StatementSnapshot" condition="!!snapshotId">
                    <widgets>
                        <label text="Reviewed statement snapshot" type="h6"/>
                        <section-iterate name="StatementCurrencies" list="statementPreview.statementRows || []" entry="statementRow">
                            <widgets>
                                <container-box>
                                    <box-header title="${statementRow.customerName || statementRow.customerPartyId} · ${statementRow.currencyUomId}"/>
                                    <box-body>
                                        <label text="Opening ${ec.l10n.formatCurrency(statementRow.openingBalance ?? 0, statementRow.currencyUomId)} · Closing ${ec.l10n.formatCurrency(statementRow.closingBalance ?? 0, statementRow.currencyUomId)}" type="p"/>
                                        <label text="Recipients: ${(statementRow.recipients || []).join(', ') || 'Choose a recipient before sending'}" type="p" style="text-caption m-muted"/>
                                        <form-list name="StatementInvoices" list="statementRow.invoiceRows || []" skip-form="true" paginate="false">
                                            <field name="invoiceId">
                                                <default-field title="Invoice">
                                                    <link url="${sharedLinks['Receivables/InvoiceDetail']}" text="${invoiceId}" parameter-map="{recordId:invoiceId,organizationPartyId:organizationPartyId}"/>
                                                </default-field>
                                            </field>
                                            <field name="invoiceDate">
                                                <default-field title="Date">
                                                    <display text="${invoiceDateText || ''}"/>
                                                </default-field>
                                            </field>
                                            <field name="dueDate">
                                                <default-field title="Due">
                                                    <display text="${dueDateText || ''}"/>
                                                </default-field>
                                            </field>
                                            <field name="invoiceTotal" align="right">
                                                <default-field title="Original">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <field name="unpaidTotal" align="right">
                                                <default-field title="Remaining">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <columns type="mobile">
                                                <column>
                                                    <field-ref name="invoiceId"/>
                                                    <field-ref name="dueDate"/>
                                                </column>
                                                <column>
                                                    <field-ref name="invoiceTotal"/>
                                                    <field-ref name="unpaidTotal"/>
                                                </column>
                                            </columns>
                                        </form-list>
                                        <form-list name="StatementReceipts" list="statementRow.paymentRows || []" skip-form="true" paginate="false">
                                            <field name="paymentId">
                                                <default-field title="Receipt">
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="effectiveDateText">
                                                <default-field title="Date">
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="amount" align="right">
                                                <default-field title="Original">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <field name="unappliedTotal" align="right">
                                                <default-field title="Unapplied">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <columns type="mobile">
                                                <column>
                                                    <field-ref name="paymentId"/>
                                                    <field-ref name="effectiveDateText"/>
                                                </column>
                                                <column>
                                                    <field-ref name="unappliedTotal"/>
                                                </column>
                                            </columns>
                                        </form-list>
                                    </box-body>
                                </container-box>
                            </widgets>
                        </section-iterate>
                        <html-view html="${statementPreview.previewHtml || ''}" text="Customer statement snapshot ${snapshotId}"/>
                        <section name="StatementDeliveryResults" condition="(statementPreview.results || []).length">
                            <widgets>
                                <label text="Statement delivery results" type="h6"/>
                                <form-list name="StatementDeliveryResults" list="statementPreview.results" skip-form="true" paginate="false">
                                    <field name="customerPartyId">
                                        <default-field title="Customer">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="currencyUomId">
                                        <default-field title="Currency">
                                            <display-entity entity-name="moqui.basic.Uom"/>
                                        </default-field>
                                    </field>
                                    <field name="recipient">
                                        <default-field title="Recipient">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="status">
                                        <default-field title="Outcome">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="errorMessage">
                                        <default-field title="Failure">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="customerPartyId"/>
                                            <field-ref name="recipient"/>
                                        </column>
                                        <column>
                                            <field-ref name="status"/>
                                            <field-ref name="errorMessage"/>
                                        </column>
                                    </columns>
                                </form-list>
                            </widgets>
                        </section>
                        <link url="${sharedLinks['Receivables/StatementPrint']}" text="Print statements" target-window="_blank" parameter-map="{snapshotId:snapshotId,organizationPartyId:organizationPartyId}"/>
                        <section name="StatementSend" condition="accounting.capabilities.arEdit">
                            <widgets>
                                <form-single name="StatementDelivery" transition="sendStatements">
                                    <field name="organizationPartyId" from="organizationPartyId">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="snapshotId" from="snapshotId">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="inputFingerprint" from="statementPreview.inputFingerprint">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="operationKey" from="'statement-' + ec.user.randomString(24)">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="toAddresses">
                                        <default-field title="Recipient override">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Send reviewed statements" confirmation="Send the reviewed statements?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </widgets>
                        </section>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
