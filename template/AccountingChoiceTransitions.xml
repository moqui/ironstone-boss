<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.accounting.AccessServices.get#Choices" in-map="{choice:choice,term:term,selected:selected,organizationPartyId:organizationPartyId}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.options)</script>
        </actions><default-response type="none"/>
    </transition>
    <transition name="selectOrganization">
        <actions><service-call name="ironstone.accounting.AccessServices.select#Organization" in-map="{organizationPartyId:organizationPartyId}" out-map="context"/></actions>
        <default-response url="."><parameter name="organizationPartyId"/></default-response>
        <error-response url="."/>
    </transition>
</screen>
