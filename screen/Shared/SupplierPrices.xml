                                <container-dialog id="Offer_store_${offer.productPriceId}" button-text="Correct offer ${offer.productPriceId}" title="Correct offer" condition="offer.canCorrect" width="800">
                                    <form-single name="Offerstore_${offer.productPriceId}" transition="store" map="offer">
