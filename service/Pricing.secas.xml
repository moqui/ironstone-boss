<?xml version="1.0" encoding="UTF-8"?>
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- Notification failures happen after the price commit and never undo an accepted price change. -->
    <seca id="BossStoredPriceNotice" service="mantle.product.PriceServices.store#ProductPrice" when="tx-commit">
        <actions><service-call name="ironstone.products.PriceNoticeServices.notify#ProductPriceChange" disable-authz="true" in-map="{productPriceId:productPriceId}" ignore-error="true"/></actions>
    </seca>
    <seca id="BossReplacedPriceNotice" service="mantle.product.PriceServices.replace#ProductPrice" when="tx-commit">
        <actions><service-call name="ironstone.products.PriceNoticeServices.notify#ProductPriceChange" disable-authz="true" in-map="{productPriceId:productPriceId}" ignore-error="true"/></actions>
    </seca>
    <seca id="BossExpiredPriceNotice" service="mantle.product.PriceServices.expire#ProductPrice" when="tx-commit"><actions><service-call name="ironstone.products.PriceNoticeServices.notify#ProductPriceChange" disable-authz="true" in-map="{productPriceId:productPriceId}" ignore-error="true"/></actions></seca>
</secas>
