<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Payments" default-menu-index="1" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="Object.assign({},context,{kind:'payments'})" out-map="context" />
        <set field="recordsCount" from="recordCount" />
    </actions>
    <widgets>
        <label text="Payments" type="h5" />
        <form-single name="Find" transition="." map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="text">
                <default-field title="Search">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Find" type="primary" />
                </default-field>
            </field>
        </form-single>
        <link url="//Accounting/QuickCreate/NewPayment" text="Create draft" link-type="anchor-button" btn-type="primary" condition="accounting.capabilities.paymentEdit" />
        <form-list name="Records" list="records" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="paymentId">
                <default-field title="Record">
                    <link url="//Accounting/Payments/PaymentDetail" text="${paymentId}" parameter-map="{recordId:paymentId,organizationPartyId:organizationPartyId}" />
                </default-field>
            </field>
            <field name="description">
                <default-field title="Name">
                    <display />
                </default-field>
            </field>
            <field name="statusId">
                <default-field title="Status">
                    <display-entity entity-name="moqui.basic.StatusItem" />
                </default-field>
            </field>
            <field name="amount" align="right">
                <default-field title="Amount">
                    <display currency-unit-field="amountUomId" />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="paymentId" />
                    <field-ref name="description" />
                </column>
                <column>
                    <field-ref name="amount" />
                    <field-ref name="statusId" />
                </column>
            </columns>
        </form-list>
        <label text="No matching records. Adjust the organization or filters." type="p" condition="!records.length" />
    </widgets>
</screen>
