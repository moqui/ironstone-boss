<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Account" default-menu-index="1" default-menu-include="false" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <parameter name="fromDate" />
    <parameter name="thruDate" />
    <parameter name="timePeriodId" />
    <parameter name="amountUomId" />
    <parameter name="facilityId" />
    <parameter name="costCenterId" />
    <parameter name="compareFromDate" />
    <parameter name="compareThruDate" />
    <parameter name="reportReturn" />
    <always-actions>
        <set field="glAccountId" from="recordId || glAccountId" />
        <service-call name="mantle.ledger.AccountingServices.get#Record" in-map="{kind:'accounts',recordId:glAccountId,organizationPartyId:organizationPartyId}" out-map="context" />
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.AccountServices.store#Account" in-map="Object.assign({},context,{glAccountId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="assignment">
        <actions>
            <service-call name="mantle.ledger.AccountServices.store#Assignment" in-map="Object.assign({},context,{glAccountId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="classification">
        <actions>
            <service-call name="mantle.ledger.AccountServices.store#Classification" in-map="Object.assign({},context,{glAccountId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountServices.get#Classifications" in-map="{glAccountId:glAccountId,organizationPartyId:organizationPartyId}" out-map="accountClasses" />
        <set from="accountClasses?.categoryRows || []" field="accountClassesCategoryRows" />
        <set from="(accountClassesCategoryRows || []).length" field="accountClassesCategoryRowsCount" />
        <set from="accountClasses?.groupRows || []" field="accountClassesGroupRows" />
        <set from="(accountClassesGroupRows || []).length" field="accountClassesGroupRowsCount" />
        <set from="accountClassesCategoryRowsCount || 1" field="accountClassesCategoryRowsPageSize" />
        <set from="0" field="accountClassesCategoryRowsPageIndex" />
        <set from="0" field="accountClassesCategoryRowsPageMaxIndex" />
        <set from="accountClassesCategoryRowsCount ? 1 : 0" field="accountClassesCategoryRowsPageRangeLow" />
        <set from="accountClassesCategoryRowsCount" field="accountClassesCategoryRowsPageRangeHigh" />
        <set from="accountClassesGroupRowsCount || 1" field="accountClassesGroupRowsPageSize" />
        <set from="0" field="accountClassesGroupRowsPageIndex" />
        <set from="0" field="accountClassesGroupRowsPageMaxIndex" />
        <set from="accountClassesGroupRowsCount ? 1 : 0" field="accountClassesGroupRowsPageRangeLow" />
        <set from="accountClassesGroupRowsCount" field="accountClassesGroupRowsPageRangeHigh" />
    </actions>
    <widgets>
        <link parameter-map="{organizationPartyId:organizationPartyId,fromDate:fromDate,thruDate:thruDate,timePeriodId:timePeriodId,amountUomId:amountUomId,facilityId:facilityId,costCenterId:costCenterId,compareFromDate:compareFromDate,compareThruDate:compareThruDate,glAccountId:glAccountId}" url="//Accounting/Reports/${reportReturn === 'TrialBalance' ? 'TrialBalance' : 'GeneralLedger'}" text="Back to report" condition="['TrialBalance','GeneralLedger'].includes(reportReturn)" />
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="${record.accountCode} ${record.accountName}" type="h5" />
            </container>
        </container>
        <section name="AccountEditor" condition="accounting.capabilities.glPost">
            <widgets>
                <form-single name="AccountHeader" transition="save" map="record">
                    <field name="recordId" from="glAccountId">
                        <default-field title="Record id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field title="Organization party id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="lastUpdatedStamp" from="record.lastUpdatedStamp">
                        <default-field title="Last updated stamp">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="accountCode">
                        <default-field title="Code">
                            <text-line />
                        </default-field>
                    </field>
                    <field name="accountName">
                        <default-field title="Name">
                            <text-line />
                        </default-field>
                    </field>
                    <field name="parentGlAccountId">
                        <default-field title="Parent">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accountParents',organizationPartyId:organizationPartyId}" />
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="glAccountClassEnumId">
                        <default-field title="Class">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'enum:GlAccountClass',organizationPartyId:organizationPartyId}" />
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="glAccountTypeEnumId">
                        <default-field title="Type">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'enum:GlAccountType',organizationPartyId:organizationPartyId}" />
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="disallowPosting">
                        <default-field title="Posting disabled">
                            <drop-down allow-empty="true">
                                <option key="N" text="No" />
                                <option key="Y" text="Yes" />
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <text-line />
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="Submit">
                            <submit text="Save account" type="primary" />
                        </default-field>
                    </field>
                </form-single>
                <form-single name="RequiredDimensions" transition="assignment" map="record">
                    <field name="recordId" from="glAccountId">
                        <default-field title="Record id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field title="Organization party id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="lastUpdatedStamp" from="record.assignmentLastUpdatedStamp">
                        <default-field title="Last updated stamp">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="fromDate">
                        <default-field title="From">
                            <date-time />
                        </default-field>
                    </field>
                    <field name="thruDate">
                        <default-field title="Through">
                            <date-time />
                        </default-field>
                    </field>
                    <field name="facilityRequired">
                        <default-field title="Facility required">
                            <drop-down allow-empty="true">
                                <option key="N" text="No" />
                                <option key="Y" text="Yes" />
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="costCenterRequired">
                        <default-field title="Cost centre required">
                            <drop-down allow-empty="true">
                                <option key="N" text="No" />
                                <option key="Y" text="Yes" />
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <text-line />
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="Submit">
                            <submit text="Save requirements" type="primary" />
                        </default-field>
                    </field>
                </form-single>
            </widgets>
        </section>
        <label text="Account details" type="h6" />
        <label text="Organization assignment and required dimensions" type="h6" />
        <link url="//Accounting/Reports/GeneralLedger" text="Open account ledger" parameter-map="{glAccountId:glAccountId,organizationPartyId:organizationPartyId,fromDate:fromDate,thruDate:thruDate,timePeriodId:timePeriodId,amountUomId:amountUomId,facilityId:facilityId,costCenterId:costCenterId,compareFromDate:compareFromDate,compareThruDate:compareThruDate}" />
        <label text="Account groups and categories" type="h6" />
        <form-list name="AccountCategories" list="accountClassesCategoryRows" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="glAccountCategoryId">
                <default-field title="Category">
                    <display-entity entity-name="mantle.ledger.account.GlAccountCategory" />
                </default-field>
            </field>
            <field name="fromDate">
                <default-field title="From">
                    <display format="yyyy-MM-dd" />
                </default-field>
            </field>
            <field name="thruDate">
                <default-field title="Through">
                    <display format="yyyy-MM-dd" />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="glAccountCategoryId" />
                </column>
                <column>
                    <field-ref name="fromDate" />
                    <field-ref name="thruDate" />
                </column>
            </columns>
        </form-list>
        <form-list name="AccountGroups" list="accountClassesGroupRows" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="glAccountGroupId">
                <default-field title="Report group">
                    <display-entity entity-name="mantle.ledger.account.GlAccountGroup" />
                </default-field>
            </field>
            <field name="groupTypeEnumId">
                <default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="glAccountGroupId" />
                </column>
                <column>
                    <field-ref name="groupTypeEnumId" />
                </column>
            </columns>
        </form-list>
        <container-dialog id="Setaccountclassification" button-text="Set account classification" condition="accounting.capabilities.admin">
            <form-single name="AccountClassification" transition="classification" map="context">
                <field name="recordId" from="glAccountId">
                    <default-field title="Record id">
                        <hidden />
                    </default-field>
                </field>
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="glAccountCategoryId">
                    <default-field title="Category">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accountCategories',organizationPartyId:organizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="glAccountGroupId">
                    <default-field title="Report group">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accountGroups',organizationPartyId:organizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="fromDate">
                    <default-field title="Effective from">
                        <date-time />
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Save classification" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
    </widgets>
</screen>
