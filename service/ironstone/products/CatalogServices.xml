        <out-parameters><parameter name="productList" type="List"/><parameter name="productListCount" type="Long"/><parameter name="pageIndex" type="Integer"/><parameter name="pageSize" type="Integer"/><parameter name="searchUnavailable" type="Boolean"/><parameter name="searchMessage"/></out-parameters>
