<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Journal batches" default-menu-index="4" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="saveBatch">
        <actions>
            <service-call name="mantle.ledger.JournalServices.store#Batch" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="validateBatch">
        <actions>
            <service-call name="mantle.ledger.JournalServices.validate#Batch" in-map="context" out-map="result" />
            <set field="previewId" from="result.previewId" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="postBatch">
        <actions>
            <service-call name="mantle.ledger.JournalServices.post#Batch" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="Object.assign({},context,{kind:'batches'})" out-map="context" />
        <set field="recordsCount" from="recordCount" />
        <if condition="previewId">
            <service-call name="mantle.ledger.JournalServices.get#BatchPreview" in-map="{organizationPartyId:organizationPartyId,previewId:previewId}" out-map="batchPreview" />
        </if>
        <set from="batchPreview?.results || []" field="batchPreviewResults" />
        <set from="(batchPreviewResults || []).length" field="batchPreviewResultsCount" />
        <set from="batchPreviewResultsCount || 1" field="batchPreviewResultsPageSize" />
        <set from="0" field="batchPreviewResultsPageIndex" />
        <set from="0" field="batchPreviewResultsPageMaxIndex" />
        <set from="batchPreviewResultsCount ? 1 : 0" field="batchPreviewResultsPageRangeLow" />
        <set from="batchPreviewResultsCount" field="batchPreviewResultsPageRangeHigh" />
    </actions>
    <widgets>
        <label text="Journal batches" type="h5" />
        <form-single name="Find" transition="." map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="text">
                <default-field title="Search">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Find" type="primary" />
                </default-field>
            </field>
        </form-single>
        <form-list name="Records" list="records" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="glJournalId">
                <default-field title="Record">
                    <display />
                </default-field>
            </field>
            <field name="glJournalName">
                <default-field title="Name">
                    <text-line />
                </default-field>
            </field>
            <field name="isPosted">
                <default-field title="Posted">
                    <display />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="glJournalId" />
                    <field-ref name="glJournalName" />
                </column>
                <column>
                    <field-ref name="isPosted" />
                </column>
            </columns>
        </form-list>
        <label text="No matching records. Adjust the organization or filters." type="p" condition="!records.length" />
        <container-dialog id="Newjournalbatch" button-text="New journal batch">
            <form-single name="NewBatch" transition="saveBatch" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="glJournalName">
                    <default-field title="Name">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Create batch" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <container-dialog id="Reviewbatch" button-text="Review batch">
            <form-single name="ValidateBatch" transition="validateBatch" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="glJournalId">
                    <default-field title="Batch">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'batches',organizationPartyId:organizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Validate batch" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <container-dialog id="Postreviewedbatch" button-text="Post reviewed batch">
            <form-single name="PostBatch" transition="postBatch" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="glJournalId">
                    <default-field title="Batch">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'batches',organizationPartyId:organizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="previewId" from="previewId">
                    <default-field title="Preview id">
                        <hidden />
                    </default-field>
                </field>
                <field name="operationKey" from="operationKey || ('batch-' + ec.user.randomString(24))">
                    <default-field title="Operation key">
                        <hidden />
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Post reviewed batch" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <section name="BatchReview" condition="previewId">
            <widgets>
                <label text="Review and posting results" type="h6" />
                <form-list name="BatchResults" list="batchPreviewResults" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
                    <field name="acctgTransId">
                        <default-field title="Entry">
                            <display />
                        </default-field>
                    </field>
                    <field name="valid">
                        <default-field title="Ready">
                            <display />
                        </default-field>
                    </field>
                    <field name="success">
                        <default-field title="Posted">
                            <display />
                        </default-field>
                    </field>
                    <field name="message">
                        <default-field title="Result">
                            <display />
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="acctgTransId" />
                        </column>
                        <column>
                            <field-ref name="valid" />
                            <field-ref name="success" />
                            <field-ref name="message" />
                        </column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
