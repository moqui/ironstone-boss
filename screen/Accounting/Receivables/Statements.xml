<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Statements" default-menu-index="3">
    <parameter name="organizationPartyId"/>
    <parameter name="customerPartyId"/>
    <parameter name="currencyUomId"/>
    <parameter name="asOfDate"/>
    <parameter name="includeZeroBalance"/>
    <parameter name="showStatements"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingReceivables.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="previewStatements">
        <actions><set field="showStatements" value="Y"/></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="sendStatements">
        <actions>
            <set field="statementSelection" from="{organizationPartyId:organizationPartyId,
                customerPartyIdList:(customerPartyId ? [customerPartyId] : null), currencyUomId:currencyUomId || null,
                asOfDate:asOfDate || null, includeZeroBalance:includeZeroBalance == 'Y'}"/>
            <service-call name="mantle.account.CollectionServices.send#Statements" out-map="delivery"
                    in-map="Object.assign({operationKey:operationKey, toAddresses:toAddresses || null}, statementSelection)"/>
            <iterate list="delivery.results ?? []" entry="result">
                <set field="outcome" from="result.status == 'queued' ? 'Queued for delivery' : result.status == 'sent' ? 'Sent' :
                    (result.errorMessage || 'Failed')"/>
                <if condition="result.status == 'failed'"><then>
                    <message type="warning">${result.recipient || result.customerPartyId}: ${outcome}</message>
                </then><else>
                    <message type="success">${result.recipient}: ${outcome}</message>
                </else></if>
            </iterate>
            <set field="showStatements" value="Y"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <set field="statements" from="{}"/>
        <if condition="organizationPartyId &amp;&amp; showStatements == 'Y'">
            <service-call name="mantle.account.CollectionServices.get#Statements" out-map="statements" transaction="force-new"
                    ignore-error="true" in-map="{organizationPartyId:organizationPartyId,
                        customerPartyIdList:(customerPartyId ? [customerPartyId] : null), currencyUomId:currencyUomId || null,
                        asOfDate:asOfDate || null, includeZeroBalance:includeZeroBalance == 'Y'}"/>
        </if>
        <set field="printParameters" from="{organizationPartyId:organizationPartyId, customerPartyId:customerPartyId,
            currencyUomId:currencyUomId, asOfDate:asOfDate, includeZeroBalance:includeZeroBalance}"/>
    </actions>
    <widgets>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <label text="Choose an organization to prepare customer statements." type="p" condition="!organizationPartyId"/>
        <section name="StatementOrganizationChosen" condition="organizationPartyId">
            <widgets>
                <label text="Customer statements" type="h5"/>
                <form-single name="StatementOptions" transition="previewStatements" map="context">
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field title="">
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="customerPartyId">
                        <default-field title="Customer">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'parties',
                                            organizationPartyId:organizationPartyId, selected:customerPartyId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="As of"
                                tooltip="The aging is as of this date; the balances are the open ones today.">
                            <date-time type="date"/>
                        </default-field>
                    </field>
                    <field name="currencyUomId">
                        <default-field title="Currency">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'currencies',
                                            organizationPartyId:organizationPartyId, selected:currencyUomId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="includeZeroBalance">
                        <default-field title="Balances">
                            <check>
                                <option key="Y" text="Include zero balances"/>
                            </check>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Preview statements"/>
                        </default-field>
                    </field>
                </form-single>
                <section name="StatementPreview" condition="showStatements == 'Y'">
                    <widgets>
                        <label text="Statement preview" type="h6"/>
                        <label text="No customer has an open balance for this selection." type="p" style="m-muted"
                                condition="!(statements.statementRows ?? []).length"/>
                        <section-iterate name="StatementCurrencies" list="statements.statementRows ?? []" entry="statementRow">
                            <widgets>
                                <container-box>
                                    <box-header title="${statementRow.customerName} · ${statementRow.currencyUomId}"/>
                                    <box-body>
                                        <label type="p" text="Unpaid ${statementRow.unpaidText}"/>
                                        <label type="p" text="Unapplied ${statementRow.unappliedText}"/>
                                        <label type="p" text="Balance due ${statementRow.closingBalanceText}"/>
                                        <label type="p" style="text-caption m-muted"
                                                text="Recipients: ${statementRow.recipients.join(', ') || 'none'}"/>
                                        <form-list name="StatementInvoices" list="statementRow.invoiceRows" skip-form="true"
                                                paginate="false">
                                            <field name="invoiceId">
                                                <default-field title="Invoice">
                                                    <link url="${sharedLinks['Receivables/InvoiceDetail']}" text="${invoiceId}"
                                                            parameter-map="{recordId:invoiceId,
                                                                organizationPartyId:organizationPartyId}"/>
                                                </default-field>
                                            </field>
                                            <field name="invoiceDateText">
                                                <default-field title="Date">
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="dueDateText">
                                                <default-field title="Due">
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="invoiceTotal" align="right">
                                                <default-field title="Total">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <field name="unpaidTotal" align="right">
                                                <default-field title="Unpaid">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <columns type="mobile">
                                                <column>
                                                    <field-ref name="invoiceId"/>
                                                    <field-ref name="dueDateText"/>
                                                </column>
                                                <column>
                                                    <field-ref name="invoiceTotal"/>
                                                    <field-ref name="unpaidTotal"/>
                                                </column>
                                            </columns>
                                        </form-list>
                                        <form-list name="StatementReceipts" list="statementRow.paymentRows" skip-form="true"
                                                paginate="false">
                                            <field name="paymentId">
                                                <default-field title="Receipt">
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="effectiveDateText">
                                                <default-field title="Date">
                                                    <display/>
                                                </default-field>
                                            </field>
                                            <field name="amount" align="right">
                                                <default-field title="Amount">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <field name="unappliedTotal" align="right">
                                                <default-field title="Unapplied">
                                                    <display currency-unit-field="currencyUomId"/>
                                                </default-field>
                                            </field>
                                            <columns type="mobile">
                                                <column>
                                                    <field-ref name="paymentId"/>
                                                    <field-ref name="effectiveDateText"/>
                                                </column>
                                                <column>
                                                    <field-ref name="unappliedTotal"/>
                                                </column>
                                            </columns>
                                        </form-list>
                                    </box-body>
                                </container-box>
                            </widgets>
                        </section-iterate>
                        <section name="StatementActions" condition="(statements.statementRows ?? []).length">
                            <widgets>
                                <link url="${sharedLinks['Receivables/StatementPrint']}" text="Print statements"
                                        target-window="_blank" parameter-map="printParameters"/>
                                <form-single name="StatementDelivery" transition="sendStatements"
                                        condition="accounting.capabilities.arEdit">
                                    <field name="organizationPartyId" from="organizationPartyId">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="customerPartyId" from="customerPartyId">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="currencyUomId" from="currencyUomId">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="asOfDate" from="asOfDate">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="includeZeroBalance" from="includeZeroBalance">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="operationKey" from="'statement-' + ec.user.randomString(24)">
                                        <default-field title="">
                                            <hidden/>
                                        </default-field>
                                    </field>
                                    <field name="toAddresses">
                                        <default-field title="Recipient override">
                                            <text-line/>
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field title="">
                                            <submit text="Send statements" confirmation="Send these statements?"/>
                                        </default-field>
                                    </field>
                                </form-single>
                            </widgets>
                        </section>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
