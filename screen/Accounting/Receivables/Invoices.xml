<!-- The invoices of the organization (template/AccountingDocuments.xml DocumentList). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Invoices" default-menu-index="1" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="text"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <set field="documentKind" value="invoices"/>
        <set field="documentLabel" value="invoice"/>
        <set field="listTitle" value="Invoices"/>
        <set field="detailPath" value="Receivables/InvoiceDetail"/>
        <set field="newPath" value="QuickCreate/NewInvoice"/>
        <set field="canCreate" from="!!accounting.capabilities.arEdit"/>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="{kind:documentKind,organizationPartyId:organizationPartyId,text:text,pageIndex:pageIndex,pageSize:pageSize}" out-map="context"/>
    </actions>
    <widgets>
        <section-include name="DocumentList" location="component://mr-boss/template/AccountingDocuments.xml"/>
    </widgets>
</screen>
