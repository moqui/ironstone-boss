        <section-iterate name="OfferActions" list="offerRows" entry="offer">
            <widgets>
                <section name="EditableOffer" condition="offer.canEdit">
                    <widgets>
                        <container-box>
                            <box-header title="${offer.productPriceId} · ${offer.otherPartyItemId || offer.productId}"/>
