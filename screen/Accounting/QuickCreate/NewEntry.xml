<!-- A new draft journal entry, from quick create or the journal list; its lines are added on the entry. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="New journal entry"
        default-menu-index="1"
        default-menu-include="false"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="create">
        <actions>
            <service-call name="mantle.ledger.JournalServices.store#DraftEntry"
                    in-map="{organizationPartyId:organizationPartyId, description:description, transactionDate:transactionDate}"
                    out-map="result"/>
            <set field="recordId" from="result.recordId || result.acctgTransId"/>
        </actions>
        <default-response url="//Accounting/GeneralLedger/JournalEntryDetail">
            <parameter name="recordId"/>
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <widgets>
        <label text="New journal entry" type="h5"/>
        <label text="The entry starts as a draft; add its lines, then review and post it." type="p" style="text-caption m-muted"/>
        <form-single name="CreateDraft" transition="create" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices"
                                server-search="true"
                                min-length="0"
                                parameter-map="{choice:'organizations',
                                    organizationPartyId:organizationPartyId, selected:organizationPartyId}"/>
                    </drop-down>
                </default-field>
            </field>
            <field name="description">
                <default-field title="Description">
                    <text-line/>
                </default-field>
            </field>
            <field name="transactionDate">
                <default-field title="Date">
                    <date-time/>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="">
                    <submit text="Create draft entry" type="primary"/>
                </default-field>
            </field>
        </form-single>
    </widgets>
</screen>
