<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Overview &amp; contacts" default-menu-index="1">
    <widgets>
        <container-row>
            <row-col lg="6">
                <container-box>
                    <box-header title="Contact information"/>
                    <box-toolbar>
                        <link url="//Commons/Contacts/ContactDetail" text="Maintain contact" link-type="anchor-button" icon="sym_o_edit" condition="supplier.canEditContact"
                                parameter-map="{partyId:vendorPartyId}"/>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="SupplierContacts" list="contactRows" skip-form="true" skip-header="true" paginate="false">
                            <field name="kindLabel">
                                <default-field>
                                    <display style="m-muted"/>
                                </default-field>
                            </field>
                            <field name="value">
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="purposeText">
                                <default-field>
                                    <display style="m-muted"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="kindLabel"/></column>
                                <column><field-ref name="value"/></column>
                            </columns>
                        </form-list>
                        <label text="No contact information is recorded." type="p" style="q-pa-md m-muted" condition="!contactRows?.length"/>
                    </box-body-nopad>
                </container-box>
            </row-col>
            <row-col lg="6">
                <container-box>
                    <box-header title="Addresses"/>
                    <box-body-nopad>
                        <form-list name="SupplierAddresses" list="addressRows" skip-form="true" skip-header="true" paginate="false">
                            <field name="address1">
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="city">
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="postalCode">
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="address1"/></column>
                                <column><field-ref name="city"/></column>
                            </columns>
                        </form-list>
                        <label text="No address is recorded." type="p" style="q-pa-md m-muted" condition="!addressRows?.length"/>
                    </box-body-nopad>
                </container-box>
                <container-box>
                    <box-header title="Roles"/>
                    <box-body-nopad>
                        <form-list name="SupplierRoles" list="roleRows" skip-form="true" skip-header="true" paginate="false">
                            <field name="roleTypeId">
                                <default-field>
                                    <display-entity entity-name="mantle.party.RoleType"/>
                                </default-field>
                            </field>
                        </form-list>
                    </box-body-nopad>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
