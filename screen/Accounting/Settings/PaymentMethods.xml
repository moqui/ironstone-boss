<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Payment methods" default-menu-index="6" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#PaymentMethod" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#PaymentMethods" in-map="context" out-map="context" />
        <set from="(methods || []).length" field="methodsCount" />
        <set from="methodsCount || 1" field="methodsPageSize" />
        <set from="0" field="methodsPageIndex" />
        <set from="0" field="methodsPageMaxIndex" />
        <set from="methodsCount ? 1 : 0" field="methodsPageRangeLow" />
        <set from="methodsCount" field="methodsPageRangeHigh" />
        <script>const dateLabels=ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js')
methods = dateLabels.formatDates(methods,[["thruDate", "yyyy-MM-dd"]])</script>
    </actions>
    <widgets>
        <label text="Payment methods" type="h5" />
        <form-single name="SelectOrganization" transition="selectOrganization" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'allOrganizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Choose organization" type="primary" />
                </default-field>
            </field>
        </form-single>
        <label text="Identifiers are masked; gateway credentials remain in Admin." type="p" />
        <form-list name="PaymentMethodList" list="methods" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="paymentMethodId">
                <default-field title="Method">
                    <display />
                </default-field>
            </field>
            <field name="description">
                <default-field title="Name">
                    <display />
                </default-field>
            </field>
            <field name="paymentMethodTypeEnumId">
                <default-field title="Type">
                    <display-entity entity-name="moqui.basic.Enumeration" />
                </default-field>
            </field>
            <field name="maskedIdentifier">
                <default-field title="Identifier">
                    <display />
                </default-field>
            </field>
            <field name="paymentGatewayConfigId">
                <default-field title="Gateway">
                    <display />
                </default-field>
            </field>
            <field name="thruDate">
                <default-field title="Expires">
                    <display text="${thruDateText}" />
                </default-field>
            </field>
            <field name="methodActions">
                <default-field title="Actions">
                    <container-dialog id="EditMethodDialog" button-text="Edit method">
                        <form-single name="EditMethod" transition="save" map="context">
                            <field name="paymentMethodId" from="paymentMethodId">
                                <default-field title="Method">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                <default-field title="Revision">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="organizationPartyId" from="organizationPartyId">
                                <default-field title="Organization party id">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="description">
                                <default-field title="Display name">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="currencyUomId">
                                <default-field title="Currency">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId,selected:currencyUomId}" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="paymentGatewayConfigId">
                                <default-field title="Configured gateway">
                                    <drop-down allow-empty="true">
                                        <list-options list="gateways" key="${paymentGatewayConfigId}" text="${description}" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <default-field title="Starts">
                                    <date-time />
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <default-field title="Expires">
                                    <date-time />
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="Submit">
                                    <submit text="Save method" type="primary" />
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="paymentMethodId" />
                    <field-ref name="description" />
                </column>
                <column>
                    <field-ref name="paymentMethodTypeEnumId" />
                    <field-ref name="thruDate" />
                    <field-ref name="methodActions" />
                </column>
            </columns>
        </form-list>
        <container-dialog id="Newpaymentmethod" button-text="New payment method">
            <form-single name="NewMethod" transition="save" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="description">
                    <default-field title="Display name">
                        <text-line />
                    </default-field>
                </field>
                <field name="currencyUomId">
                    <default-field title="Currency">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId,selected:currencyUomId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="paymentGatewayConfigId">
                    <default-field title="Configured gateway">
                        <drop-down allow-empty="true">
                            <list-options list="gateways" key="${paymentGatewayConfigId}" text="${description}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Create method" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
    </widgets>
</screen>
