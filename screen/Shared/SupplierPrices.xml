                                </field>
                                

                            </form-single>
                        </action>
                    </row-selection>
                    <field name="productId">
                        <default-field title="Priced product">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="productName">
                        <default-field title="Product">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="supplierName">
                        <default-field title="Supplier">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="vendorPartyId">
                        <default-field title="Vendor role">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="buyerName">
                        <default-field title="Buyer">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="customerPartyId">
                        <default-field title="Customer role">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="otherPartyItemId">
                        <default-field title="Supplier item code">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="otherPartyItemName">
                        <default-field title="Supplier item name">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="price">
                        <default-field title="Unit price">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="priceUomId">
                        <default-field title="Currency">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="minQuantity">
                        <default-field title="Minimum">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="quantityIncrement">
                        <default-field title="Increment">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="quantityUomId">
                        <default-field title="Quantity unit">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="packSize">
                        <default-field title="Contained quantity">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="packQuantityUomId"><default-field title="Contained quantity unit"><display/></default-field></field>
                    <field name="baseProductId">
                        <default-field title="Contained product">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="standardLeadTimeDays">
                        <default-field title="Lead days">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="preferredOrderEnumId">
                        <default-field title="Preference">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="supplierRatingTypeEnumId">
                        <default-field title="Recorded rating">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="canDropShip">
                        <default-field title="Dropship">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="agreementId">
                        <default-field title="Agreement">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="agreementItemSeqId">
                        <default-field title="Agreement item">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="fromDateText">
                        <default-field title="From">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="thruDateText">
                        <default-field title="Through">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="state">
                        <default-field title="State">
                            <display/>
                        </default-field>
                    </field>
                    

                    <field name="openSupplier">
                        <default-field title="Supplier record">
                            <link url="${sharedLinks['Suppliers/Supplier360']}" text="Supplier360" parameter-map="{vendorPartyId:vendorPartyId,organizationPartyId:organizationPartyId}"/>
                        </default-field>
                    </field>
                    

                    <field name="openProduct">
                        <default-field title="Product record">
                            <link url="${sharedLinks['Products/Product360']}" text="Product360" parameter-map="{productId:productId}"/>
                        </default-field>
                    </field>
                    

                </form-list>
            </box-body>
