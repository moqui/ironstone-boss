<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets>
        <section name="ReceivableSendForm">
            <widgets>
                <form-single name="FinanceSendInvoice" transition="financeSendInvoice" map="invoiceSendValue">
                    <field name="sourceVersion" from="receivable.sourceVersion">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field title="">
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="invoiceId" from="invoiceId">
                        <default-field title="">
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="operationKey" from="invoiceOperationKey">
                        <default-field title="">
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="toAddresses">
                        <default-field title="Recipients">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="note">
                        <default-field title="Message">
                            <text-area rows="3"/>
                        </default-field>
                    </field>
                    <field name="reviewedAttachmentList">
                        <conditional-field condition="receivable.canAttach" title="Supporting files"
                                tooltip="Optional: up to 10 files, 10 MiB each, 20 MiB in all.">
                            <drop-down allow-empty="true" allow-multiple="true">
                                <dynamic-options transition="choices" server-search="true" min-length="0"
                                        parameter-map="{choice:'reviewedInvoiceAttachments',
                                            organizationPartyId:organizationPartyId, invoiceId:invoiceId}"/>
                            </drop-down>
                        </conditional-field>
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="attachmentHelp">
                        <default-field>
                            <label type="p" style="text-caption m-muted" condition="receivable.canAttach"
                                    text="The invoice PDF is included. Supporting files are optional."/>
                            <label type="p" style="text-caption m-muted" condition="!receivable.canAttach"
                                    text="The invoice PDF is included. Add supporting documents in Files first."/>
                            <label type="p" style="text-caption text-warning" condition="receivable.attachmentDiscoveryIncomplete"
                                    text="Not every file is listed. Review Files if a supporting document is missing."/>
                        </default-field>
                    </field>
                    <field name="draftHelp">
                        <default-field>
                            <label text="Sending this draft finalizes it first." type="p" condition="receivable.isDraft"/>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Send invoice"/>
                        </default-field>
                    </field>
                </form-single>
            </widgets>
        </section>
    </widgets>
</screen>
