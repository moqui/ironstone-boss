            <set field="screenContext" from="ec.resource.script(module).execute('transferReview', context)"/>
            <set field="previewId" from="screenContext.previewId"/>
            <set field="reviewFound" from="screenContext.reviewFound"/>
            <set field="transferReview" from="screenContext.transferReview"/>
            <set field="transferValue" from="screenContext.transferValue"/>
        </actions>
    </service>
