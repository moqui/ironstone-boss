<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Variants &amp; features" default-menu-index="2">
    <transition name="newFeature"><actions><service-call name="ironstone.products.FeatureServices.store#Feature" in-map="{createOnly:true,productId:productId,productFeatureId:newProductFeatureId,description:newFeatureDescription,productFeatureTypeEnumId:productFeatureTypeEnumId,ownerPartyId:ownerPartyId,applTypeEnumId:newApplTypeEnumId}"/></actions><default-response url="."><parameter name="productId"/></default-response><error-response url="."/></transition>
    <transition name="storeRow">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#CatalogRow" in-map="Object.assign({},context,{kind:'feature'})"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <widgets>
        <section name="RowsAvailable" condition="productFound">
            <widgets>
                <container-box>
                    <box-header title="Variants &amp; features"/>
                    <box-body><section name="CreateFeature" condition="canEdit"><widgets><container-dialog id="CreateAndApplyFeature" button-text="Create and apply feature" title="New feature for this product" width="640"><form-single name="NewFeature" transition="newFeature"><field name="productId"><default-field><hidden/></default-field></field><field name="newProductFeatureId"><default-field title="ID (empty: generated)"><text-line/></default-field></field><field name="newFeatureDescription"><default-field title="Description"><text-line/></default-field></field><field name="productFeatureTypeEnumId"><default-field title="Feature type"><drop-down><list-options list="options.featureTypes" key="${value}" text="${label}"/></drop-down></default-field></field><field name="ownerPartyId" from="product.ownerPartyId"><default-field title="Owner"><drop-down><list-options list="options.owners" key="${value}" text="${label}"/></drop-down></default-field></field><field name="newApplTypeEnumId" from="'PfatStandard'"><default-field title="Application"><drop-down><option key="PfatStandard" text="Standard"/><option key="PfatSelectable" text="Selectable"/><option key="PfatDistinguishing" text="Distinguishing"/></drop-down></default-field></field><field name="submitButton"><default-field title="Create and apply"><submit/></default-field></field></form-single></container-dialog></widgets></section>
                        <container-box>
                            <box-header title="Variants"/>
                            <box-body>
                                <form-list name="Variants" list="detail.variantRows" skip-form="true" paginate="false">
                                    <field name="productId">
                                        <header-field title="Product"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="productName">
                                        <header-field title="Name"/>
                                        <default-field>
                                            <display/>
                                        </default-field>
                                    </field>
                                </form-list>
                            </box-body>
                        </container-box>
                        <form-list name="FeaturesRows" list="detail.featureRows" skip-form="true" paginate="false">
                            <field name="productFeatureId">
                                <header-field title="Feature"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="applTypeEnumId">
                                <header-field title="Application"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="amount">
                                <header-field title="Amount"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="recurringAmount">
                                <header-field title="Recurring amount"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                        </form-list>
                        <section name="FeaturesEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddFeatures" button-text="Add" title="Variants &amp; features" width="640">
                                    <form-single name="AddFeatures" transition="storeRow">
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="productFeatureId">
                                            <default-field title="Feature">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.features" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="applTypeEnumId">
                                            <default-field title="Application">
                                                <drop-down allow-empty="true">
                                                    <option key="PfatStandard" text="Standard"/>
                                                    <option key="PfatSelectable" text="Selectable"/>
                                                    <option key="PfatDistinguishing" text="Distinguishing"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="amount">
                                            <default-field title="Amount">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="recurringAmount">
                                            <default-field title="Recurring amount">
                                                <text-line input-type="number"/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                                <section-iterate name="EditFeaturesRows" list="detail.featureRows" entry="entry">
                                    <widgets>
                                        <container-dialog id="EditFeatures_${entry_index}" button-text="Edit ${entry.productFeatureId}" title="Edit Variants &amp; features" width="640">
                                            <form-single name="EditFeatures" transition="storeRow" map="entry">
                                                <field name="productId">
                                                    <default-field>
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="productFeatureId">
                                                    <default-field>
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="applTypeEnumId">
                                                    <default-field title="Application">
                                                        <drop-down allow-empty="true">
                                                            <option key="PfatStandard" text="Standard"/>
                                                            <option key="PfatSelectable" text="Selectable"/>
                                                            <option key="PfatDistinguishing" text="Distinguishing"/>
                                                        </drop-down>
                                                    </default-field>
                                                </field>
                                                <field name="fromDate">
                                                    <default-field>
                                                        <hidden/>
                                                        <display text="${fromDateText || ''}"/>
                                                    </default-field>
                                                </field>
                                                <field name="thruDate">
                                                    <default-field title="Through">
                                                        <date-time/>
                                                    </default-field>
                                                </field>
                                                <field name="amount">
                                                    <default-field title="Amount">
                                                        <text-line input-type="number"/>
                                                    </default-field>
                                                </field>
                                                <field name="recurringAmount">
                                                    <default-field title="Recurring amount">
                                                        <text-line input-type="number"/>
                                                    </default-field>
                                                </field>
                                                <field name="submitButton">
                                                    <default-field title="Save">
                                                        <submit/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </container-dialog>
                                    </widgets>
                                </section-iterate>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
