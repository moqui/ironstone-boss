<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Summary" default-menu-index="1">
    <widgets>
        <section name="Available" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Feature group"/>
                    <box-body>
                        <!-- one layout for every user: an editor edits the fields a reader sees as text (style-guide §3.3) -->
                        <form-single name="FeatureGroup" transition="../save" map="master">
                            <field name="productFeatureGroupId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="expectedLastUpdatedStamp" from="master.lastUpdatedStamp">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="description">
                                <conditional-field condition="canEdit" title="Description">
                                    <text-line/>
                                </conditional-field>
                                <default-field title="Description">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <conditional-field condition="canEdit" title="Save">
                                    <submit/>
                                </conditional-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
