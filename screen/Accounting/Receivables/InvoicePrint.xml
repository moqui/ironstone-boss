<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Invoice print" default-menu-include="false">
    <parameter name="organizationPartyId"/>
    <parameter name="invoiceId"/>
    <parameter name="recordId"/>
    <actions>
        <service-call name="mantle.account.InvoiceServices.get#InvoiceOutput" in-map="{organizationPartyId:organizationPartyId,invoiceId:invoiceId || recordId}" out-map="invoiceOutput" transaction="force-new" ignore-error="true"/>
        <set field="printAvailable" from="!!invoiceOutput?.printHtml"/>
        <set field="printUrl" from="'/apps/Accounting/Receivables/InvoicePrint?renderMode=html-print&amp;invoiceId=' + encodeURIComponent(invoiceId || recordId || '') + '&amp;organizationPartyId=' + encodeURIComponent(organizationPartyId || '')"/>
    </actions>
    <widgets>
        <section name="InvoicePrintUnavailable" condition="!printAvailable">
            <widgets>
                <label type="h5" text="Invoice not available"/>
                <link url="//Accounting/Receivables/Invoices" text="Back to invoices"/>
            </widgets>
        </section>
        <section name="InvoicePrintAvailable" condition="printAvailable">
            <widgets>
                <render-mode>
                    <text type="html-print"><![CDATA[${invoiceOutput.printHtml}]]></text>
                    <text type="html"><![CDATA[${invoiceOutput.printHtml}]]></text>
                    <text type="qvt"><![CDATA[<p><a href="${WebUtilities.encodeHtml(printUrl)}" target="_blank">${ec.l10n.localize('Open the printable invoice')}</a></p>]]></text>
                    <text type="tui"><![CDATA[${JSON.stringify({t: "link", id: "AccountingInvoicePrint", text: ec.l10n.localize("Open the printable invoice"), url: printUrl})}]]></text>
                </render-mode>
            </widgets>
        </section>
    </widgets>
</screen>
