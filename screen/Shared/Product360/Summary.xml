<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Summary" default-menu-index="1">
    <condition>
        <expression>!Array.isArray(product360Tabs) || product360Tabs.includes('Summary')</expression>
    </condition>
    <widgets>
        <section name="Master" condition="productFound">
            <widgets>
                <container-box>
                    <box-header title="Product"/>
                    <box-body>
                        <!-- one layout for every user: an editor edits the fields a reader sees as text (style-guide §3.3) -->
                        <form-single name="Product" transition="../save" map="product">
                            <field name="productId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="expectedLastUpdatedStamp" from="product.lastUpdatedStamp">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="productName">
                                <conditional-field condition="canEdit" title="Name">
                                    <text-line/>
                                </conditional-field>
                                <default-field title="Name">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="pseudoId">
                                <conditional-field condition="canEdit" title="Alias">
                                    <text-line/>
                                </conditional-field>
                                <default-field title="Alias">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="description">
                                <conditional-field condition="canEdit" title="Description">
                                    <text-area rows="3"/>
                                </conditional-field>
                                <default-field title="Description">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="comments">
                                <conditional-field condition="canEdit" title="Notes">
                                    <text-area rows="3"/>
                                </conditional-field>
                                <default-field title="Notes">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="productTypeEnumId">
                                <conditional-field condition="canEdit" title="Product type">
                                    <drop-down allow-empty="true">
                                        <list-options list="options.productTypes" key="${value}" text="${label}"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Product type">
                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                </default-field>
                            </field>
                            <field name="assetTypeEnumId">
                                <conditional-field condition="canEdit" title="Asset type">
                                    <drop-down allow-empty="true">
                                        <list-options list="options.assetTypes" key="${value}" text="${label}"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Asset type">
                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                </default-field>
                            </field>
                            <field name="productClassEnumId">
                                <conditional-field condition="canEdit" title="Product class">
                                    <drop-down allow-empty="true">
                                        <entity-options key="${enumId}" text="${description}">
                                            <entity-find entity-name="moqui.basic.Enumeration">
                                                <econdition field-name="enumTypeId" value="ProductClass"/>
                                                <order-by field-name="sequenceNum,description"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Product class">
                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                </default-field>
                            </field>
                            <field name="assetClassEnumId">
                                <conditional-field condition="canEdit" title="Asset class">
                                    <drop-down allow-empty="true">
                                        <entity-options key="${enumId}" text="${description}">
                                            <entity-find entity-name="moqui.basic.Enumeration">
                                                <econdition field-name="enumTypeId" value="AssetClass"/>
                                                <order-by field-name="sequenceNum,description"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Asset class">
                                    <display-entity entity-name="moqui.basic.Enumeration"/>
                                </default-field>
                            </field>
                            <field name="amountUomId">
                                <conditional-field condition="canEdit" title="Stock / amount unit">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="../choices" server-search="true" min-length="0" parameter-map="{choice:'units'}"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Stock / amount unit">
                                    <display-entity entity-name="moqui.basic.Uom"/>
                                </default-field>
                            </field>
                            <field name="amountFixed">
                                <conditional-field condition="canEdit" title="Fixed amount">
                                    <text-line input-type="number"/>
                                </conditional-field>
                                <default-field title="Fixed amount">
                                    <display/>
                                </default-field>
                            </field>
                            <field name="amountRequire">
                                <conditional-field condition="canEdit" title="Amount required">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Amount required">
                                    <display text="${amountRequire == 'N' ? 'No' : amountRequire == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="salesAllowed">
                                <conditional-field condition="canEdit" title="Sales allowed" tooltip="Leave empty for yes">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Sales allowed">
                                    <display text="${salesAllowed == 'N' ? 'No' : salesAllowed == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="purchaseAllowed">
                                <conditional-field condition="canEdit" title="Purchases allowed" tooltip="Leave empty for yes">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Purchases allowed">
                                    <display text="${purchaseAllowed == 'N' ? 'No' : purchaseAllowed == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="salesIntroductionDate">
                                <conditional-field condition="canEdit" title="Sales introduction">
                                    <date-time/>
                                </conditional-field>
                                <default-field title="Sales introduction">
                                    <display format="yyyy-MM-dd"/>
                                </default-field>
                            </field>
                            <field name="salesDiscontinuationDate">
                                <conditional-field condition="canEdit" title="Sales discontinuation">
                                    <date-time/>
                                </conditional-field>
                                <default-field title="Sales discontinuation">
                                    <display format="yyyy-MM-dd"/>
                                </default-field>
                            </field>
                            <field name="supportDiscontinuationDate">
                                <conditional-field condition="canEdit" title="Support discontinuation">
                                    <date-time/>
                                </conditional-field>
                                <default-field title="Support discontinuation">
                                    <display format="yyyy-MM-dd"/>
                                </default-field>
                            </field>
                            <field name="salesDiscWhenNotAvail">
                                <conditional-field condition="canEdit" title="Discontinue when unavailable">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Discontinue when unavailable">
                                    <display text="${salesDiscWhenNotAvail == 'N' ? 'No' : salesDiscWhenNotAvail == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="requireInventory">
                                <conditional-field condition="canEdit" title="Inventory required">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Inventory required">
                                    <display text="${requireInventory == 'N' ? 'No' : requireInventory == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="chargeShipping">
                                <conditional-field condition="canEdit" title="Shipping charged">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Shipping charged">
                                    <display text="${chargeShipping == 'N' ? 'No' : chargeShipping == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="taxable">
                                <conditional-field condition="canEdit" title="Taxable">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Taxable">
                                    <display text="${taxable == 'N' ? 'No' : taxable == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="returnable">
                                <conditional-field condition="canEdit" title="Returnable">
                                    <drop-down allow-empty="true">
                                        <option key="Y" text="Yes"/>
                                        <option key="N" text="No"/>
                                    </drop-down>
                                </conditional-field>
                                <default-field title="Returnable">
                                    <display text="${returnable == 'N' ? 'No' : returnable == 'Y' ? 'Yes' : ''}"/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <conditional-field condition="canEdit" title="Save">
                                    <submit/>
                                </conditional-field>
                            </field>
                            <field-layout>
                                <field-row>
                                    <field-ref name="productName"/>
                                    <field-ref name="pseudoId"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="description"/>
                                    <field-ref name="comments"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="productTypeEnumId"/>
                                    <field-ref name="assetTypeEnumId"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="productClassEnumId"/>
                                    <field-ref name="assetClassEnumId"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="amountUomId"/>
                                    <field-ref name="amountFixed"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="amountRequire"/>
                                    <field-ref name="requireInventory"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="salesAllowed"/>
                                    <field-ref name="purchaseAllowed"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="salesIntroductionDate"/>
                                    <field-ref name="salesDiscontinuationDate"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="supportDiscontinuationDate"/>
                                    <field-ref name="salesDiscWhenNotAvail"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="chargeShipping"/>
                                    <field-ref name="taxable"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="returnable"/>
                                </field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="ProductChatter" condition="productFound">
            <widgets>
                <chatter id="ProductChatter" record-entity="mantle.product.Product" record-id="${productId}" default-tab="message"/>
            </widgets>
        </section>
    </widgets>
</screen>
