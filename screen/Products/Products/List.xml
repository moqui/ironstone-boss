<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Products" default-menu-include="false" menu-image="sym_o_inventory" menu-image-type="icon">
    <parameter name="text"/><parameter name="ownerPartyId"/><parameter name="pageIndex"/><parameter name="pageSize"/>
    <transition name="productDetail"><default-response url="../Product360"/></transition>
    <actions><service-call name="ironstone.products.CatalogServices.find#Products" in-map="context" out-map="context"/>
        <set field="productListPageIndex" from="pageIndex"/>
        <set field="productListPageSize" from="pageSize"/>
        <set field="productListPageMaxIndex" from="Math.max(0, Math.ceil(productListCount / pageSize) - 1)"/>
        <set field="productListPageRangeLow" from="productList.length ? pageIndex * pageSize + 1 : 0"/>
        <set field="productListPageRangeHigh" from="productList.length ? pageIndex * pageSize + productList.length : 0"/>
    </actions>
    <widgets>
        <context title="Products" selection-form="ProductList"/>
        <container-box><box-header title="Products"/><box-body-nopad>
            <form-list name="ProductList" list="productList" skip-form="true" paginate="true" header-dialog="true" saved-finds="true"
                    show-csv-button="true" show-xlsx-button="true" select-columns="true">
                <field name="text"><header-field title="ID or name"><text-line/></header-field></field>
                <field name="productId"><header-field title="Product ID"/><default-field>
                    <link url="productDetail" text="${productId}" parameter-map="{productId:productId}" link-type="anchor"/>
                </default-field></field>
                <field name="productName"><header-field title="Name"/><default-field><display/></default-field></field>
                <field name="productTypeEnumId"><header-field title="Type"/><default-field><display-entity entity-name="moqui.basic.Enumeration" text="${description}"/></default-field></field>
                <field name="ownerPartyId"><header-field title="Owner"/><default-field><display/></default-field></field>
                <field name="shared"><header-field title="Shared"/><default-field><display/></default-field></field>
            </form-list>
        </box-body-nopad></container-box>
    </widgets>
</screen>
