        <actions>
            <set field="payments" value="component://mr-boss/service/ironstone/accounting/Payments.js"/>
            <service-call name="mantle.account.PaymentServices.preview#PaymentUnapply" out-map="unapplyPreview"
                    in-map="ec.resource.script(payments).execute('unapplyInput', context)"/>
            <set field="previewId" from="unapplyPreview.previewId"/>
        </actions>
    </service>
