<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Dashboards &amp; KPIs" default-menu-index="2" menu-image="sym_o_widgets" menu-image-type="icon">
