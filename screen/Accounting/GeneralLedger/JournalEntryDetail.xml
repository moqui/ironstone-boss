<?xml version="1.0" encoding="UTF-8"?>
<!-- CC0 1.0 Universal plus Grant of Patent License. See LICENSE.md. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Journal entry" default-menu-index="1" default-menu-include="false" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <parameter name="fromDate" />
    <parameter name="thruDate" />
    <parameter name="timePeriodId" />
    <parameter name="amountUomId" />
    <parameter name="facilityId" />
    <parameter name="costCenterId" />
    <parameter name="compareFromDate" />
    <parameter name="compareThruDate" />
    <parameter name="reportReturn" />
    <always-actions>
        <set field="acctgTransId" from="recordId || acctgTransId" />
        <set field="recordId" from="acctgTransId" />
        <service-call name="mantle.ledger.AccountingServices.get#Record" in-map="{kind:'journals',recordId:acctgTransId,organizationPartyId:organizationPartyId}" out-map="context" />
        <set field="operationKey" from="operationKey || ('journal-' + ec.user.randomString(24))" />
    </always-actions>
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.JournalServices.store#DraftEntry" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="line">
        <actions>
            <service-call name="mantle.ledger.JournalServices.store#DraftLine" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="removeLine">
        <actions>
            <service-call name="mantle.ledger.JournalServices.delete#DraftLine" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="move">
        <actions>
            <service-call name="mantle.ledger.JournalServices.move#DraftLine" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="metadata">
        <actions>
            <service-call name="mantle.ledger.JournalServices.update#PostedMetadata" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="reverse">
        <actions>
            <service-call name="mantle.ledger.JournalServices.reverse#Entry" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="delete">
        <actions>
            <service-call name="mantle.ledger.JournalServices.delete#DraftEntry" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url="//Accounting/GeneralLedger/JournalEntries">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="preview">
        <actions>
            <service-call name="mantle.ledger.JournalServices.preview#Entry" in-map="{acctgTransId:recordId}" out-map="result" />
            <set field="previewId" from="result.previewId" />
            <set field="inputFingerprint" from="result.inputFingerprint" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="post">
        <actions>
            <service-call name="mantle.ledger.JournalServices.post#Entry" in-map="Object.assign({},context,{acctgTransId:recordId})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <if condition="previewId">
            <service-call name="mantle.ledger.JournalServices.get#Preview" in-map="{acctgTransId:recordId,previewId:previewId}" out-map="postingPreview" />
        </if>
        <script>auditRows = Array.from(ec.entity.find('moqui.entity.EntityAuditLog').condition('changedEntityName','mantle.ledger.transaction.AcctgTrans').condition('pkPrimaryValue',recordId).orderBy('-changedDate').limit(100).list())</script>
        <set from="(lines || []).length" field="linesCount" />
        <set from="postingPreview?.findings || []" field="postingPreviewFindings" />
        <set from="(postingPreviewFindings || []).length" field="postingPreviewFindingsCount" />
        <set from="(auditRows || []).length" field="auditRowsCount" />
        <set from="linesCount || 1" field="linesPageSize" />
        <set from="0" field="linesPageIndex" />
        <set from="0" field="linesPageMaxIndex" />
        <set from="linesCount ? 1 : 0" field="linesPageRangeLow" />
        <set from="linesCount" field="linesPageRangeHigh" />
        <set from="postingPreviewFindingsCount || 1" field="postingPreviewFindingsPageSize" />
        <set from="0" field="postingPreviewFindingsPageIndex" />
        <set from="0" field="postingPreviewFindingsPageMaxIndex" />
        <set from="postingPreviewFindingsCount ? 1 : 0" field="postingPreviewFindingsPageRangeLow" />
        <set from="postingPreviewFindingsCount" field="postingPreviewFindingsPageRangeHigh" />
        <set from="auditRowsCount || 1" field="auditRowsPageSize" />
        <set from="0" field="auditRowsPageIndex" />
        <set from="0" field="auditRowsPageMaxIndex" />
        <set from="auditRowsCount ? 1 : 0" field="auditRowsPageRangeLow" />
        <set from="auditRowsCount" field="auditRowsPageRangeHigh" />
        <script>const dateLabels=ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js')
auditRows = dateLabels.formatDates(auditRows,[["changedDate", "yyyy-MM-dd HH:mm"]])</script>
    </actions>
    <widgets>
        <link parameter-map="{organizationPartyId:organizationPartyId,fromDate:fromDate,thruDate:thruDate,timePeriodId:timePeriodId,amountUomId:amountUomId,facilityId:facilityId,costCenterId:costCenterId,compareFromDate:compareFromDate,compareThruDate:compareThruDate,glAccountId:glAccountId}" url="//Accounting/Reports/${reportReturn === 'TrialBalance' ? 'TrialBalance' : 'GeneralLedger'}" text="Back to report" condition="['TrialBalance','GeneralLedger'].includes(reportReturn)" />
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="${record.acctgTransId}" type="h5" />
                <label text="${record.description || 'Journal entry'}" type="p" />
            </container>
            <container style="m-record-status">
                <label text="${record.isPosted === 'Y' ? 'Posted' : 'Draft'}" />
            </container>
            <container style="m-record-actions">
                <section name="ReviewAction" condition="record.isPosted !== 'Y' &amp;&amp; accounting.capabilities.glPost">
                    <widgets>
                        <section name="ReviewPostingPermission" condition="accounting.capabilities.glPost">
                            <widgets>
                                <form-single name="ReviewPosting" transition="preview">
                                    <field name="recordId" from="recordId">
                                        <default-field>
                                            <hidden />
                                        </default-field>
                                    </field>
                                    <field name="organizationPartyId" from="record.organizationPartyId">
                                        <default-field>
                                            <hidden />
                                        </default-field>
                                    </field>
                                    <field name="operationKey" from="operationKey">
                                        <default-field>
                                            <hidden />
                                        </default-field>
                                    </field>
                                    <field name="submit">
                                        <default-field>
                                            <submit text="Review posting" />
                                        </default-field>
                                    </field>
                                </form-single>
                            </widgets>
                        </section>
                    </widgets>
                </section>
            </container>
        </container>
        <link url="//Accounting/GeneralLedger/JournalEntryDetail" text="Open linked reversal ${record.reversedByAcctgTransId}" parameter-map="{recordId:record.reversedByAcctgTransId,organizationPartyId:record.organizationPartyId}" condition="record.reversedByAcctgTransId" />
        <label text="Journal entry details" type="h6" />
        <label text="Debits ${String(debitTotal)} · Credits ${String(creditTotal)} · Difference ${String(debitCreditDifference)} ${record.amountUomId}" type="p" />
        <section name="DraftEditor" condition="record.isPosted !== 'Y' &amp;&amp; accounting.capabilities.glPost">
            <widgets>
                <section name="DraftHeaderPermission" condition="accounting.capabilities.glPost">
                    <widgets>
                        <form-single name="DraftHeader" transition="save" map="record">
                            <field name="recordId" from="recordId">
                                <default-field title="Record id">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="lastUpdatedStamp" from="record.lastUpdatedStamp">
                                <default-field title="Last updated stamp">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="organizationPartyId" from="record.organizationPartyId">
                                <default-field title="Organization party id">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="description">
                                <default-field title="Description">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="transactionDate">
                                <default-field title="Date">
                                    <date-time />
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="Submit">
                                    <submit text="Save draft" type="primary" />
                                </default-field>
                            </field>
                        </form-single>
                    </widgets>
                </section>
                <container-dialog id="Addline" button-text="Add line" condition="accounting.capabilities.glPost">
                    <form-single name="AddLine" transition="line" map="context">
                        <field name="recordId" from="recordId">
                            <default-field title="Record id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="organizationPartyId" from="record.organizationPartyId">
                            <default-field title="Organization party id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="glAccountId">
                            <default-field title="Account">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accounts',organizationPartyId:organizationPartyId,selected:glAccountId}" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="debitCreditFlag">
                            <default-field title="Side">
                                <drop-down allow-empty="true">
                                    <option key="D" text="Debit" />
                                    <option key="C" text="Credit" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="amount">
                            <default-field title="Amount">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Description">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="facilityId">
                            <default-field title="Facility">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'facilities',organizationPartyId:organizationPartyId,selected:facilityId}" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="costCenterId">
                            <default-field title="Cost centre">
                                <drop-down allow-empty="true">
                                    <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'costCenters',organizationPartyId:organizationPartyId,selected:costCenterId}" />
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="Submit">
                                <submit text="Add line" type="primary" />
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
                <container-dialog id="Deletedraft" button-text="Delete draft" condition="accounting.capabilities.glPost">
                    <form-single name="DeleteDraft" transition="delete" map="context">
                        <field name="recordId" from="recordId">
                            <default-field title="Record id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="lastUpdatedStamp" from="record.lastUpdatedStamp">
                            <default-field title="Last updated stamp">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="Submit">
                                <submit text="Delete draft" type="danger" confirmation="Delete draft ${recordId}?" />
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <form-list name="TransactionLines" list="lines" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="acctgTransEntrySeqId">
                <default-field title="Line">
                    <display />
                </default-field>
            </field>
            <field name="glAccountId">
                <default-field title="Account">
                    <display-entity entity-name="mantle.ledger.account.GlAccount" text="${accountCode} ${accountName}" />
                </default-field>
            </field>
            <field name="description">
                <default-field title="Description">
                    <display />
                </default-field>
            </field>
            <field name="debitCreditFlag">
                <default-field title="Side">
                    <display />
                </default-field>
            </field>
            <field name="amount" align="right">
                <default-field title="Amount">
                    <display currency-unit-field="record.amountUomId" />
                </default-field>
            </field>
            <field name="lineActions">
                <default-field title="Actions">
                    <container-dialog id="EditLine_${acctgTransEntrySeqId}" button-text="Edit line" condition="(record.isPosted !== 'Y' &amp;&amp; accounting.capabilities.glPost) &amp;&amp; accounting.capabilities.glPost">
                        <form-single name="EditLine" transition="line">
                            <field name="recordId" from="recordId">
                                <default-field title="Record id">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="acctgTransEntrySeqId" from="acctgTransEntrySeqId">
                                <default-field title="Acctg trans entry seq id">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                <default-field title="Last updated stamp">
                                    <hidden />
                                </default-field>
                            </field>
                            <field name="glAccountId">
                                <default-field title="Account">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'accounts',organizationPartyId:organizationPartyId,selected:glAccountId}" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="debitCreditFlag">
                                <default-field title="Side">
                                    <drop-down allow-empty="true">
                                        <option key="D" text="Debit" />
                                        <option key="C" text="Credit" />
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="amount">
                                <default-field title="Amount">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="description">
                                <default-field title="Description">
                                    <text-line />
                                </default-field>
                            </field>
                            <field name="submit">
                                <default-field title="Submit">
                                    <submit text="Save line" type="primary" />
                                </default-field>
                            </field>
                        </form-single>
                    </container-dialog>
                    <button-menu text="More" icon="more_horiz" condition="record.isPosted !== 'Y' &amp;&amp; accounting.capabilities.glPost">
                        <container-dialog id="Movedraftline" button-text="Move draft line" condition="accounting.capabilities.glPost">
                            <form-single name="MoveDraftLine" transition="move" map="context">
                                <field name="recordId" from="recordId">
                                    <default-field title="Record id">
                                        <hidden />
                                    </default-field>
                                </field>
                                <field name="acctgTransEntrySeqId" from="acctgTransEntrySeqId">
                                    <default-field title="Acctg trans entry seq id">
                                        <hidden />
                                    </default-field>
                                </field>
                                <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                    <default-field title="Last updated stamp">
                                        <hidden />
                                    </default-field>
                                </field>
                                <field name="destinationAcctgTransId">
                                    <default-field title="Destination draft">
                                        <drop-down allow-empty="true">
                                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'drafts',organizationPartyId:organizationPartyId,selected:destinationAcctgTransId}" />
                                        </drop-down>
                                    </default-field>
                                </field>
                                <field name="changeReason">
                                    <default-field title="Reason">
                                        <text-line />
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="Submit">
                                        <submit text="Move draft line" type="primary" />
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                        <container-dialog id="Removeline" button-text="Remove line" condition="accounting.capabilities.glPost">
                            <form-single name="RemoveDraftLine" transition="removeLine" map="context">
                                <field name="recordId" from="recordId">
                                    <default-field title="Record id">
                                        <hidden />
                                    </default-field>
                                </field>
                                <field name="acctgTransEntrySeqId" from="acctgTransEntrySeqId">
                                    <default-field title="Acctg trans entry seq id">
                                        <hidden />
                                    </default-field>
                                </field>
                                <field name="lastUpdatedStamp" from="lastUpdatedStamp">
                                    <default-field title="Last updated stamp">
                                        <hidden />
                                    </default-field>
                                </field>
                                <field name="submit">
                                    <default-field title="Submit">
                                        <submit text="Remove draft line" type="danger" confirmation="Remove line ${acctgTransEntrySeqId} from draft ${recordId}?" />
                                    </default-field>
                                </field>
                            </form-single>
                        </container-dialog>
                    </button-menu>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="acctgTransEntrySeqId" />
                    <field-ref name="glAccountId" />
                    <field-ref name="description" />
                </column>
                <column>
                    <field-ref name="debitCreditFlag" />
                    <field-ref name="amount" />
                    <field-ref name="lineActions" />
                </column>
            </columns>
        </form-list>
        <section name="PostingPreview" condition="previewId &amp;&amp; record.isPosted !== 'Y'">
            <widgets>
                <label text="Posting preview" type="h6" />
                <form-list name="PostingFindings" list="postingPreviewFindings" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
                    <field name="code">
                        <default-field title="Check">
                            <display />
                        </default-field>
                    </field>
                    <field name="message">
                        <default-field title="Finding">
                            <display />
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="code" />
                        </column>
                        <column>
                            <field-ref name="message" />
                        </column>
                    </columns>
                </form-list>
                <form-single name="PostEntry" transition="post" map="context">
                    <field name="recordId" from="recordId">
                        <default-field title="Record id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="previewId" from="previewId">
                        <default-field title="Preview id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="inputFingerprint" from="inputFingerprint">
                        <default-field title="Input fingerprint">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="operationKey" from="operationKey">
                        <default-field title="Operation key">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Posting reason">
                            <text-line />
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="Submit">
                            <submit text="Post reviewed entry" type="primary" confirmation="Post the reviewed entry ${recordId}?" />
                        </default-field>
                    </field>
                </form-single>
            </widgets>
        </section>
        <section name="PostedActions" condition="record.isPosted === 'Y' &amp;&amp; accounting.capabilities.glPost">
            <widgets>
                <container-dialog id="Reverseentry" button-text="Reverse entry" condition="(!record.reversedByAcctgTransId) &amp;&amp; accounting.capabilities.glPost">
                    <form-single name="ReverseEntry" transition="reverse" map="context">
                        <field name="recordId" from="recordId">
                            <default-field title="Record id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="operationKey" from="'reverse-' + ec.user.randomString(24)">
                            <default-field title="Operation key">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="reversalDate">
                            <default-field title="Reversal date">
                                <date-time />
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="Submit">
                                <submit text="Reverse entry" type="primary" confirmation="Post a dated reversal of ${recordId}?" />
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
                <container-dialog id="Correctdescription" button-text="Correct description" condition="accounting.capabilities.glPost">
                    <form-single name="CorrectDescription" transition="metadata" map="context">
                        <field name="recordId" from="recordId">
                            <default-field title="Record id">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="lastUpdatedStamp" from="record.lastUpdatedStamp">
                            <default-field title="Last updated stamp">
                                <hidden />
                            </default-field>
                        </field>
                        <field name="description">
                            <default-field title="Description">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="changeReason">
                            <default-field title="Reason">
                                <text-line />
                            </default-field>
                        </field>
                        <field name="submit">
                            <default-field title="Submit">
                                <submit text="Save description" type="primary" />
                            </default-field>
                        </field>
                    </form-single>
                </container-dialog>
            </widgets>
        </section>
        <label text="Files" type="h6" />
        <record-files record-entity="mantle.ledger.transaction.AcctgTrans" record-id="${recordId}" />
        <label text="Audit trail" type="h6" />
        <form-list name="Audit" list="auditRows" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="changedDate">
                <default-field title="Date">
                    <display text="${changedDateText}" />
                </default-field>
            </field>
            <field name="changedFieldName">
                <default-field title="Field">
                    <display />
                </default-field>
            </field>
            <field name="newValueText">
                <default-field title="New value">
                    <display />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="changedDate" />
                    <field-ref name="changedFieldName" />
                </column>
                <column>
                    <field-ref name="newValueText" />
                </column>
            </columns>
        </form-list>
        <link url="//Accounting/GeneralLedger/JournalEntries" text="Back to journal entries" />
    </widgets>
</screen>
