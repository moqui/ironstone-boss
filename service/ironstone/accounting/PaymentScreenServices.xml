<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="PaymentListContext" allow-remote="false">
        <description>Project the authorized native payment list, filters, masked identities and draft capabilities. No financial write.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <in-parameters>
            <parameter name="transferPreviewId" type="String"/>
            <parameter name="transferEditPreviewId" type="String"/>
            <parameter name="queue" type="String"/>
            <parameter name="partyId" type="String"/>
            <parameter name="paymentInstrumentEnumId" type="String"/>
            <parameter name="statusId" type="String"/>
            <parameter name="currencyUomId" type="String"/>
            <parameter name="fromDay" type="String"/>
            <parameter name="throughDay" type="String"/>
            <parameter name="text" type="String"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="transferPreviewId" type="String"/>
            <parameter name="transferEditPreviewId" type="String"/>
            <parameter name="transferReview" type="Map"/>
            <parameter name="transferValue" type="Map"/>
            <parameter name="transferUnavailable" type="Boolean"/>
            <parameter name="organizationPartyId" type="String"/>
            <parameter name="queue" type="String"/>
            <parameter name="partyId" type="String"/>
            <parameter name="paymentInstrumentEnumId" type="String"/>
            <parameter name="statusId" type="String"/>
            <parameter name="currencyUomId" type="String"/>
            <parameter name="fromDay" type="String"/>
            <parameter name="throughDay" type="String"/>
            <parameter name="text" type="String"/>
            <parameter name="records" type="List"/>
            <parameter name="recordsCount" type="Integer"/>
            <parameter name="recordsPageIndex" type="Integer"/>
            <parameter name="recordsPageSize" type="Integer"/>
            <parameter name="recordsPageMaxIndex" type="Integer"/>
            <parameter name="recordsPageRangeLow" type="Integer"/>
            <parameter name="recordsPageRangeHigh" type="Integer"/>
            <parameter name="paymentList" type="Map"/>
            <parameter name="newPaymentValue" type="Map"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-boss/service/ironstone/accounting/Payments.js"/>
            <set field="screenContext" from="ec.resource.script(module).execute('list', context)"/>
            <set field="transferPreviewId" from="screenContext.transferPreviewId"/>
            <set field="transferEditPreviewId" from="screenContext.transferEditPreviewId"/>
            <set field="transferReview" from="screenContext.transferReview"/>
            <set field="transferValue" from="screenContext.transferValue"/>
            <set field="transferUnavailable" from="screenContext.transferUnavailable"/>
            <set field="organizationPartyId" from="screenContext.organizationPartyId"/>
            <set field="queue" from="screenContext.queue"/>
            <set field="partyId" from="screenContext.partyId"/>
            <set field="paymentInstrumentEnumId" from="screenContext.paymentInstrumentEnumId"/>
            <set field="statusId" from="screenContext.statusId"/>
            <set field="currencyUomId" from="screenContext.currencyUomId"/>
            <set field="fromDay" from="screenContext.fromDay"/>
            <set field="throughDay" from="screenContext.throughDay"/>
            <set field="text" from="screenContext.text"/>
            <set field="records" from="screenContext.records"/>
            <set field="recordsCount" from="screenContext.recordsCount"/>
            <set field="recordsPageIndex" from="screenContext.recordsPageIndex"/>
            <set field="recordsPageSize" from="screenContext.recordsPageSize"/>
            <set field="recordsPageMaxIndex" from="screenContext.recordsPageMaxIndex"/>
            <set field="recordsPageRangeLow" from="screenContext.recordsPageRangeLow"/>
            <set field="recordsPageRangeHigh" from="screenContext.recordsPageRangeHigh"/>
            <set field="paymentList" from="screenContext.paymentList"/>
            <set field="newPaymentValue" from="screenContext.newPaymentValue"/>
        </actions>
    </service>
