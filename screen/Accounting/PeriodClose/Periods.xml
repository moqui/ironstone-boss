<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Fiscal periods" default-menu-index="1" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="generate">
        <actions>
            <service-call name="mantle.ledger.AccountServices.ensure#Periods" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="Object.assign({},context,{kind:'periods'})" out-map="context" />
        <set field="recordsCount" from="recordCount" />
    </actions>
    <widgets>
        <label text="Fiscal periods" type="h5" />
        <form-single name="Find" transition="." map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="text">
                <default-field title="Search">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Find" type="primary" />
                </default-field>
            </field>
        </form-single>
        <form-list name="Records" list="records" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="timePeriodId">
                <default-field title="Record">
                    <display />
                </default-field>
            </field>
            <field name="description">
                <default-field title="Name">
                    <text-line />
                </default-field>
            </field>
            <field name="lastUpdatedStamp">
                <default-field title="Updated">
                    <display format="yyyy-MM-dd HH:mm" />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="timePeriodId" />
                    <field-ref name="description" />
                </column>
                <column>
                    <field-ref name="lastUpdatedStamp" />
                </column>
            </columns>
        </form-list>
        <label text="No matching records. Adjust the organization or filters." type="p" condition="!records.length" />
        <container-dialog id="Generatefiscalperiods" button-text="Generate fiscal periods" condition="accounting.capabilities.glPost">
            <form-single name="GeneratePeriods" transition="generate" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="basisDate">
                    <default-field title="Basis date">
                        <date-time type="date" />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Generate periods" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
    </widgets>
</screen>
