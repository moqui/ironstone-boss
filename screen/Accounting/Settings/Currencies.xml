<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Currencies" default-menu-index="5" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="importId" />
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="rate">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.store#Rate" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="currency">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.store#Currency" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="import">
        <actions>
            <service-call name="mantle.ledger.CurrencyServices.import#Rates" in-map="context" out-map="result" />
            <set field="importId" from="result.importId" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
            <parameter name="importId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Context" in-map="context" out-map="context" />
        <if condition="importId">
            <service-call name="mantle.ledger.CurrencyServices.get#ImportResult" in-map="{organizationPartyId:organizationPartyId,importId:importId}" out-map="rateImport" />
        </if>
        <set from="(rates || []).length" field="ratesCount" />
        <set from="rateImport?.results || []" field="rateImportResults" />
        <set from="(rateImportResults || []).length" field="rateImportResultsCount" />
        <set from="Number(pageIndex || 0)" field="currenciesPageIndex" />
        <set from="25" field="currenciesPageSize" />
        <set from="Math.max(0, Math.ceil(currenciesCount / 25) - 1)" field="currenciesPageMaxIndex" />
        <set from="currenciesCount ? Number(pageIndex || 0) * 25 + 1 : 0" field="currenciesPageRangeLow" />
        <set from="Math.min(currenciesCount, (Number(pageIndex || 0) + 1) * 25)" field="currenciesPageRangeHigh" />
        <set from="ratesCount || 1" field="ratesPageSize" />
        <set from="0" field="ratesPageIndex" />
        <set from="0" field="ratesPageMaxIndex" />
        <set from="ratesCount ? 1 : 0" field="ratesPageRangeLow" />
        <set from="ratesCount" field="ratesPageRangeHigh" />
        <set from="rateImportResultsCount || 1" field="rateImportResultsPageSize" />
        <set from="0" field="rateImportResultsPageIndex" />
        <set from="0" field="rateImportResultsPageMaxIndex" />
        <set from="rateImportResultsCount ? 1 : 0" field="rateImportResultsPageRangeLow" />
        <set from="rateImportResultsCount" field="rateImportResultsPageRangeHigh" />
        <script>const dateLabels=ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js')
rates = dateLabels.formatDates(rates,[["fromDate", "yyyy-MM-dd"]])</script>
    </actions>
    <widgets>
        <label text="Currencies" type="h5" />
        <form-single name="SelectOrganization" transition="selectOrganization" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'allOrganizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Choose organization" type="primary" />
                </default-field>
            </field>
        </form-single>
        <container-dialog id="Addexchangerate" button-text="Add exchange rate">
            <form-single name="ExchangeRate" transition="rate" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="uomId">
                    <default-field title="From currency">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId,selected:uomId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="toUomId">
                    <default-field title="To currency">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId,selected:toUomId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="fromDate">
                    <default-field title="Effective from">
                        <date-time />
                    </default-field>
                </field>
                <field name="thruDate">
                    <default-field title="Through">
                        <date-time />
                    </default-field>
                </field>
                <field name="conversionFactor">
                    <default-field title="Rate">
                        <text-line />
                    </default-field>
                </field>
                <field name="rateSource">
                    <default-field title="Source">
                        <text-line />
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Save dated rate" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <container-dialog id="Newcurrency" button-text="New currency">
            <form-single name="Currency" transition="currency" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="uomId">
                    <default-field title="Currency code">
                        <text-line />
                    </default-field>
                </field>
                <field name="description">
                    <default-field title="Name">
                        <text-line />
                    </default-field>
                </field>
                <field name="fractionDigits">
                    <default-field title="Decimals">
                        <text-line />
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Save currency" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <container-dialog id="ImportrateCSV" button-text="Import rate CSV">
            <form-single name="ImportRates" transition="import" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="csvText">
                    <default-field title="CSV contents">
                        <text-area />
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Import rate rows" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <label text="CSV headers: uomId, toUomId, fromDate, thruDate, conversionFactor, rateSource" type="p" />
        <form-list name="CurrencyList" list="currencies" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="uomId">
                <default-field title="Currency">
                    <display />
                </default-field>
            </field>
            <field name="description">
                <default-field title="Name">
                    <display />
                </default-field>
            </field>
            <field name="fractionDigits">
                <default-field title="Decimals">
                    <display />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="uomId" />
                    <field-ref name="description" />
                </column>
                <column>
                    <field-ref name="fractionDigits" />
                </column>
            </columns>
        </form-list>
        <form-list name="ExchangeRates" list="rates" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="uomId">
                <default-field title="From">
                    <display />
                </default-field>
            </field>
            <field name="toUomId">
                <default-field title="To">
                    <display />
                </default-field>
            </field>
            <field name="fromDate">
                <default-field title="Effective from">
                    <display text="${fromDateText}" />
                </default-field>
            </field>
            <field name="conversionFactor">
                <default-field title="Rate">
                    <display />
                </default-field>
            </field>
            <field name="rateSource">
                <default-field title="Source">
                    <display />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="uomId" />
                    <field-ref name="toUomId" />
                    <field-ref name="fromDate" />
                </column>
                <column>
                    <field-ref name="conversionFactor" />
                    <field-ref name="rateSource" />
                </column>
            </columns>
        </form-list>
        <section name="ImportResults" condition="importId">
            <widgets>
                <label text="Rate import results" type="h6" />
                <form-list name="RateImportResults" list="rateImportResults" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
                    <field name="rowNumber">
                        <default-field title="Row">
                            <display />
                        </default-field>
                    </field>
                    <field name="success">
                        <default-field title="Stored">
                            <display />
                        </default-field>
                    </field>
                    <field name="message">
                        <default-field title="Result">
                            <display />
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="rowNumber" />
                        </column>
                        <column>
                            <field-ref name="success" />
                            <field-ref name="message" />
                        </column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
