<!-- PaymentDetail's General ledger tab: the transactions the payment posted and their reversals, for a user with ledger read
    authority. It reads the payment when the client loads the tab alone. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="General ledger"
        default-menu-index="5">
    <parameter name="organizationPartyId"/>
    <parameter name="recordId"/>
    <parameter name="paymentId"/>
    <actions>
        <!-- PaymentDetail's actions read the payment when it renders with the tab -->
        <if condition="financePayment == null">
            <service-call name="ironstone.accounting.PaymentScreenServices.get#PaymentContext"
                    in-map="context"
                    out-map="context"
                    transaction="force-new"
                    ignore-error="true"/>
        </if>
    </actions>
    <widgets>
        <section-include name="PaymentNotAvailable" location="component://mr-boss/template/AccountingPayments.xml"/>
        <section name="PaymentGeneralLedger" condition="recordFound">
            <widgets>
                <container-box>
                    <box-header title="Payment ledger"/>
                    <box-body>
                        <section name="PaymentLedgerRows" condition="financePayment.canReadLedger">
                            <widgets>
                                <form-list name="PaymentLedger"
                                        list="financePayment.ledgerRows"
                                        skip-form="true"
                                        paginate="false">
                                    <field name="acctgTransId">
                                        <default-field title="Transaction">
                                            <link url="${sharedLinks['GeneralLedger/JournalEntryDetail']}"
                                                    text="${acctgTransId}"
                                                    link-type="anchor"
                                                    parameter-map="transactionParameters"/>
                                        </default-field>
                                    </field>
                                    <field name="acctgTransTypeEnumId">
                                        <default-field title="Type">
                                            <display-entity entity-name="moqui.basic.Enumeration"/>
                                        </default-field>
                                    </field>
                                    <field name="transactionDateText">
                                        <default-field title="Date">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="postedText">
                                        <default-field title="Posted">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="reverseOfAcctgTransId">
                                        <default-field title="Reverses">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <field name="reversedByAcctgTransId">
                                        <default-field title="Reversed by">
                                            <display/>
                                        </default-field>
                                    </field>
                                    <columns type="mobile">
                                        <column>
                                            <field-ref name="acctgTransId"/>
                                            <field-ref name="acctgTransTypeEnumId"/>
                                        </column>
                                        <column>
                                            <field-ref name="transactionDateText"/>
                                            <field-ref name="postedText"/>
                                        </column>
                                    </columns>
                                </form-list>
                                <label text="This payment has not posted anything yet."
                                        type="p"
                                        style="m-muted"
                                        condition="!financePayment.ledgerRows.length"/>
                            </widgets>
                        </section>
                        <label text="Ledger details require accounting report access."
                                type="p"
                                style="m-muted"
                                condition="!financePayment.canReadLedger"/>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
