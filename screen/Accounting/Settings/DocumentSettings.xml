<!-- Document settings (design-accounting §15 DocumentSettings): the organization's invoice and order numbering, kept on
    PartyAcctgPreference where Mantle reads it (issued numbers are never rewritten), and the document layouts, with a
    preview of the invoice layout over a sample invoice (ironstone.accounting.DocumentServices.preview#Output). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Document settings"
        default-menu-index="7"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition-include name="selectOrganization" location="component://mr-boss/template/AccountingParts.xml"/>
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#Preferences"
                    in-map="Object.assign({}, context, {settings:context})"
                    out-map="result"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Context"
                in-map="{organizationPartyId:organizationPartyId}"
                out-map="context"/>
        <if condition="organizationPartyId">
            <service-call name="ironstone.accounting.DocumentServices.preview#Output"
                    out-map="context"
                    in-map="{organizationPartyId:organizationPartyId, template:settings.invoiceDocumentTemplate}"/>
        </if>
    </actions>
    <widgets>
        <label text="Document settings" type="h5"/>
        <section-include name="OrganizationPicker" location="component://mr-boss/template/AccountingParts.xml"/>
        <section name="Documents" condition="organizationPartyId">
            <widgets>
                <form-single name="DocumentDefaults" transition="save" map="settings">
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="lastUpdatedStamp">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="invoiceIdPrefix">
                        <default-field title="Invoice number prefix">
                            <text-line size="10"/>
                        </default-field>
                    </field>
                    <field name="invoiceSequenceEnumId">
                        <default-field title="Invoice numbering">
                            <drop-down allow-empty="true">
                                <dynamic-options transition="choices"
                                        server-search="true"
                                        min-length="0"
                                        parameter-map="{choice:'enum:InvoiceSequence',
                                            organizationPartyId:organizationPartyId, selected:invoiceSequenceEnumId}"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="orderIdPrefix">
                        <default-field title="Order number prefix">
                            <text-line size="10"/>
                        </default-field>
                    </field>
                    <field name="invoiceDocumentTemplate">
                        <default-field title="Invoice layout">
                            <drop-down allow-empty="true">
                                <option key="standard" text="Standard"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="paymentDocumentTemplate">
                        <default-field title="Payment layout">
                            <drop-down allow-empty="true">
                                <option key="standard" text="Standard"/>
                            </drop-down>
                        </default-field>
                    </field>
                    <field name="documentLocale">
                        <default-field title="Language" tooltip="A locale such as en_US; empty for the reader's">
                            <text-line size="8"/>
                        </default-field>
                    </field>
                    <field name="documentFooter">
                        <default-field title="Footer">
                            <text-area rows="3"/>
                        </default-field>
                    </field>
                    <field name="changeReason" from="''">
                        <default-field title="Reason">
                            <text-line/>
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="">
                            <submit text="Save document settings" type="primary"/>
                        </default-field>
                    </field>
                    <field-layout>
                        <field-row>
                            <field-ref name="invoiceIdPrefix"/>
                            <field-ref name="invoiceSequenceEnumId"/>
                            <field-ref name="orderIdPrefix"/>
                        </field-row>
                        <field-row>
                            <field-ref name="invoiceDocumentTemplate"/>
                            <field-ref name="paymentDocumentTemplate"/>
                            <field-ref name="documentLocale"/>
                        </field-row>
                        <field-ref name="documentFooter"/>
                        <field-ref name="changeReason"/>
                        <field-ref name="submit"/>
                    </field-layout>
                </form-single>
                <label text="Invoice preview" type="h6"/>
                <html-view html="${previewHtml}" text="${previewText}"/>
            </widgets>
            <fail-widgets>
                <label text="Choose an organization to see and change its document settings." type="p"/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
