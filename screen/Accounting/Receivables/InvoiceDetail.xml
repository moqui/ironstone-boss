<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Invoice" default-menu-index="1" default-menu-include="false" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <actions>
        <service-call name="mantle.ledger.AccountingServices.get#Record" in-map="{kind:'invoices',recordId:recordId,organizationPartyId:organizationPartyId}" out-map="context" />
    </actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="${record.invoiceId}" type="h5" />
                <label text="${record.description || 'Invoice'}" type="p" />
            </container>
            <container style="m-record-status">
                <label text="${record.statusId}" />
            </container>
        </container>
        <label text="Invoice details" type="h6" />
        <label text="This record is read only. Document workflows are enabled in later Accounting phases." type="p" />
        <form-single name="Document" transition="." map="record">
            <field name="fromPartyId">
                <default-field title="From">
                    <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate" />
                </default-field>
            </field>
            <field name="toPartyId">
                <default-field title="To">
                    <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate" />
                </default-field>
            </field>
            <field name="description">
                <default-field title="Description">
                    <display />
                </default-field>
            </field>
        </form-single>
        <link url="//Accounting/Receivables/Invoices" text="Back to list" />
    </widgets>
</screen>
