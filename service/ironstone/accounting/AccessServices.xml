<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <in-parameters>
            <parameter name="appRoot" type="String"/>
            <parameter name="organizationPartyId" type="String"/>
            <parameter name="text" type="String"/>
            <parameter name="term" type="String"/>
            <parameter name="choice" type="String"/>
            <parameter name="selected" type="String"/>
            <parameter name="limit" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="capabilities" type="Map"/>
            <parameter name="organizationPartyIds" type="List"/>
            <parameter name="allowedOrganizationPartyIds" type="List"/>
            <parameter name="activeOrganizationPartyId" type="String"/>
            <parameter name="organizationPartyId" type="String"/>
            <parameter name="appRoot" type="String"/>
            <parameter name="sharedLinks" type="Map"/>
            <parameter name="linkBase" type="String"/>
            <parameter name="webBase" type="String"/>
            <parameter name="summary" type="Map"/>
            <parameter name="findings" type="List"/>
            <parameter name="workRows" type="List"/>
            <parameter name="rows" type="List"/>
            <parameter name="options" type="List"/>
        </out-parameters>
    </service>
    <service verb="get" noun="SharedContext" allow-remote="false">
        <description>Check the Accounting capability and organization and resolve its app routes.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js').execute('access', context))</script>
        </actions>
    </service>
    <service verb="search" noun="Records" allow-remote="false">
        <description>Search only readable finance records and return Accounting destinations.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js').execute('search', context))</script>
        </actions>
    </service>
    <service verb="get" noun="Choices" allow-remote="false">
        <description>Authorized choices and selected record labels for Accounting forms.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js').execute('choices', context))</script>
        </actions>
    </service>
    <service verb="select" noun="Organization" allow-remote="false">
        <description>Select only an authenticated internal organization, or clear the active scope.</description>
        <implements service="ironstone.accounting.AccessServices.define#Parameters"/>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-boss/service/ironstone/accounting/Accounting.js').execute('selectOrganization',context))</script></actions>
    </service>
</services>
