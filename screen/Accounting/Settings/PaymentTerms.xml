<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Payment Terms" default-menu-index="4" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#SettlementTerm" in-map="context" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Context" in-map="context" out-map="context" />
        <set from="(terms || []).length" field="termsCount" />
        <set from="termsCount || 1" field="termsPageSize" />
        <set from="0" field="termsPageIndex" />
        <set from="0" field="termsPageMaxIndex" />
        <set from="termsCount ? 1 : 0" field="termsPageRangeLow" />
        <set from="termsCount" field="termsPageRangeHigh" />
    </actions>
    <widgets>
        <label text="Payment Terms" type="h5" />
        <form-single name="SelectOrganization" transition="selectOrganization" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'allOrganizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Choose organization" type="primary" />
                </default-field>
            </field>
        </form-single>
        <container-dialog id="Newdueterm" button-text="New due term">
            <form-single name="DueTerm" transition="save" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="description">
                    <default-field title="Name">
                        <text-line />
                    </default-field>
                </field>
                <field name="termValue">
                    <default-field title="Due after">
                        <text-line />
                    </default-field>
                </field>
                <field name="termValueUomId">
                    <default-field title="Time unit">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'timeUnits',organizationPartyId:organizationPartyId,selected:termValueUomId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Save due term" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <form-list name="SettlementTerms" list="terms" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="settlementTermId">
                <default-field title="Term">
                    <display />
                </default-field>
            </field>
            <field name="description">
                <default-field title="Name">
                    <display />
                </default-field>
            </field>
            <field name="termValue">
                <default-field title="Due after">
                    <display />
                </default-field>
            </field>
            <field name="termValueUomId">
                <default-field title="Unit">
                    <display-entity entity-name="moqui.basic.Uom" />
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="settlementTermId" />
                    <field-ref name="description" />
                </column>
                <column>
                    <field-ref name="termValue" />
                    <field-ref name="termValueUomId" />
                </column>
            </columns>
        </form-list>
    </widgets>
</screen>
