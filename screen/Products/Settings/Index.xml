<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Catalog" default-menu-index="1" menu-image="sym_o_settings" menu-image-type="icon">
    <parameter name="organizationPartyId"/>
    <parameter name="asOfDate"/>
    <transition name="choices" read-only="true">
        <actions>
            <service-call name="ironstone.products.CatalogServices.search#CatalogChoices" in-map="{choice:choice,term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.rows)</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="save">
        <actions>
            <service-call name="ironstone.products.SettingsServices.store#CatalogSettings" in-map="{organizationPartyId:organizationPartyId,expectedVersion:expectedVersion,fromDate:effectiveFromDate,changeReason:changeReason,settings:{defaultProductTypeEnumId:defaultProductTypeEnumId,defaultAmountUomId:defaultAmountUomId,defaultCurrencyUomId:defaultCurrencyUomId,requiredFields:requiredFields,idPolicy:idPolicy,variantsEnabled:variantsEnabled,packagingEnabled:packagingEnabled,priceListsEnabled:priceListsEnabled,allowCostSelfApproval:allowCostSelfApproval}}"/>
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <actions>
        <service-call name="ironstone.products.SettingsServices.get#CatalogSettings" in-map="context" out-map="context"/>
        <service-call name="ironstone.products.CatalogServices.get#CatalogAccess" out-map="access"/>
        <service-call name="ironstone.products.CatalogServices.get#CatalogOptions" out-map="context"/>
        <set field="asOfDate" from="ec.l10n.format(new Date(Number(String(asOfDate))), &quot;yyyy-MM-dd'T'HH:mm:ss&quot;)"/>
        <script>settings.requiredFields = Array.from(settings.requiredFields).join(','); for (const key of ['variantsEnabled','packagingEnabled','priceListsEnabled','allowCostSelfApproval']) settings[key]=String(settings[key])</script>
    </actions>
    <widgets>
        <container-box>
            <box-header title="Catalog settings"/>
            <box-body>
                <label text="Organization ${organizationPartyId} · Effective from ${fromDate ? ec.l10n.format(new Date(Number(String(fromDate))), 'yyyy-MM-dd HH:mm:ss') : 'default policy'}" type="p"/>
                <form-single name="CatalogPolicyDate" transition=".">
                    <field name="organizationPartyId">
                        <default-field>
                            <hidden/>
                        </default-field>
                    </field>
                    <field name="asOfDate">
                        <default-field title="Policy as of">
                            <date-time/>
                        </default-field>
                    </field>
                    <field name="submitButton">
                        <default-field title="Show policy">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
                <section name="Administrator" condition="access.capabilities.catalogAdmin">
                    <widgets>
                        <form-single name="CatalogSettings" transition="save" map="settings">
                            <field name="organizationPartyId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="expectedVersion" from="versionSeqId">
                                <default-field>
                                    <hidden/>
                                </default-field>
                            </field>
                            <field name="effectiveFromDate">
                                <default-field title="Effective from (empty: now)">
                                    <date-time/>
                                </default-field>
                            </field>
                            <field name="changeReason">
                                <default-field title="Reason">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="defaultProductTypeEnumId">
                                <default-field title="Default product type">
                                    <drop-down allow-empty="true">
                                        <list-options list="options.productTypes" key="${value}" text="${label}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="defaultAmountUomId">
                                <default-field title="Default amount unit">
                                    <drop-down allow-empty="true">
                                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'units'}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="defaultCurrencyUomId">
                                <default-field title="Default currency">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="requiredFields">
                                <default-field title="Required activation fields (comma separated)">
                                    <text-line/>
                                </default-field>
                            </field>
                            <field name="idPolicy">
                                <default-field title="ID policy">
                                    <drop-down allow-empty="true">
                                        <option key="internal" text="Internal generation or manual"/>
                                        <option key="manual" text="Manual IDs required"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="variantsEnabled">
                                <default-field title="Variants">
                                    <drop-down allow-empty="true">
                                        <option key="true" text="Enabled"/>
                                        <option key="false" text="Disabled"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="packagingEnabled">
                                <default-field title="Packaging">
                                    <drop-down allow-empty="true">
                                        <option key="true" text="Enabled"/>
                                        <option key="false" text="Disabled"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="priceListsEnabled">
                                <default-field title="Price lists">
                                    <drop-down allow-empty="true">
                                        <option key="true" text="Enabled"/>
                                        <option key="false" text="Disabled"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="allowCostSelfApproval">
                                <default-field title="Allow cost self approval (still requires approval authority)">
                                    <drop-down allow-empty="true">
                                        <option key="true" text="Enabled"/>
                                        <option key="false" text="Disabled"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="Save">
                                    <submit/>
                                </default-field>
                            </field>
                        </form-single>
                    </widgets>
                </section>
                <label text="Each save starts a dated policy and preserves earlier settings. Future policies apply on their start date." type="p"/>
                <form-list name="CatalogPolicyHistory" list="history" skip-form="true" paginate="false">
                    <field name="fromDateText">
                        <default-field title="Effective from">
                            <display/>
                        </default-field>
                    </field>
                    <field name="thruDateText">
                        <default-field title="Through">
                            <display/>
                        </default-field>
                    </field>
                    <field name="idPolicy">
                        <default-field title="ID policy">
                            <display/>
                        </default-field>
                    </field>
                    <field name="requiredFields">
                        <default-field title="Required fields">
                            <display/>
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <display/>
                        </default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>
