                                            <default-field title="">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        

                                        <field name="productId">
                                            <default-field title="">
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        

                                        <field name="vendorPartyId">
                                            <default-field title="">
