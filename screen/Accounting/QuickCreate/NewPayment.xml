<!-- Quick create uses the same native reviewed draft form as the payment list. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="New payment" default-menu-index="1" default-menu-include="false" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <transition-include name="choices" location="component://mr-boss/screen/Accounting/Payments/Payments.xml"/>
    <transition-include name="createPaymentDraft" location="component://mr-boss/screen/Accounting/Payments/Payments.xml"/>
    <actions>
        <service-call name="ironstone.accounting.PaymentScreenServices.get#PaymentListContext" in-map="context" out-map="context"/>
    </actions>
    <widgets>
        <section-include name="PaymentDraftEditorContent" location="component://mr-boss/screen/Accounting/Payments/Payments.xml"/>
    </widgets>
</screen>
