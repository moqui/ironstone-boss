<!-- Transaction entries (design-accounting §8 TransactionEntries): the organization's journal lines, each with its entry,
    account, side and amount. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Transaction entries" default-menu-index="3" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="glAccountId"/>
    <parameter name="isPosted"/>
    <parameter name="text"/>
    <parameter name="pageIndex"/>
    <parameter name="pageSize"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <service-call name="mantle.ledger.AccountingServices.find#Records" in-map="{kind:'entries',organizationPartyId:organizationPartyId,glAccountId:glAccountId,isPosted:isPosted,text:text,pageIndex:pageIndex,pageSize:pageSize}" out-map="context"/>
    </actions>
    <widgets>
        <label text="Transaction entries" type="h5"/>
        <section-include name="FindRecords" location="component://mr-boss/template/AccountingParts.xml"/>
        <form-list name="Records" list="records" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
            <field name="txDescription">
                <default-field title="Entry">
                    <link url="//Accounting/GeneralLedger/JournalEntryDetail" text="${txDescription || 'Journal entry ' + acctgTransId}" link-type="anchor" parameter-map="{recordId:acctgTransId,organizationPartyId:organizationPartyId}"/>
                </default-field>
            </field>
            <field name="glAccountId">
                <default-field title="Account">
                    <display-entity entity-name="mantle.ledger.account.GlAccount" text="${accountCode} ${accountName}"/>
                </default-field>
            </field>
            <field name="description">
                <default-field title="Line">
                    <display/>
                </default-field>
            </field>
            <field name="debitCreditFlag">
                <default-field title="Side">
                    <display text="${debitCreditFlag == 'D' ? 'Debit' : debitCreditFlag == 'C' ? 'Credit' : ''}"/>
                </default-field>
            </field>
            <field name="amount" align="right">
                <default-field title="Amount">
                    <display currency-unit-field="amountUomId"/>
                </default-field>
            </field>
            <field name="isPosted">
                <default-field title="State">
                    <render-mode>
                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${isPosted == 'Y' ? 'positive' : 'warning'}">${isPosted == 'Y' ? 'Posted' : 'Draft'}</q-chip>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: isPosted == 'Y' ? 'Posted' : 'Draft'})}]]></text>
                    </render-mode>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="txDescription"/>
                    <field-ref name="glAccountId"/>
                </column>
                <column>
                    <field-ref name="debitCreditFlag"/>
                    <field-ref name="amount"/>
                    <field-ref name="isPosted"/>
                </column>
            </columns>
        </form-list>
        <label text="No transaction entries match. Choose another organization or search." type="p" condition="!records.length"/>
    </widgets>
</screen>
