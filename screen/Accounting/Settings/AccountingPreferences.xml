<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-menu-title="Accounting Preferences" default-menu-index="2" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId" />
    <parameter name="recordId" />
    <parameter name="acctgTransId" />
    <parameter name="glAccountId" />
    <parameter name="glJournalId" />
    <parameter name="acctgTransTemplateId" />
    <parameter name="previewId" />
    <parameter name="inputFingerprint" />
    <parameter name="operationKey" />
    <parameter name="text" />
    <parameter name="pageIndex" />
    <parameter name="pageSize" />
    <parameter name="sourceOrganizationPartyId" />
    <transition-include name="choices" location="component://mr-boss/template/AccountingChoiceTransitions.xml" />
    <transition name="save">
        <actions>
            <service-call name="mantle.ledger.SetupServices.store#Preferences" in-map="Object.assign({},context,{settings:context})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
            <parameter name="sourceOrganizationPartyId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="clone">
        <actions>
            <service-call name="mantle.ledger.SetupServices.clone#Preferences" in-map="context" out-map="result" />
            <set field="inputFingerprint" from="result.inputFingerprint" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
            <parameter name="glJournalId" />
            <parameter name="acctgTransTemplateId" />
            <parameter name="sourceOrganizationPartyId" />
        </default-response>
        <error-response url="." />
    </transition>
    <transition name="applyClone">
        <actions>
            <service-call name="mantle.ledger.SetupServices.clone#Preferences" in-map="Object.assign({},context,{apply:true})" out-map="result" />
        </actions>
        <default-response url=".">
            <parameter name="organizationPartyId" />
            <parameter name="recordId" />
            <parameter name="previewId" />
            <parameter name="inputFingerprint" />
            <parameter name="operationKey" />
        </default-response>
        <error-response url="." />
    </transition>
    <actions>
        <service-call name="mantle.ledger.SetupServices.get#Context" in-map="context" out-map="context" />
        <if condition="sourceOrganizationPartyId">
            <service-call name="mantle.ledger.SetupServices.clone#Preferences" in-map="{organizationPartyId:organizationPartyId,sourceOrganizationPartyId:sourceOrganizationPartyId}" out-map="clonePreview" />
        </if>
        <set from="clonePreview?.conflicts || []" field="clonePreviewConflicts" />
        <set from="(clonePreviewConflicts || []).length" field="clonePreviewConflictsCount" />
        <set from="clonePreviewConflictsCount || 1" field="clonePreviewConflictsPageSize" />
        <set from="0" field="clonePreviewConflictsPageIndex" />
        <set from="0" field="clonePreviewConflictsPageMaxIndex" />
        <set from="clonePreviewConflictsCount ? 1 : 0" field="clonePreviewConflictsPageRangeLow" />
        <set from="clonePreviewConflictsCount" field="clonePreviewConflictsPageRangeHigh" />
    </actions>
    <widgets>
        <label text="Accounting Preferences" type="h5" />
        <form-single name="SelectOrganization" transition="selectOrganization" map="context">
            <field name="organizationPartyId">
                <default-field title="Organization">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'allOrganizations',organizationPartyId:organizationPartyId,selected:organizationPartyId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Choose organization" type="primary" />
                </default-field>
            </field>
        </form-single>
        <form-single name="Preferences" transition="save" map="settings">
            <field name="organizationPartyId" from="organizationPartyId">
                <default-field title="Organization party id">
                    <hidden />
                </default-field>
            </field>
            <field name="lastUpdatedStamp" from="settings.lastUpdatedStamp">
                <default-field title="Last updated stamp">
                    <hidden />
                </default-field>
            </field>
            <field name="baseCurrencyUomId">
                <default-field title="Base currency">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'currencies',organizationPartyId:organizationPartyId,selected:baseCurrencyUomId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="fiscalYearStartMonth">
                <default-field title="Fiscal start month">
                    <text-line />
                </default-field>
            </field>
            <field name="fiscalYearStartDay">
                <default-field title="Fiscal start day">
                    <text-line />
                </default-field>
            </field>
            <field name="settlementTermId">
                <default-field title="Default due term">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'terms',organizationPartyId:organizationPartyId,selected:settlementTermId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="errorGlJournalId">
                <default-field title="Error journal">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'batches',organizationPartyId:organizationPartyId,selected:errorGlJournalId}" />
                    </drop-down>
                </default-field>
            </field>
            <field name="postingGuardEnabled">
                <default-field title="Posting guard">
                    <drop-down allow-empty="true">
                        <option key="N" text="Disabled" />
                        <option key="Y" text="Enabled" />
                    </drop-down>
                </default-field>
            </field>
            <field name="requiredLedgerDimensionsEnabled">
                <default-field title="Required dimensions">
                    <drop-down allow-empty="true">
                        <option key="N" text="Disabled" />
                        <option key="Y" text="Enabled" />
                    </drop-down>
                </default-field>
            </field>
            <field name="forwardIssuanceRepostEnabled">
                <default-field title="Forward issuance adjustments">
                    <drop-down allow-empty="true">
                        <option key="N" text="Disabled" />
                        <option key="Y" text="Enabled" />
                    </drop-down>
                </default-field>
            </field>
            <field name="allowAccountingSelfApproval">
                <default-field title="Allow self approval">
                    <drop-down allow-empty="true">
                        <option key="N" text="Disabled" />
                        <option key="Y" text="Enabled" />
                    </drop-down>
                </default-field>
            </field>
            <field name="inventoryRevaluationEnabled">
                <default-field title="Inventory revaluation">
                    <drop-down allow-empty="true">
                        <option key="N" text="Disabled" />
                        <option key="Y" text="Enabled" />
                    </drop-down>
                </default-field>
            </field>
            <field name="changeReason">
                <default-field title="Reason">
                    <text-line />
                </default-field>
            </field>
            <field name="submit">
                <default-field title="Submit">
                    <submit text="Save preferences" type="primary" />
                </default-field>
            </field>
        </form-single>
        <label text="${costingMessage}" type="p" />
        <container-dialog id="Previewpreferenceclone" button-text="Preview preference clone">
            <form-single name="ClonePreferences" transition="clone" map="context">
                <field name="organizationPartyId" from="organizationPartyId">
                    <default-field title="Organization party id">
                        <hidden />
                    </default-field>
                </field>
                <field name="sourceOrganizationPartyId">
                    <default-field title="Source organization">
                        <drop-down allow-empty="true">
                            <dynamic-options transition="choices" server-search="true" min-length="0" parameter-map="{choice:'organizations',organizationPartyId:organizationPartyId,selected:sourceOrganizationPartyId}" />
                        </drop-down>
                    </default-field>
                </field>
                <field name="changeReason">
                    <default-field title="Reason">
                        <text-line />
                    </default-field>
                </field>
                <field name="submit">
                    <default-field title="Submit">
                        <submit text="Preview conflicts" type="primary" />
                    </default-field>
                </field>
            </form-single>
        </container-dialog>
        <section name="CloneReview" condition="sourceOrganizationPartyId">
            <widgets>
                <label text="Clone conflict preview" type="h6" />
                <form-list name="CloneConflicts" list="clonePreviewConflicts" skip-form="true" paginate="true" select-columns="true" show-csv-button="true" show-xlsx-button="true">
                    <field name="kind">
                        <default-field title="Kind">
                            <display />
                        </default-field>
                    </field>
                    <field name="key">
                        <default-field title="Existing key">
                            <display />
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column>
                            <field-ref name="kind" />
                        </column>
                        <column>
                            <field-ref name="key" />
                        </column>
                    </columns>
                </form-list>
                <form-single name="ApplyClone" transition="applyClone" map="context">
                    <field name="organizationPartyId" from="organizationPartyId">
                        <default-field title="Organization party id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="sourceOrganizationPartyId" from="sourceOrganizationPartyId">
                        <default-field title="Source organization party id">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="inputFingerprint" from="clonePreview.inputFingerprint">
                        <default-field title="Input fingerprint">
                            <hidden />
                        </default-field>
                    </field>
                    <field name="changeReason">
                        <default-field title="Reason">
                            <text-line />
                        </default-field>
                    </field>
                    <field name="submit">
                        <default-field title="Submit">
                            <submit text="Copy missing configuration" type="primary" />
                        </default-field>
                    </field>
                </form-single>
            </widgets>
        </section>
    </widgets>
</screen>
