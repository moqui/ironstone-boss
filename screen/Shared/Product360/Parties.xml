<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Parties" default-menu-index="8">
    <transition name="storeRow">
        <actions>
            <service-call name="ironstone.products.CatalogServices.store#CatalogRow" in-map="Object.assign({},context,{kind:'party'})"/>
        </actions>
        <default-response url=".">
            <parameter name="productId"/>
        </default-response>
        <error-response url="."/>
    </transition>
    <condition><expression>!Array.isArray(product360Tabs) || product360Tabs.includes('Parties')</expression></condition>
    <widgets>
        <section name="RowsAvailable" condition="productFound">
            <widgets>
                <container-box>
                    <box-header title="Parties"/>
                    <box-body>
                        <form-list name="PartiesRows" list="detail.partyRows" skip-form="true" paginate="false">
                            <field name="partyId">
                                <header-field title="Party"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="roleTypeId">
                                <header-field title="Role"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <header-field title="From"/>
                                <default-field>
                                    <display text="${fromDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="thruDate">
                                <header-field title="Through"/>
                                <default-field>
                                    <display text="${thruDateText || ''}"/>
                                </default-field>
                            </field>
                            <field name="otherPartyItemId">
                                <header-field title="Party item code"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="otherPartyItemName">
                                <header-field title="Party item name"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                            <field name="comments">
                                <header-field title="Notes"/>
                                <default-field>
                                    <display/>
                                </default-field>
                            </field>
                        </form-list>
                        <section name="PartiesEditor" condition="canEdit">
                            <widgets>
                                <container-dialog id="AddParties" button-text="Add" title="Parties" width="640">
                                    <form-single name="AddParties" transition="storeRow">
                                        <field name="productId">
                                            <default-field>
                                                <hidden/>
                                            </default-field>
                                        </field>
                                        <field name="partyId">
                                            <default-field title="Party">
                                                <drop-down allow-empty="true">
                                                    <list-options list="options.parties" key="${value}" text="${label}"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="roleTypeId">
                                            <default-field title="Role">
                                                <drop-down allow-empty="true">
                                                    <option key="Customer" text="Customer"/>
                                                    <option key="Manufacturer" text="Manufacturer"/>
                                                    <option key="Distributor" text="Distributor"/>
                                                </drop-down>
                                            </default-field>
                                        </field>
                                        <field name="fromDate">
                                            <default-field title="From">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="thruDate">
                                            <default-field title="Through">
                                                <date-time/>
                                            </default-field>
                                        </field>
                                        <field name="otherPartyItemId">
                                            <default-field title="Party item code">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="otherPartyItemName">
                                            <default-field title="Party item name">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="comments">
                                            <default-field title="Notes">
                                                <text-line/>
                                            </default-field>
                                        </field>
                                        <field name="submitButton">
                                            <default-field title="Save">
                                                <submit/>
                                            </default-field>
                                        </field>
                                    </form-single>
                                </container-dialog>
                                <section-iterate name="EditPartiesRows" list="detail.partyRows" entry="entry">
                                    <widgets>
                                        <container-dialog id="EditParties_${entry_index}" button-text="Edit ${entry.partyId}" title="Edit Parties" width="640">
                                            <form-single name="EditParties" transition="storeRow" map="entry">
                                                <field name="productId">
                                                    <default-field>
                                                        <hidden/>
                                                    </default-field>
                                                </field>
                                                <field name="partyId">
                                                    <default-field>
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="roleTypeId">
                                                    <default-field>
                                                        <hidden/>
                                                        <display/>
                                                    </default-field>
                                                </field>
                                                <field name="fromDate">
                                                    <default-field>
                                                        <hidden/>
                                                        <display text="${fromDateText || ''}"/>
                                                    </default-field>
                                                </field>
                                                <field name="thruDate">
                                                    <default-field title="Through">
                                                        <date-time/>
                                                    </default-field>
                                                </field>
                                                <field name="otherPartyItemId">
                                                    <default-field title="Party item code">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="otherPartyItemName">
                                                    <default-field title="Party item name">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="comments">
                                                    <default-field title="Notes">
                                                        <text-line/>
                                                    </default-field>
                                                </field>
                                                <field name="submitButton">
                                                    <default-field title="Save">
                                                        <submit/>
                                                    </default-field>
                                                </field>
                                            </form-single>
                                        </container-dialog>
                                    </widgets>
                                </section-iterate>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>
            </widgets>
        </section>
    </widgets>
</screen>
